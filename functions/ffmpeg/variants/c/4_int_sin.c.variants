    if (x >= P * 3 / 2) x -= 2 * P;
    if (x >= P / 2) x = P - x;
    x2 = (x * x) >> 20;
    term = x;
    for (n = 1; n <= 5; n++) {
        sum += term;
        term = -(term * x2 / ((int64_t)(2 * n) * (2 * n + 1) << 20));
    }
    return (sum + 8) >> 4;
}



