static int64_t int_sin(int64_t a)
{
    int64_t a2, res = 0;
    int i = 2;
    if (a < 0) a = 3294199 - a;
    a %= 2 * 3294199;
    if (a >= 3294199 * 3 / 2) a -= 2 * 3294199;
    if (a >= 3294199 / 2) a = 3294199 - a;
    a2 = (a * a) / (1 << 20);
    do {
        res += a;
        a = -a * a2 / ((1 << 20) * i * (i + 1));
        i += 2;
    } while (i < 11);
    return (res + 8) >> 4;
}
