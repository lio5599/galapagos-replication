
static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16 + ch * ((bps + 14) / 8);
    if (ch == 2)
        count += ((2 * bps + 1) * blocksize + 7) / 8;
    else
        count += (ch * bps * blocksize + 7) / 8;
    return count + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int header = 16;
    int subframe_headers = ch * ((7 + bps + 7) / 8);
    int footer = 2;
    int bits_per_block = (ch == 2) ? (2 * bps + 1) : (ch * bps);
    int data = (bits_per_block * blocksize + 7) / 8;
    return header + subframe_headers + data + footer;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    return 16 + ch * ((7 + bps + 7) / 8)
         + (((ch == 2) ? (2 * bps + 1) : (ch * bps)) * blocksize + 7) / 8
         + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count;
    switch (ch) {
    case 2:
        count = ((2 * bps + 1) * blocksize + 7) / 8;
        break;
    default:
        count = (ch * bps * blocksize + 7) / 8;
        break;
    }
    count += ch * ((bps + 14) / 8);
    count += 16;
    count += 2;
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 18;
    int sub = (7 + bps + 7) / 8;
    count += ch * sub;
    if (ch != 2) {
        count += (ch * bps * blocksize + 7) / 8;
    } else {
        count += ((2 * bps + 1) * blocksize + 7) / 8;
    }
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int bits;
    int bytes;
    if (ch == 2)
        bits = (2 * bps + 1) * blocksize;
    else
        bits = ch * bps * blocksize;
    bytes = (bits + 7) / 8;
    return 16 + ch * ((bps + 7 + 7) / 8) + bytes + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int sample_bits = ch * bps;
    int data_bytes;
    int per_ch = (bps + 14) / 8;

    if (ch == 2)
        sample_bits = 2 * bps + 1;

    data_bytes = (sample_bits * blocksize + 7) / 8;

    return data_bytes + ch * per_ch + 16 + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int result = 0;
    result += 2;
    result += (ch == 2)
            ? (((2 * bps + 1) * blocksize + 7) / 8)
            : ((ch * bps * blocksize + 7) / 8);
    result += ((7 + bps + 7) / 8) * ch;
    result += 16;
    return result;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int is_stereo = (ch == 2);
    int bits_per_sample_frame = is_stereo ? (bps + bps + 1) : (ch * bps);
    int frame_header_and_footer = 16 + 2;
    int subframe_overhead = ch * ((bps + 14) / 8);
    return frame_header_and_footer + subframe_overhead
         + (bits_per_sample_frame * blocksize + 7) / 8;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count;
    int round_up = 7;
    int sub_bytes = (round_up + bps + round_up) / 8;

    if (ch == 2) {
        int stereo_bits = (2 * bps + 1) * blocksize;
        count = 16 + 2 * sub_bytes + (stereo_bits + round_up) / 8 + 2;
    } else {
        int bits = ch * bps * blocksize;
        count = 16 + ch * sub_bytes + (bits + round_up) / 8 + 2;
    }
    return count;
}
