
static int fpr_lt(uint64_t x, uint64_t y) {
    if ((x ^ y) >> 63) {
        return (int)(x >> 63);
    }
    if (x >> 63) {
        return y < x;
    }
    return x < y;
}



static int fpr_lt(uint64_t x, uint64_t y) {
    uint64_t kx, ky;

    kx = x ^ ((uint64_t)((int64_t)x >> 63) | ((uint64_t)1 << 63));
    ky = y ^ ((uint64_t)((int64_t)y >> 63) | ((uint64_t)1 << 63));
    return kx < ky;
}



static int fpr_lt(uint64_t x, uint64_t y) {
    int64_t sx, sy, kx, ky;

    sx = (int64_t)x;
    sy = (int64_t)y;
    kx = sx ^ (int64_t)((uint64_t)(sx >> 63) >> 1);
    ky = sy ^ (int64_t)((uint64_t)(sy >> 63) >> 1);
    return kx < ky;
}



static int fpr_lt(uint64_t x, uint64_t y) {
    uint64_t s, d, lt, gt;

    s = x >> 63;
    d = (x ^ y) >> 63;
    lt = (uint64_t)(x < y);
    gt = (uint64_t)(y < x);
    return (int)((d & s) | ((d ^ 1) & ((s & gt) | ((s ^ 1) & lt))));
}



static int fpr_lt(uint64_t x, uint64_t y) {
    return ((x ^ y) >> 63) ? (int)(x >> 63)
        : ((x >> 63) ? (int)(y < x) : (int)(x < y));
}



static int fpr_lt(uint64_t x, uint64_t y) {
    uint64_t d, s, lt, gt, same;

    s = -(x >> 63);
    d = -((x ^ y) >> 63);
    lt = -(uint64_t)(x < y);
    gt = -(uint64_t)(y < x);
    same = (s & gt) | (~s & lt);
    return (int)(((d & s) | (~d & same)) & 1);
}



static int fpr_lt(uint64_t x, uint64_t y) {
    uint64_t lt, gt, s;

    lt = ((~x & y) | ((~x | y) & (x - y))) >> 63;
    gt = ((~y & x) | ((~y | x) & (y - x))) >> 63;
    s = x >> 63;
    if ((x ^ y) >> 63) {
        return (int)s;
    }
    return (int)((s & gt) | ((s ^ 1) & lt));
}



static int fpr_lt(uint64_t x, uint64_t y) {
    int64_t kx, ky;

    kx = (int64_t)x;
    ky = (int64_t)y;
    if (kx < 0) {
        kx = (int64_t)(x ^ 0x7FFFFFFFFFFFFFFFULL);
    }
    if (ky < 0) {
        ky = (int64_t)(y ^ 0x7FFFFFFFFFFFFFFFULL);
    }
    return kx < ky;
}



static int fpr_lt(uint64_t x, uint64_t y) {
    switch ((int)(((x >> 63) << 1) | (y >> 63))) {
    case 0:
        return x < y;
    case 1:
        return 0;
    case 2:
        return 1;
    default:
        return y < x;
    }
}



static int fpr_lt(uint64_t x, uint64_t y) {
    int64_t sx, sy;

    sx = (int64_t)x;
    sy = (int64_t)y;
    if ((sx ^ sy) < 0) {
        return sx < 0;
    }
    return (sx < 0) ? (sy < sx) : (sx < sy);
}
