uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Add z and w as 32-bit limbs with an explicit carry.
    // Truncating the high limb reproduces unsigned 64-bit sum overflow.
    // Combining the limbs yields the low 32 bits of that sum shifted by 31.
    // The original subtraction and correction therefore match at all edges.
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint64_t low_sum = (uint64_t)(uint32_t)z + (uint32_t)w;
    uint32_t low = (uint32_t)low_sum;
    uint32_t high = (uint32_t)((z >> 32) + (w >> 32)
                              + (low_sum >> 32));
    uint32_t q = (uint32_t)((uint64_t)high << 1) | (low >> 31);
    uint32_t d = q - p;
    d += p & -(d >> 31);
    return d;
}
