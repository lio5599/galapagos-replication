uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Masking both factors to 31 bits preserves their product modulo 2^31.
    // The remaining arithmetic follows the reference's unsigned operations.
    // An explicit branch implements its top-bit correction, not a comparison.
    // Thus even inputs outside normal Montgomery bounds behave identically.
    uint64_t z = (uint64_t)a * b;
    uint64_t m = ((z & UINT64_C(0x7FFFFFFF))
                  * (p0i & UINT32_C(0x7FFFFFFF)))
                 & UINT64_C(0x7FFFFFFF);
    uint64_t s = z + m * p;
    uint32_t d = (uint32_t)(s >> 31) - p;
    if (d & UINT32_C(0x80000000)) {
        d = (uint32_t)(d + p);
    }
    return d;
}
