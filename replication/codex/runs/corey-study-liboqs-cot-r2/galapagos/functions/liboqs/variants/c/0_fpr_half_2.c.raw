static uint64_t fpr_half(uint64_t x) {
    // Convert the nonzero-exponent predicate into an all-ones or all-zero mask.
    // Masking preserves the subtraction for every nonzero exponent.
    // For every zero-exponent encoding, it discards the wrapped subtraction.
    uint64_t keep = (uint64_t)(((x >> 52) & 0x7FF) != 0);
    uint64_t mask = (uint64_t)0 - keep;
    return (x - ((uint64_t)1 << 52)) & mask;
}
