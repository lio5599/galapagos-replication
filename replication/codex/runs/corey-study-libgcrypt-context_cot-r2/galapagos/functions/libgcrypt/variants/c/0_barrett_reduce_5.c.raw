int16_t barrett_reduce(int16_t a) {
  // Add the rounding bias in two equal parts.
  // Both additions are exact and remain within int32_t.
  // The same shift and narrowing give identical results for all inputs.
  int32_t biased = (int32_t)20159 * a + 16777216;
  biased += 16777216;
  int16_t t = biased >> 26;
  t *= 3329;
  return a - t;
}
