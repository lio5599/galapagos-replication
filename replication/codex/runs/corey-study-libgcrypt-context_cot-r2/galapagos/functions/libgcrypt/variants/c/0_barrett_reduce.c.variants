int16_t barrett_reduce(int16_t a) {
  // The reference computes the centered residue of a modulo 3329.
  // The rounded reciprocal constant evaluates to 20159.
  // Keep both int16_t conversions, including at the input extremes.
  int16_t t;
  t = ((int32_t)20159 * a + (1 << 25)) >> 26;
  t *= 3329;
  return a - t;
}

int16_t barrett_reduce(int16_t a) {
  // Separate multiplication, rounding bias, and quotient extraction.
  // All intermediate values fit in int32_t for every int16_t input.
  // The narrowing and final subtraction match the reference.
  int32_t product = (int32_t)20159 * a;
  int32_t biased = product + 33554432;
  int16_t t = biased >> 26;
  t *= 3329;
  return a - t;
}

int16_t barrett_reduce(int16_t a) {
  // Split 20159 into 20000 plus 159 before multiplying.
  // The exact sum and all intermediates fit in int32_t.
  // Preserve the reference's rounding and int16_t conversions.
  int32_t product = (int32_t)20000 * a + (int32_t)159 * a;
  int16_t t = (product + 33554432) >> 26;
  t *= 3329;
  return a - t;
}

int16_t barrett_reduce(int16_t a) {
  // Compute multiplication by 20159 as multiplication by 20160 minus a.
  // Neither the multiplication nor subtraction overflows int32_t.
  // The remaining operations preserve all boundary behavior.
  int32_t product = (int32_t)20160 * a - a;
  int16_t t = (product + 33554432) >> 26;
  t *= 3329;
  return a - t;
}

int16_t barrett_reduce(int16_t a) {
  // Absorb most of the rounding bias into the multiplicand.
  // Since 20159 times 1664 plus 9856 equals 33554432,
  // the shifted value is identical, with no int32_t overflow.
  // Preserve the reference's int16_t conversions at the extremes.
  int32_t shifted_input = (int32_t)a + 1664;
  int16_t t = (20159 * shifted_input + 9856) >> 26;
  t *= 3329;
  return a - t;
}

int16_t barrett_reduce(int16_t a) {
  // Add the rounding bias in two equal parts.
  // Both additions are exact and remain within int32_t.
  // The same shift and narrowing give identical results for all inputs.
  int32_t biased = (int32_t)20159 * a + 16777216;
  biased += 16777216;
  int16_t t = biased >> 26;
  t *= 3329;
  return a - t;
}

int16_t barrett_reduce(int16_t a) {
  // With arithmetic right shifts, extract the quotient in two stages.
  // Floor of half of floor of x divided by 2^25 plus one equals
  // floor of x plus 2^25 divided by 2^26, including negative ties.
  // All intermediates fit; retain the original int16_t conversions.
  int32_t product = (int32_t)20159 * a;
  int32_t coarse = product >> 25;
  int16_t t = (coarse + 1) >> 1;
  t *= 3329;
  return a - t;
}

int16_t barrett_reduce(int16_t a) {
  // Replace arithmetic right shift with explicit floor division.
  // Correct truncation toward zero when the biased value is negative.
  // Negation and the correction fit in int32_t for every input.
  // Preserve both int16_t conversions from the reference.
  int32_t biased = (int32_t)20159 * a + 33554432;
  int32_t quotient;
  if (biased < 0)
    quotient = -((-biased + 67108863) / 67108864);
  else
    quotient = biased / 67108864;
  int16_t t = quotient;
  t *= 3329;
  return a - t;
}

int16_t barrett_reduce(int16_t a) {
  // Reflect the biased numerator before an arithmetic right shift.
  // For integer n and positive d, floor of n/d equals
  // minus floor of the quantity d minus one minus n, divided by d.
  // This includes exact boundaries; all intermediates fit in int32_t.
  // Keep the reference's narrowing after multiplication by 3329.
  int32_t reflected = 33554431 - (int32_t)20159 * a;
  int16_t t = -(reflected >> 26);
  t *= 3329;
  return a - t;
}

int16_t barrett_reduce(int16_t a) {
  // Compute the same rounded quotient, then split 3329 into 3328 plus 1.
  // The quotient is between -10 and 10, so int32_t arithmetic is exact.
  // Narrow the complete product, preserving wraparound at the extremes.
  int16_t t = ((int32_t)20159 * a + 33554432) >> 26;
  t = (int16_t)((int32_t)t * 3328 + t);
  return a - t;
}