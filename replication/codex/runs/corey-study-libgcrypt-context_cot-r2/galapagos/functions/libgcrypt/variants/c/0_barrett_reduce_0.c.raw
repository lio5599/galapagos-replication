int16_t barrett_reduce(int16_t a) {
  // The reference computes the centered residue of a modulo 3329.
  // The rounded reciprocal constant evaluates to 20159.
  // Keep both int16_t conversions, including at the input extremes.
  int16_t t;
  t = ((int32_t)20159 * a + (1 << 25)) >> 26;
  t *= 3329;
  return a - t;
}
