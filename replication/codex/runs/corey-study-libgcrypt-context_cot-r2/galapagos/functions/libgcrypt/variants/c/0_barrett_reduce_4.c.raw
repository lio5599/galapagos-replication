int16_t barrett_reduce(int16_t a) {
  // Absorb most of the rounding bias into the multiplicand.
  // Since 20159 times 1664 plus 9856 equals 33554432,
  // the shifted value is identical, with no int32_t overflow.
  // Preserve the reference's int16_t conversions at the extremes.
  int32_t shifted_input = (int32_t)a + 1664;
  int16_t t = (20159 * shifted_input + 9856) >> 26;
  t *= 3329;
  return a - t;
}
