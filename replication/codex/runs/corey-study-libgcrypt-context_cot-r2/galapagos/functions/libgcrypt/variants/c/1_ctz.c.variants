static int ctz(uint64_t in)
{
 // The reference counts trailing zero bits, returning 64 for zero.
 // Shift away zero bits until the first one appears.
 // The explicit zero case prevents an unbounded loop.
 int r = 0;
 if (in == 0)
  return 64;
 while ((in & 1) == 0)
 {
  ++r;
  in >>= 1;
 }
 return r;
}

static int ctz(uint64_t in)
{
 // Test successive bit positions from least to most significant.
 // The first set bit's index is the trailing-zero count.
 // If no bit is set, return 64; every shift count is below 64.
 int i;
 for (i = 0; i < 64; ++i)
 {
  if (((in >> i) & 1) != 0)
   return i;
 }
 return 64;
}

static int ctz(uint64_t in)
{
 // Scan from the highest bit down, recording each set bit's index.
 // The last recorded index belongs to the least significant set bit.
 // The initial result of 64 is preserved for zero.
 int i;
 int r = 64;
 for (i = 63; i >= 0; --i)
 {
  if (((in >> i) & 1) != 0)
   r = i;
 }
 return r;
}

static int ctz(uint64_t in)
{
 // Skip zero blocks using successively smaller power-of-two sizes.
 // Each skipped block adds exactly its width to the zero count.
 // Zero is handled separately; the final bit distinguishes 0 from 1.
 int r = 0;
 if (in == 0)
  return 64;
 if ((in & 0xFFFFFFFFULL) == 0)
 {
  r += 32;
  in >>= 32;
 }
 if ((in & 0xFFFFULL) == 0)
 {
  r += 16;
  in >>= 16;
 }
 if ((in & 0xFFULL) == 0)
 {
  r += 8;
  in >>= 8;
 }
 if ((in & 0xFULL) == 0)
 {
  r += 4;
  in >>= 4;
 }
 if ((in & 3) == 0)
 {
  r += 2;
  in >>= 2;
 }
 return r + (int)((in & 1) == 0);
}

static int ctz(uint64_t in)
{
 // Unsigned negation isolates the least significant set bit.
 // Shifting this power of two down to one counts its bit index.
 // Zero is handled separately and returns 64.
 uint64_t bit;
 int r = 0;
 if (in == 0)
  return 64;
 bit = in & (uint64_t)(0ULL - in);
 while (bit > 1)
 {
  bit >>= 1;
  ++r;
 }
 return r;
}

static int ctz(uint64_t in)
{
 // Subtracting one from the isolated lowest bit marks all lower bits.
 // Counting those marked bits gives the trailing-zero count.
 // For zero, unsigned wraparound marks all 64 bits.
 uint64_t bits = (uint64_t)((in & (uint64_t)(0ULL - in)) - 1ULL);
 int r = 0;
 int i;
 for (i = 0; i < 64; ++i)
 {
  r += (int)(bits & 1);
  bits >>= 1;
 }
 return r;
}

static int ctz(uint64_t in)
{
 // Build masks covering successively longer low-bit prefixes.
 // A prefix is zero exactly when its length does not exceed the count.
 // All 64 prefixes are zero for input zero, producing 64.
 uint64_t mask = 1;
 int i;
 int r = 0;
 for (i = 0; i < 64; ++i)
 {
  r += (in & mask) == 0;
  mask = (uint64_t)((mask << 1) | 1);
 }
 return r;
}

static int ctz(uint64_t in)
{
 // Skip whole zero bytes, then count zero bits within the first nonzero byte.
 // The skipped byte widths and remaining bits sum to the lowest set index.
 // Handling zero first ensures both loops terminate and returns 64.
 int r = 0;
 if (in == 0)
  return 64;
 while ((in & 0xFFULL) == 0)
 {
  r += 8;
  in >>= 8;
 }
 while ((in & 1) == 0)
 {
  ++r;
  in >>= 1;
 }
 return r;
}

static int ctz(uint64_t in)
{
 // Accumulate whether any set bit has appeared in the scanned prefix.
 // Add one only while that prefix remains entirely zero.
 // A zero input keeps every prefix zero and therefore returns 64.
 int i;
 int seen = 0;
 int r = 0;
 for (i = 0; i < 64; ++i)
 {
  seen |= (int)((in >> i) & 1);
  r += 1 - seen;
 }
 return r;
}

static int ctz(uint64_t in)
{
 // The lowest set bit minus one has one bit for each trailing zero.
 // For zero, unsigned wraparound instead produces 64 one bits.
 // Parallel population counting sums those bits without external calls.
 uint64_t bits = (uint64_t)((in & (uint64_t)(0ULL - in)) - 1ULL);
 bits = bits - ((bits >> 1) & 0x5555555555555555ULL);
 bits = (bits & 0x3333333333333333ULL)
      + ((bits >> 2) & 0x3333333333333333ULL);
 bits = (bits + (bits >> 4)) & 0x0F0F0F0F0F0F0F0FULL;
 bits = bits + (bits >> 8);
 bits = bits + (bits >> 16);
 bits = bits + (bits >> 32);
 return (int)(bits & 0x7FULL);
}