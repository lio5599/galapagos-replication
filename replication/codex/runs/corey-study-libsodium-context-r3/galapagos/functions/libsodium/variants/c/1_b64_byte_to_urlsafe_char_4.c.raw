static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int a = ((x - 26U) >> 8) & 255U;
    unsigned int b = ((x - 52U) >> 8) & 255U;
    unsigned int c = ((x - 62U) >> 8) & 255U;
    unsigned int upper = a & (x + 'A');
    unsigned int lower = ~a & b & (x + ('a' - 26));
    unsigned int digit = ~b & c & (x + ('0' - 52));
    unsigned int dash = ~((0U - (x ^ 62U)) >> 8) & 255U & '-';
    unsigned int underscore = ~((0U - (x ^ 63U)) >> 8) & 255U & '_';

    return (int)((upper ^ lower) | digit | dash | underscore);
}
