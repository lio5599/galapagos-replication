static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Uses a switch to distinguish stereo from every other channel count.
    // The default includes zero and negative counts, matching the original else.
    // Payload expressions, division semantics, and accumulation order are unchanged.
    int count = 16;

    count += ch * ((7 + bps + 7) / 8);
    switch (ch) {
    case 2:
        count += ((2 * bps + 1) * blocksize + 7) / 8;
        break;
    default:
        count += (ch * bps * blocksize + 7) / 8;
        break;
    }
    count += 2;
    return count;
}
