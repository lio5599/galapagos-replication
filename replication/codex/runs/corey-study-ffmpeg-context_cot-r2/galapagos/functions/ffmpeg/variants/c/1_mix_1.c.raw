static int mix(int c0, int c1)
{
    // Replaces doubling with addition of identical extracted components.
    // The extracted ranges keep these additions within signed integer bounds.
    // Signed red shifts and truncation toward zero remain unchanged.
    int b0 = c0 & 0x001F;
    int b1 = c1 & 0x001F;
    int g0 = (c0 & 0x03E0) >> 5;
    int g1 = (c1 & 0x03E0) >> 5;
    int r0 = c0 >> 10;
    int r1 = c1 >> 10;
    int blue = b0 + b0 + b1;
    int green = g0 + g0 + g1;
    int red = r0 + r0 + r1;
    return red / 3 * 1024 + green / 3 * 32 + blue / 3;
}
