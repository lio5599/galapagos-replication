static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;

    for (uint64_t bit = (uint64_t)1 << 21; bit; bit >>= 1) {
        uint64_t candidate = r | bit;

        if (candidate <= 2642245 &&
            candidate * candidate * candidate <= x)
            r = candidate;
    }

    return r << 12;
}
