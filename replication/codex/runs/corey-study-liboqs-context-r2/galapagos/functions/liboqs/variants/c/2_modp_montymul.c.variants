
#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    return d + (d >> 31) * p;
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    if (d >> 31) {
        d += p;
    }
    return d;
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint32_t t = (uint32_t)((z + w) >> 31);
    uint32_t d = t - p;
    return (d >> 31) ? t : d;
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint32_t t = (uint32_t)((z + w) >> 31);
    uint32_t d = t - p;
    uint32_t mask = UINT32_C(0) - (d >> 31);
    return (t & mask) | (d & ~mask);
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint32_t t = (uint32_t)((z + w) >> 31);
    uint32_t d = t - p;
    return t - p * (UINT32_C(1) - (d >> 31));
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint32_t q = (uint32_t)(z * p0i);
    q &= UINT32_C(0x7FFFFFFF);
    uint64_t w = (uint64_t)q * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    return d + (p & (UINT32_C(0) - (d >> 31)));
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t q = z * p0i;
    q = (q << 33) >> 33;
    uint64_t sum = z + q * p;
    uint32_t d = (uint32_t)(sum >> 31) - p;
    return d + (p & (UINT32_C(0) - (d >> 31)));
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t q = ((uint64_t)(uint32_t)z * p0i)
               & UINT64_C(0x7FFFFFFF);
    uint64_t sum = z + q * p;
    uint32_t t = (uint32_t)(sum >> 32);
    t = (t << 1) | (uint32_t)((sum >> 31) & UINT64_C(1));
    uint32_t d = t - p;
    return d + (p & (UINT32_C(0) - (d >> 31)));
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint64_t low = (z & UINT64_C(0x7FFFFFFF))
                 + (w & UINT64_C(0x7FFFFFFF));
    uint32_t t = (uint32_t)(z >> 31);
    t += (uint32_t)(w >> 31);
    t += (uint32_t)(low >> 31);
    uint32_t d = t - p;
    return d + (p & (UINT32_C(0) - (d >> 31)));
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint32_t t = (uint32_t)((z + w) >> 31);
    uint32_t d = t - p;
    uint32_t mask = UINT32_C(0) - (d >> 31);
    return d ^ ((d ^ t) & mask);
}
