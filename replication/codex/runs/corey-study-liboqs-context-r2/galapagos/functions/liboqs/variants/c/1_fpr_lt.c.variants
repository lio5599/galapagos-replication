
#include <stdint.h>

static int fpr_lt(uint64_t x, uint64_t y)
{
    unsigned sx = (unsigned)(x >> 63);
    unsigned sy = (unsigned)(y >> 63);

    if (sx != sy)
        return (int)sx;
    if (sx)
        return x > y;
    return x < y;
}



#include <stdint.h>

static int fpr_lt(uint64_t x, uint64_t y)
{
    uint64_t sx = x >> 63;
    uint64_t sy = y >> 63;

    return (int)((sx ^ sy) ? sx : (sx ? (x > y) : (x < y)));
}



#include <stdint.h>

static int fpr_lt(uint64_t x, uint64_t y)
{
    unsigned sx = (unsigned)(x >> 63);
    unsigned sy = (unsigned)(y >> 63);
    unsigned different = sx ^ sy;

    return (int)((different & sx)
        | ((different ^ 1U) & (sx ^ 1U) & (unsigned)(x < y))
        | ((different ^ 1U) & sx & (unsigned)(x > y)));
}



#include <stdint.h>

static int fpr_lt(uint64_t x, uint64_t y)
{
    uint64_t sign = (uint64_t)1 << 63;
    uint64_t kx = x ^ (((uint64_t)0 - (x >> 63)) | sign);
    uint64_t ky = y ^ (((uint64_t)0 - (y >> 63)) | sign);

    return kx < ky;
}



#include <stdint.h>

static int fpr_lt(uint64_t x, uint64_t y)
{
    uint64_t sign = (uint64_t)1 << 63;
    uint64_t kx = (x & sign) ? ~x : (x ^ sign);
    uint64_t ky = (y & sign) ? ~y : (y ^ sign);

    return kx < ky;
}



#include <stdint.h>

static int fpr_lt(uint64_t x, uint64_t y)
{
    uint64_t mask = ((uint64_t)1 << 63) - 1;
    uint64_t kx = x ^ ((x >> 63) ? 0 : mask);
    uint64_t ky = y ^ ((y >> 63) ? 0 : mask);

    return kx > ky;
}



#include <stdint.h>

static int fpr_lt(uint64_t x, uint64_t y)
{
    unsigned sx = (unsigned)(x >> 63);
    unsigned different = (unsigned)((x ^ y) >> 63);
    unsigned less = (unsigned)(x < y);
    unsigned unequal = (unsigned)(x != y);
    unsigned same_sign_result = less ^ (sx & unequal);

    return (int)((different & sx)
        | ((different ^ 1U) & same_sign_result));
}



#include <stdint.h>

static int fpr_lt(uint64_t x, uint64_t y)
{
    unsigned sx = (unsigned)(x >> 63);
    unsigned different = (unsigned)((x ^ y) >> 63);
    unsigned forward = (unsigned)((x - y) >> 63);
    unsigned reverse = (unsigned)((y - x) >> 63);
    unsigned same_sign_result = forward ^ ((forward ^ reverse) & sx);

    return (int)(same_sign_result
        ^ ((same_sign_result ^ sx) & different));
}



#include <stdint.h>

static int fpr_lt(uint64_t x, uint64_t y)
{
    uint64_t different = (x ^ y) >> 63;
    uint64_t adjusted_y = y & (different - (uint64_t)1);
    unsigned cc0 = (unsigned)((x - adjusted_y) >> 63);
    unsigned cc1 = (unsigned)((adjusted_y - x) >> 63);
    unsigned both_negative = (unsigned)((x & y) >> 63);

    return (int)(cc0 ^ ((cc0 ^ cc1) & both_negative));
}



#include <stdint.h>

static int fpr_lt(uint64_t x, uint64_t y)
{
    unsigned sx = (unsigned)(x >> 63);
    unsigned sy = (unsigned)(y >> 63);
    uint64_t mx = x & (((uint64_t)1 << 63) - 1);
    uint64_t my = y & (((uint64_t)1 << 63) - 1);

    return (sx > sy)
        || ((sx == sy) && ((sx && (mx > my)) || (!sx && (mx < my))));
}
