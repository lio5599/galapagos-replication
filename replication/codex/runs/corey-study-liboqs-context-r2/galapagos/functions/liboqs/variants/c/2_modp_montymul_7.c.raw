uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t q = ((uint64_t)(uint32_t)z * p0i)
               & UINT64_C(0x7FFFFFFF);
    uint64_t sum = z + q * p;
    uint32_t t = (uint32_t)(sum >> 32);
    t = (t << 1) | (uint32_t)((sum >> 31) & UINT64_C(1));
    uint32_t d = t - p;
    return d + (p & (UINT32_C(0) - (d >> 31)));
}
