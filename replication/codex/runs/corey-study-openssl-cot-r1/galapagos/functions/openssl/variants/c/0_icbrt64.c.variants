static uint64_t icbrt64(uint64_t x)
{
    // The reference computes floor(cube_root(x)) multiplied by 4096.
    // Binary search brackets the root between a feasible and an exclusive bound.
    // 2642245 is the largest root for uint64_t, so every tested cube fits.
    // The initial bounds cover zero and UINT64_MAX without special cases.
    uint64_t lo = 0;
    uint64_t hi = 2642246;

    while (hi - lo > 1) {
        uint64_t mid = lo + (hi - lo) / 2;
        uint64_t cube = mid * mid * mid;
        if (cube <= x)
            lo = mid;
        else
            hi = mid;
    }
    return lo << 12;
}

static uint64_t icbrt64(uint64_t x)
{
    // Search an inclusive interval using upper midpoints.
    // For positive mid, mid <= x / mid / mid is exactly mid cubed <= x.
    // Division avoids overflow, and every tested midpoint is nonzero.
    // The bounds include every possible root, including zero and the maximum.
    uint64_t lo = 0;
    uint64_t hi = 2642245;

    while (lo < hi) {
        uint64_t mid = lo + (hi - lo + 1) / 2;
        if (mid <= x / mid / mid)
            lo = mid;
        else
            hi = mid - 1;
    }
    return lo << 12;
}

static uint64_t icbrt64(uint64_t x)
{
    // Construct the root greedily from its highest possible bit downward.
    // The division test accepts exactly the candidates whose cubes fit x.
    // Every candidate is positive, so division is safe even when x is zero.
    // All uint64_t cube roots fit in 22 bits; shifting by 12 gives the result.
    uint64_t r = 0;
    uint64_t bit;

    for (bit = (uint64_t)1 << 21; bit != 0; bit >>= 1) {
        uint64_t candidate = r | bit;
        if (candidate <= x / candidate / candidate)
            r = candidate;
    }
    return r << 12;
}

static uint64_t icbrt64(uint64_t x)
{
    // Greedily add root bits while maintaining cube equal to r cubed.
    // The polynomial delta is exactly the increase in the candidate cube.
    // Rejecting candidates above 2642245 makes all products and sums fit.
    // Comparing delta with x minus cube handles zero and UINT64_MAX safely.
    uint64_t r = 0;
    uint64_t cube = 0;
    uint64_t bit;

    for (bit = (uint64_t)1 << 21; bit != 0; bit >>= 1) {
        uint64_t candidate = r + bit;
        if (candidate <= 2642245) {
            uint64_t delta =
                3 * r * r * bit + 3 * r * bit * bit + bit * bit * bit;
            if (delta <= x - cube) {
                r = candidate;
                cube += delta;
            }
        }
    }
    return r << 12;
}

static uint64_t icbrt64(uint64_t x)
{
    // Use the reference's restoring steps with an expanded trial polynomial.
    // 3*r*r + 3*r + 1 equals the difference between consecutive cubes.
    // The comparison guarantees the shifted subtraction fits without wrapping.
    // All 22 steps are retained, covering zero through UINT64_MAX exactly.
    uint64_t r = 0;
    int s;

    for (s = 63; s >= 0; s -= 3) {
        uint64_t trial;
        r += r;
        trial = 3 * r * r + 3 * r + 1;
        if (trial <= (x >> s)) {
            x -= trial << s;
            ++r;
        }
    }
    return r << 12;
}

static uint64_t icbrt64(uint64_t x)
{
    // Integer Newton iteration starts above every possible cube root.
    // Each update decreases an overestimate without crossing below the floor root.
    // A nondecreasing update therefore identifies the exact floor root.
    // Zero is handled separately; divisions and the update sum cannot overflow.
    uint64_t r = (uint64_t)1 << 22;

    if (x == 0)
        return 0;

    for (;;) {
        uint64_t next = (2 * r + x / r / r) / 3;
        if (next >= r)
            return r << 12;
        r = next;
    }
}

static uint64_t icbrt64(uint64_t x)
{
    // Enumerate consecutive cubes using their first and second differences.
    // delta is the next cube increment, and step is its next increase.
    // The subtraction test ensures cube never exceeds x or overflows.
    // The first rejected increment identifies the floor root for every input.
    uint64_t r = 0;
    uint64_t cube = 0;
    uint64_t delta = 1;
    uint64_t step = 6;

    while (delta <= x - cube) {
        cube += delta;
        ++r;
        delta += step;
        step += 6;
    }
    return r << 12;
}

static uint64_t icbrt64(uint64_t x)
{
    // The input bit length supplies a strict power-of-two upper root bound.
    // Binary search then finds the greatest feasible root below that bound.
    // Division tests cubes exactly without multiplication overflow.
    // Zero returns directly; the largest bound is only 2 to the power 22.
    uint64_t t = x;
    uint64_t lo = 0;
    uint64_t hi;
    unsigned int bits = 0;

    if (x == 0)
        return 0;

    while (t != 0) {
        ++bits;
        t >>= 1;
    }
    hi = (uint64_t)1 << ((bits + 2) / 3);

    while (hi - lo > 1) {
        uint64_t mid = lo + (hi - lo) / 2;
        if (mid <= x / mid / mid)
            lo = mid;
        else
            hi = mid;
    }
    return lo << 12;
}

static uint64_t icbrt64(uint64_t x)
{
    // Read base-eight digits and maintain the processed prefix's cube remainder.
    // Appending a digit doubles the root and multiplies its remainder by eight.
    // The consecutive-cube difference decides whether the next root bit is one.
    // Remainders stay below 2 to the power 45, including at UINT64_MAX.
    uint64_t r = 0;
    uint64_t remainder = 0;
    int s;

    for (s = 63; s >= 0; s -= 3) {
        uint64_t trial;
        remainder = (remainder << 3) | ((x >> s) & 7);
        r <<= 1;
        trial = 3 * r * (r + 1) + 1;
        if (remainder >= trial) {
            remainder -= trial;
            ++r;
        }
    }
    return r << 12;
}

static uint64_t icbrt64(uint64_t x)
{
    // Use two trial points to reduce a bracket containing the floor cube root.
    // lo remains feasible and hi remains an exclusive upper bound.
    // Trial points never exceed 2642245, so their cubes cannot overflow.
    // Each iteration shrinks the bracket, including for zero and UINT64_MAX.
    uint64_t lo = 0;
    uint64_t hi = 2642246;

    while (hi - lo > 1) {
        uint64_t width = hi - lo;
        uint64_t a = lo + width / 3;
        uint64_t b = lo + (2 * width) / 3;

        if (b * b * b <= x) {
            lo = b;
        } else if (a * a * a <= x) {
            lo = a;
            hi = b;
        } else {
            hi = a;
        }
    }
    return lo << 12;
}