int16_t barrett_reduce(int16_t a) {
  // The reference computes the residue modulo 3329 in the range -1664 to 1664.
  // Signed remainder followed by centering gives that unique residue.
  // Widening keeps all operations safe, including for a equal to -32768.
  int32_t r = (int32_t)a % 3329;
  if (r > 1664)
    r -= 3329;
  else if (r < -1664)
    r += 3329;
  return (int16_t)r;
}

int16_t barrett_reduce(int16_t a) {
  // Shifting by 1664 maps the desired interval to residues 0 through 3328.
  // Correct a negative C remainder before undoing the shift.
  // The shifted input and final result fit their types at both endpoints.
  int32_t r = ((int32_t)a + 1664) % 3329;
  if (r < 0)
    r += 3329;
  return (int16_t)(r - 1664);
}

int16_t barrett_reduce(int16_t a) {
  // Reduce the magnitude, center it, then restore the input's sign.
  // Centered reduction is odd because the modulus is odd, so no ties occur.
  // Negation happens in int32_t, making -32768 safe as well.
  int32_t x = (int32_t)a;
  int32_t magnitude = x < 0 ? -x : x;
  int32_t r = magnitude % 3329;
  if (r > 1664)
    r -= 3329;
  return (int16_t)(x < 0 ? -r : r);
}

int16_t barrett_reduce(int16_t a) {
  // Signed division with a sign-dependent bias finds the nearest quotient.
  // An odd modulus has no integer halfway cases, including at the boundaries.
  // All biased inputs and quotient products fit int32_t for every int16_t.
  int32_t x = (int32_t)a;
  int32_t q = x >= 0 ? (x + 1664) / 3329 : (x - 1664) / 3329;
  return (int16_t)(x - q * 3329);
}

int16_t barrett_reduce(int16_t a) {
  // Adding ten moduli preserves the residue and makes every input positive.
  // Ordinary remainder can then be centered with a single correction.
  // The biased range is 522 through 66057, safely inside int32_t.
  int32_t r = ((int32_t)a + 33290) % 3329;
  if (r > 1664)
    r -= 3329;
  return (int16_t)r;
}

int16_t barrett_reduce(int16_t a) {
  // Add or subtract moduli until the unique centered representative remains.
  // Each step preserves congruence and moves an out-of-range value inward.
  // Widened arithmetic is safe for both int16_t endpoints and terminates.
  int32_t r = (int32_t)a;
  while (r > 1664)
    r -= 3329;
  while (r < -1664)
    r += 3329;
  return (int16_t)r;
}

int16_t barrett_reduce(int16_t a) {
  // Binary-sized modulus subtractions reduce the magnitude without division.
  // Every magnitude is below sixteen moduli, so four tests leave it below 3329.
  // Centering and restoring the sign give the same residue, even for -32768.
  int32_t x = (int32_t)a;
  int32_t r = x < 0 ? -x : x;
  if (r >= 26632)
    r -= 26632;
  if (r >= 13316)
    r -= 13316;
  if (r >= 6658)
    r -= 6658;
  if (r >= 3329)
    r -= 3329;
  if (r > 1664)
    r -= 3329;
  return (int16_t)(x < 0 ? -r : r);
}

int16_t barrett_reduce(int16_t a) {
  // Bitwise long division computes the magnitude's remainder exactly.
  // Each step starts below 3329, so doubling needs at most one subtraction.
  // Sixteen bits cover every magnitude, including 32768; centering is odd.
  int32_t x = (int32_t)a;
  uint32_t magnitude = (uint32_t)(x < 0 ? -x : x);
  uint32_t r = 0;
  int32_t centered;
  int i;
  for (i = 15; i >= 0; --i) {
    r = (r << 1) | ((magnitude >> i) & 1u);
    if (r >= 3329u)
      r -= 3329u;
  }
  centered = (int32_t)r;
  if (centered > 1664)
    centered -= 3329;
  return (int16_t)(x < 0 ? -centered : centered);
}

int16_t barrett_reduce(int16_t a) {
  // Use the reference reciprocal, replacing arithmetic shift with floor division.
  // Correct truncating division only when a negative numerator has a remainder.
  // Widening the modulus product avoids intermediate int16_t narrowing.
  // Since 20159*3329 equals 2^26+447, rounding is exact over all int16_t inputs.
  int32_t x = (int32_t)a;
  int32_t n = 20159 * x + 33554432;
  int32_t q = n / 67108864;
  if (n < 0 && n % 67108864 != 0)
    --q;
  return (int16_t)(x - q * 3329);
}

int16_t barrett_reduce(int16_t a) {
  // Apply reciprocal rounding to the magnitude using an unsigned right shift.
  // Reciprocal error is below 0.000066, less than the nearest half-step gap.
  // Thus the quotient is exact throughout the int16_t range, including -32768.
  // Centered reduction is odd, so restoring the sign matches the reference.
  int32_t x = (int32_t)a;
  uint32_t magnitude = (uint32_t)(x < 0 ? -x : x);
  uint32_t q = (20159u * magnitude + 33554432u) >> 26;
  int32_t r = (int32_t)magnitude - (int32_t)q * 3329;
  return (int16_t)(x < 0 ? -r : r);
}