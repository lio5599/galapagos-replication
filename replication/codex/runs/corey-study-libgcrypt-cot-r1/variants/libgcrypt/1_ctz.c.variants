static int ctz(uint64_t in)
{
 // The reference counts trailing zero bits, returning 64 when in is zero.
 // Shift away zero low bits until the first one is reached.
 // Handle zero separately so the loop always terminates.
 int r = 0;
 if (in == 0)
  return 64;
 while ((in & 1) == 0)
 {
  ++r;
  in >>= 1;
 }
 return r;
}

static int ctz(uint64_t in)
{
 // Test successive bit positions using a single-bit mask.
 // The first set bit's position equals the number of trailing zeros.
 // For zero, the unsigned mask wraps to zero after all 64 positions.
 uint64_t mask = 1;
 int r = 0;
 while (mask != 0 && (in & mask) == 0)
 {
  ++r;
  mask <<= 1;
 }
 return r;
}

static int ctz(uint64_t in)
{
 // Skip zero low blocks of successively halved sizes.
 // Each skipped block contributes exactly its size to the zero count.
 // Zero is handled explicitly; nonzero inputs leave a final set bit.
 int r = 0;
 if (in == 0)
  return 64;
 if ((in & UINT64_C(0xffffffff)) == 0)
 {
  r += 32;
  in >>= 32;
 }
 if ((in & UINT64_C(0xffff)) == 0)
 {
  r += 16;
  in >>= 16;
 }
 if ((in & UINT64_C(0xff)) == 0)
 {
  r += 8;
  in >>= 8;
 }
 if ((in & UINT64_C(0xf)) == 0)
 {
  r += 4;
  in >>= 4;
 }
 if ((in & UINT64_C(0x3)) == 0)
 {
  r += 2;
  in >>= 2;
 }
 return r + ((in & 1) == 0);
}

static int ctz(uint64_t in)
{
 // Unsigned subtraction isolates the lowest set bit when ANDed with in.
 // Its base-two exponent is exactly the trailing-zero count.
 // Zero is returned as 64 before computing that exponent.
 uint64_t low;
 int r = 0;
 if (in == 0)
  return 64;
 low = in & (UINT64_C(0) - in);
 while (low > 1)
 {
  low >>= 1;
  ++r;
 }
 return r;
}

static int ctz(uint64_t in)
{
 // Subtracting one from the isolated lowest bit makes the lower bits ones.
 // Their population count equals the number of trailing zeros.
 // For zero, unsigned wraparound produces 64 ones, hence a result of 64.
 uint64_t bits = (in & (UINT64_C(0) - in)) - UINT64_C(1);
 int r = 0;
 while (bits != 0)
 {
  bits &= bits - UINT64_C(1);
  ++r;
 }
 return r;
}

static int ctz(uint64_t in)
{
 // The isolated lowest bit minus one has one bit per trailing zero.
 // For zero, unsigned wraparound instead gives all 64 bits set.
 // Parallel field sums compute that population count, including 64.
 uint64_t x = (in & (UINT64_C(0) - in)) - UINT64_C(1);
 x -= (x >> 1) & UINT64_C(0x5555555555555555);
 x = (x & UINT64_C(0x3333333333333333))
     + ((x >> 2) & UINT64_C(0x3333333333333333));
 x = (x + (x >> 4)) & UINT64_C(0x0f0f0f0f0f0f0f0f);
 x += x >> 8;
 x += x >> 16;
 x += x >> 32;
 return (int)(x & UINT64_C(0x7f));
}

static int ctz(uint64_t in)
{
 // Propagate every set bit upward, filling from the lowest one to bit 63.
 // The remaining zero bits are precisely the original trailing zeros.
 // Zero remains zero, so counting the complemented bits returns 64.
 uint64_t bits;
 int i, r = 0;
 in |= in << 1;
 in |= in << 2;
 in |= in << 4;
 in |= in << 8;
 in |= in << 16;
 in |= in << 32;
 bits = ~in;
 for (i = 0; i < 64; ++i)
 {
  r += (int)(bits & 1);
  bits >>= 1;
 }
 return r;
}

static int ctz(uint64_t in)
{
 // Skip zero nibbles, then classify the first nonzero nibble.
 // Its lowest set bit adds zero through three to the skipped-bit count.
 // An explicit zero check prevents endlessly skipping empty nibbles.
 int r = 0;
 if (in == 0)
  return 64;
 while ((in & UINT64_C(0xf)) == 0)
 {
  r += 4;
  in >>= 4;
 }
 switch ((unsigned int)(in & UINT64_C(0xf)))
 {
  case 8:
   return r + 3;
  case 4:
  case 12:
   return r + 2;
  case 2:
  case 6:
  case 10:
  case 14:
   return r + 1;
  default:
   return r;
 }
}

static int ctz(uint64_t in)
{
 // Inspect bytes from least significant to most significant.
 // Each empty byte adds eight; count low zero bits in the first nonempty byte.
 // If every byte is zero, all eight iterations contribute eight, returning 64.
 int i, r = 0;
 unsigned int byte;
 for (i = 0; i < 8; ++i)
 {
  byte = (unsigned int)(in & UINT64_C(0xff));
  if (byte != 0)
  {
   while ((byte & 1U) == 0)
   {
    ++r;
    byte >>= 1;
   }
   return r;
  }
  r += 8;
  in >>= 8;
 }
 return r;
}

static int ctz(uint64_t in)
{
 // Isolate the lowest set bit and decode its position using six masks.
 // Each mask selects positions with a particular binary index bit set.
 // The decoded position is the trailing-zero count; zero returns 64 explicitly.
 uint64_t low;
 int r = 0;
 if (in == 0)
  return 64;
 low = in & (UINT64_C(0) - in);
 if ((low & UINT64_C(0xaaaaaaaaaaaaaaaa)) != 0)
  r |= 1;
 if ((low & UINT64_C(0xcccccccccccccccc)) != 0)
  r |= 2;
 if ((low & UINT64_C(0xf0f0f0f0f0f0f0f0)) != 0)
  r |= 4;
 if ((low & UINT64_C(0xff00ff00ff00ff00)) != 0)
  r |= 8;
 if ((low & UINT64_C(0xffff0000ffff0000)) != 0)
  r |= 16;
 if ((low & UINT64_C(0xffffffff00000000)) != 0)
  r |= 32;
 return r;
}