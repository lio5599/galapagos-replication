
static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);
    count += (ch == 2)
        ? (((2 * bps + 1) * blocksize + 7) / 8)
        : ((ch * bps * blocksize + 7) / 8);
    count += 2;
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);
    if (ch != 2) {
        count += (ch * bps * blocksize + 7) / 8;
    } else {
        count += ((2 * bps + 1) * blocksize + 7) / 8;
    }
    return count + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);
    switch (ch) {
    case 2:
        count += ((2 * bps + 1) * blocksize + 7) / 8;
        break;
    default:
        count += (ch * bps * blocksize + 7) / 8;
        break;
    }
    count += 2;
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);
    if (ch == 2) {
        count += ((2 * bps + 1) * blocksize + 7) / 8;
        return count + 2;
    }
    count += (ch * bps * blocksize + 7) / 8;
    return count + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    int numerator;
    count += ch * ((7 + bps + 7) / 8);
    if (ch == 2) {
        numerator = (2 * bps + 1) * blocksize + 7;
    } else {
        numerator = ch * bps * blocksize + 7;
    }
    count += numerator / 8;
    count += 2;
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    int bits;
    count += ch * ((7 + bps + 7) / 8);
    if (ch == 2) {
        bits = 2 * bps + 1;
    } else {
        bits = ch * bps;
    }
    bits *= blocksize;
    bits += 7;
    count += bits / 8;
    count += 2;
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count;
    int header = 7 + bps;
    header += 7;
    header /= 8;
    header *= ch;
    count = 16 + header;
    if (ch == 2) {
        count += ((2 * bps + 1) * blocksize + 7) / 8;
    } else {
        count += (ch * bps * blocksize + 7) / 8;
    }
    count += 2;
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    int payload;
    count += ch * ((7 + bps + 7) / 8);
    payload = (ch == 2) ? (2 * bps + 1) : (ch * bps);
    payload = (payload * blocksize + 7) / 8;
    count = count + payload;
    return count + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);
    do {
        if (ch == 2) {
            count += ((2 * bps + 1) * blocksize + 7) / 8;
            break;
        }
        count += (ch * bps * blocksize + 7) / 8;
    } while (0);
    count += 2;
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);
    if (ch == 2)
        goto stereo;
    count += (ch * bps * blocksize + 7) / 8;
    goto finish;

stereo:
    count += ((2 * bps + 1) * blocksize + 7) / 8;

finish:
    count += 2;
    return count;
}
