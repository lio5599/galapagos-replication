static int b64_byte_to_char(unsigned int x)
{
    // Each accumulation uses r XOR (t AND NOT r), which equals r OR t.
    // This does not assume the contributions are disjoint.
    // Exact unsigned masks therefore preserve even out-of-range inputs.
    unsigned int a = ((x - 26U) >> 8) & 255U;
    unsigned int b = ((x - 52U) >> 8) & 255U;
    unsigned int c = ((x - 62U) >> 8) & 255U;
    unsigned int result = a & (x + 'A');
    unsigned int term = (a ^ 255U) & b & (x + ('a' - 26));
    result ^= term & ~result;
    term = (b ^ 255U) & c & (x + ('0' - 52));
    result ^= term & ~result;
    term = ((((0U - (x ^ 62U)) >> 8) & 255U) ^ 255U) & '+';
    result ^= term & ~result;
    term = ((((0U - (x ^ 63U)) >> 8) & 255U) ^ 255U) & '/';
    result ^= term & ~result;
    return result;
}
