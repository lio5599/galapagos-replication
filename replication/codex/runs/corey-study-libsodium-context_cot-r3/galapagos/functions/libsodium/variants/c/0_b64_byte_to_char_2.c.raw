static int b64_byte_to_char(unsigned int x)
{
    // Bitwise operations act independently on each bit.
    // Thus all byte truncations can be deferred to one final mask.
    // The original unsigned arithmetic is unchanged, including wraparound.
    unsigned int a = (x - 26U) >> 8;
    unsigned int b = (x - 52U) >> 8;
    unsigned int c = (x - 62U) >> 8;
    unsigned int d = (0U - (x ^ 62U)) >> 8;
    unsigned int e = (0U - (x ^ 63U)) >> 8;
    unsigned int result = (a & (x + 'A')) |
                          (~a & b & (x + ('a' - 26))) |
                          (~b & c & (x + ('0' - 52))) |
                          (~d & '+') | (~e & '/');
    return result & 255U;
}
