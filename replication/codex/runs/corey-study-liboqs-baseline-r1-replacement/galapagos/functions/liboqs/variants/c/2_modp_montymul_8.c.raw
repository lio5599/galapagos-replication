uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint32_t factor = (uint32_t)(z * p0i);

    factor &= UINT32_C(0x7FFFFFFF);
    z += (uint64_t)factor * p;

    uint32_t d = (uint32_t)(z >> 31) - p;

    switch (d >> 31) {
        case 0:
            return d;
        default:
            return d + p;
    }
}
