static unsigned int b64_char_to_byte(int c)
{
    // A five-step loop selects range parameters or a punctuation character.
    // Range masks and equality masks are the original byte-sliced operations.
    // Since x is a byte, only zero needs the original A-dependent correction.
    // This preserves all edge cases for which the reference has defined behavior.
    const unsigned int u = (unsigned int)c;
    unsigned int x = 0U;
    unsigned int i;
    for (i = 0U; i < 5U; ++i) {
        unsigned int first = 0U;
        unsigned int last = 0U;
        unsigned int base = 0U;
        unsigned int symbol = 0U;
        switch (i) {
        case 0U: first = 'A'; last = 'Z'; base = 0U; break;
        case 1U: first = 'a'; last = 'z'; base = 26U; break;
        case 2U: first = '0'; last = '9'; base = 52U; break;
        case 3U: symbol = '+'; base = 62U; break;
        default: symbol = '/'; base = 63U; break;
        }
        if (i < 3U)
            x |= ((~((u - first) | (last - u)) >> 8) & 255U) &
                 (u - first + base);
        else
            x |= ((~(0U - (u ^ symbol)) >> 8) & 255U) & base;
    }
    return x != 0U ? x : (((0U - (u ^ 'A')) >> 8) & 255U);
}
