
int16_t barrett_reduce(int16_t a) {
  int32_t t = ((int32_t)20159 * a + 33554432) >> 26;
  return (int16_t)((int32_t)a - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  int32_t n = (int32_t)20159 * a + 33554432;
  int32_t t = n / 67108864;
  t -= (n < 0 && n % 67108864 != 0);
  return (int16_t)((int32_t)a - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  int32_t r = (int32_t)a % 3329;
  if (r > 1664)
    r -= 3329;
  if (r < -1664)
    r += 3329;
  return (int16_t)r;
}



int16_t barrett_reduce(int16_t a) {
  return (int16_t)(((int32_t)a + 34954) % 3329 - 1664);
}



int16_t barrett_reduce(int16_t a) {
  int32_t q = (int32_t)a / 3329;
  int32_t r = (int32_t)a - q * 3329;
  r -= (r > 1664) * 3329;
  r += (r < -1664) * 3329;
  return (int16_t)r;
}



int16_t barrett_reduce(int16_t a) {
  int32_t r = a;
  while (r > 1664)
    r -= 3329;
  while (r < -1664)
    r += 3329;
  return (int16_t)r;
}



int16_t barrett_reduce(int16_t a) {
  int32_t magnitude = a < 0 ? -(int32_t)a : (int32_t)a;
  int32_t r = magnitude % 3329;
  if (r > 1664)
    r -= 3329;
  return (int16_t)(a < 0 ? -r : r);
}



int16_t barrett_reduce(int16_t a) {
  int32_t r = (int32_t)a + 1664;
  if (r < 0)
    r += 33290;
  if (r >= 26632)
    r -= 26632;
  if (r >= 13316)
    r -= 13316;
  if (r >= 6658)
    r -= 6658;
  if (r >= 3329)
    r -= 3329;
  return (int16_t)(r - 1664);
}



int16_t barrett_reduce(int16_t a) {
  int32_t q = ((int32_t)a + 34954) / 3329 - 10;
  return (int16_t)((int32_t)a - q * 3329);
}



int16_t barrett_reduce(int16_t a) {
  int32_t magnitude = a < 0 ? -(int32_t)a : (int32_t)a;
  int32_t q = (magnitude + 1664) / 3329;
  if (a < 0)
    q = -q;
  return (int16_t)((int32_t)a - q * 3329);
}
