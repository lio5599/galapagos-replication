
static int int16_t_negative_mask(int16_t x)
{
    return -(x < 0);
}



static int int16_t_negative_mask(int16_t x)
{
    return x < 0 ? -1 : 0;
}



static int int16_t_negative_mask(int16_t x)
{
    return (x >= 0) - 1;
}



static int int16_t_negative_mask(int16_t x)
{
    if (x < 0)
        return -1;
    return 0;
}



static int int16_t_negative_mask(int16_t x)
{
    int result = 0;
    if (x < 0)
        --result;
    return result;
}



static int int16_t_negative_mask(int16_t x)
{
    return -(int)((uint16_t)x >> 15);
}



static int int16_t_negative_mask(int16_t x)
{
    uint16_t u = (uint16_t)x;
    return -(int)(u / 32768u);
}



static int int16_t_negative_mask(int16_t x)
{
    return -((uint16_t)x > 32767u);
}



static int int16_t_negative_mask(int16_t x)
{
    uint16_t u = (uint16_t)x;
    return -((u & 0x8000u) != 0u);
}



static int int16_t_negative_mask(int16_t x)
{
    uint16_t u = (uint16_t)x;
    u ^= 0x8000u;
    return (int)(u >> 15) - 1;
}
