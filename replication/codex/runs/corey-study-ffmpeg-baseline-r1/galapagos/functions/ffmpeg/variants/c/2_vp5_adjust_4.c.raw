static int vp5_adjust(int v, int t)
{
    int negative = v < 0;
    int a = negative ? -v : v;
    int limit = 2 * t;
    int r;

    if (t < 0)
        return negative ? -limit : limit;
    if (a >= limit)
        return 0;

    r = a;
    if (a > t)
        r = limit - a;
    return negative ? -r : r;
}
