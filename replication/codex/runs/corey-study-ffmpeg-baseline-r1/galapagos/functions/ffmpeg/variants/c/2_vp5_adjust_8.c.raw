static int vp5_adjust(int v, int t)
{
    int negative = v < 0;
    int a = negative ? -v : v;
    int d, r;

    switch (a < 2 * t) {
    case 0:
        d = -t;
        break;
    default:
        d = a - t;
        break;
    }

    if (d < 0)
        d = -d;
    r = t - d;
    return negative ? -r : r;
}
