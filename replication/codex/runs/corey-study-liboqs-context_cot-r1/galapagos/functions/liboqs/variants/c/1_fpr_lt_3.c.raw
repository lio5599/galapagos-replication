int fpr_lt(uint64_t x, uint64_t y) {
    // Map negative encodings to complemented keys and positives above them.
    // Complementation reverses negative order without changing equality.
    // The key ranges also preserve differing-sign order, including zeros.
    uint64_t sign = (uint64_t)1 << 63;
    uint64_t kx = (x & sign) ? ~x : (x ^ sign);
    uint64_t ky = (y & sign) ? ~y : (y ^ sign);
    return kx < ky;
}
