int fpr_lt(uint64_t x, uint64_t y) {
    // The reference compares sign-bit encodings, reversing order for two negatives.
    // Different signs are ordered negative first, including negative zero.
    // Equal encodings return zero for either sign.
    unsigned sx = (unsigned)(x >> 63);
    unsigned sy = (unsigned)(y >> 63);
    if (sx != sy) {
        return (int)sx;
    }
    if (sx) {
        return x > y;
    }
    return x < y;
}
