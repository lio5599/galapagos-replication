static int fpr_lt(uint64_t x, uint64_t y) {
    // The reference compares sign-bit encodings, reversing order for two negatives.
    // Different signs are ordered negative first, including negative zero.
    // Equal encodings return zero for either sign.
    unsigned sx = (unsigned)(x >> 63);
    unsigned sy = (unsigned)(y >> 63);
    if (sx != sy) {
        return (int)sx;
    }
    if (sx) {
        return x > y;
    }
    return x < y;
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Select sign order when signs differ, otherwise select encoding order.
    // Negative encodings use reversed order; both comparisons are strict.
    // This preserves equality and distinguishes the two zero encodings.
    uint64_t different = (x ^ y) >> 63;
    return different ? (int)(x >> 63)
                     : ((x >> 63) ? (x > y) : (x < y));
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Combine three disjoint cases: differing signs, two positives, two negatives.
    // Strict unsigned comparisons make equal encodings return zero.
    // The differing-sign case also orders negative zero before positive zero.
    int sx = (int)(x >> 63);
    int sy = (int)(y >> 63);
    return (sx & (sy ^ 1))
         | ((sx ^ 1) & (sy ^ 1) & (x < y))
         | (sx & sy & (x > y));
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Map negative encodings to complemented keys and positives above them.
    // Complementation reverses negative order without changing equality.
    // The key ranges also preserve differing-sign order, including zeros.
    uint64_t sign = (uint64_t)1 << 63;
    uint64_t kx = (x & sign) ? ~x : (x ^ sign);
    uint64_t ky = (y & sign) ? ~y : (y ^ sign);
    return kx < ky;
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Construct ordered keys using sign-dependent XOR masks without branches.
    // Negative masks complement every bit; positive masks flip only the sign.
    // Keys preserve equality and put every negative encoding before positives.
    uint64_t sign = (uint64_t)1 << 63;
    uint64_t mx = ((uint64_t)0 - (x >> 63)) | sign;
    uint64_t my = ((uint64_t)0 - (y >> 63)) | sign;
    return (x ^ mx) < (y ^ my);
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Compare signs first, then compare magnitudes with sign bits removed.
    // Equal-sign magnitudes increase for positives and decrease for negatives.
    // Strict comparisons preserve equality; sign ordering distinguishes zeros.
    uint64_t mask = ((uint64_t)1 << 63) - 1;
    uint64_t ax = x & mask;
    uint64_t ay = y & mask;
    int sx = (int)(x >> 63);
    int sy = (int)(y >> 63);
    if (sx != sy) {
        return sx;
    }
    return sx ? (ay < ax) : (ax < ay);
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // For equal signs, encoding differences have magnitude below two to the 63.
    // The unsigned difference's top bit therefore indicates strict order.
    // Reverse subtraction for negatives; handle differing signs explicitly.
    // Unsigned subtraction is defined even at encoding boundaries.
    uint64_t sx = x >> 63;
    uint64_t sy = y >> 63;
    uint64_t forward = (x - y) >> 63;
    uint64_t reverse = (y - x) >> 63;
    uint64_t different = sx ^ sy;
    return (int)((different & sx)
               | ((different ^ 1) & ((sx & reverse)
                                   | ((sx ^ 1) & forward))));
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // For equal signs, reverse strict order by XOR only when encodings differ.
    // The inequality guard ensures equal negative encodings still return zero.
    // Differing signs use the first sign bit, including for zero encodings.
    int sx = (int)(x >> 63);
    int different = (int)((x ^ y) >> 63);
    int same_sign_result = (x < y) ^ (sx & (x != y));
    return different ? sx : same_sign_result;
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Swap the comparison operands when the first encoding is negative.
    // With equal signs this reverses precisely the negative ordering.
    // Differing signs override that comparison; equality remains strict.
    uint64_t sx = x >> 63;
    uint64_t mask = (uint64_t)0 - sx;
    uint64_t a = (x & ~mask) | (y & mask);
    uint64_t b = (y & ~mask) | (x & mask);
    if ((x ^ y) >> 63) {
        return (int)sx;
    }
    return a < b;
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Compare equal-sign encodings lexicographically in two 32-bit pieces.
    // Reverse each strict comparison for negatives, preserving equality.
    // Differing signs are handled first, including the two zero encodings.
    int sx = (int)(x >> 63);
    uint64_t hx = x >> 32;
    uint64_t hy = y >> 32;
    uint64_t lx = x & (uint64_t)0xFFFFFFFF;
    uint64_t ly = y & (uint64_t)0xFFFFFFFF;
    if ((x ^ y) >> 63) {
        return sx;
    }
    if (hx != hy) {
        return sx ? (hx > hy) : (hx < hy);
    }
    return sx ? (lx > ly) : (lx < ly);
}