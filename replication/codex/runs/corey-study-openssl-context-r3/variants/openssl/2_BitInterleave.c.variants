
static uint64_t BitInterleave(uint64_t Ai)
{
    return Ai;
}



static uint64_t BitInterleave(uint64_t Ai)
{
    uint64_t result = Ai;
    return result;
}



static uint64_t BitInterleave(uint64_t Ai)
{
    return Ai ^ (uint64_t)0;
}



static uint64_t BitInterleave(uint64_t Ai)
{
    return Ai | (uint64_t)0;
}



static uint64_t BitInterleave(uint64_t Ai)
{
    return Ai & ~(uint64_t)0;
}



static uint64_t BitInterleave(uint64_t Ai)
{
    return ~(~Ai);
}



static uint64_t BitInterleave(uint64_t Ai)
{
    uint64_t mask = (uint64_t)0x5555555555555555ULL;
    return (Ai & mask) | (Ai & ~mask);
}



static uint64_t BitInterleave(uint64_t Ai)
{
    uint64_t hi = Ai >> 32;
    uint64_t lo = Ai & (uint64_t)0xffffffffULL;
    return (hi << 32) | lo;
}



static uint64_t BitInterleave(uint64_t Ai)
{
    uint64_t mask = (uint64_t)0xa5a5a5a5a5a5a5a5ULL;
    uint64_t encoded = Ai ^ mask;
    return encoded ^ mask;
}



static uint64_t BitInterleave(uint64_t Ai)
{
    if (Ai == (uint64_t)0)
        return (uint64_t)0;
    return Ai;
}
