static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    int bits;

    count += ch * ((7 + bps + 7) / 8);
    if (ch == 2)
        bits = 2 * bps + 1;
    else
        bits = ch * bps;

    count += (bits * blocksize + 7) / 8;
    count += 2;
    return count;
}
