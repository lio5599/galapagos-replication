static int mix(int c0, int c1)
{
    int blue = 2 * (c0 & 31) + (c1 & 31);
    int green = (2 * (c0 & 992) + (c1 & 992)) >> 5;
    int red = 2 * (c0 >> 10) + (c1 >> 10);
    int blue_q = 0;
    int green_q = 0;
    while (blue >= 3) {
        blue -= 3;
        ++blue_q;
    }
    while (green >= 3) {
        green -= 3;
        ++green_q;
    }
    return red / 3 * 1024 + green_q * 32 + blue_q;
}
