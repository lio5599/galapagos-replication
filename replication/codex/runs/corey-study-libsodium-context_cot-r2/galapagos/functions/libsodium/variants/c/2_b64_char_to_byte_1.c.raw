static unsigned int b64_char_to_byte(int c)
{
    // Complementing before the shift produces the same eight-bit masks.
    // All intermediate values use unsigned arithmetic without narrowing the input.
    // The final mask therefore preserves the reference's non-byte edge cases.
    const unsigned int u = (unsigned int)c;
    const unsigned int a = ((~(u - 'A') >> 8) & 255U) &
                           ((~('Z' - u) >> 8) & 255U);
    const unsigned int b = ((~(u - 'a') >> 8) & 255U) &
                           ((~('z' - u) >> 8) & 255U);
    const unsigned int d = ((~(u - '0') >> 8) & 255U) &
                           ((~('9' - u) >> 8) & 255U);
    const unsigned int p = (~(0U - (u ^ '+')) >> 8) & 255U;
    const unsigned int q = (~(0U - (u ^ '/')) >> 8) & 255U;
    const unsigned int x = (a & (u - 'A')) |
                           (b & (u - 'a' + 26U)) |
                           (d & (u - '0' + 52U)) |
                           (p & 62U) | (q & 63U);
    return x | (((~(0U - x) >> 8) & 255U) &
                (((0U - (u ^ 'A')) >> 8) & 255U));
}
