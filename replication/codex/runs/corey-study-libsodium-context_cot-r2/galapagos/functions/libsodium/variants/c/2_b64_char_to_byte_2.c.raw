static unsigned int b64_char_to_byte(int c)
{
    // De Morgan's law combines each pair of range masks before shifting.
    // This is a bitwise identity, not an assumption that c is a byte.
    // Since x is at most 255, its final zero mask is 255 exactly when x is zero.
    const unsigned int u = (unsigned int)c;
    const unsigned int a = (~((u - 'A') | ('Z' - u)) >> 8) & 255U;
    const unsigned int b = (~((u - 'a') | ('z' - u)) >> 8) & 255U;
    const unsigned int d = (~((u - '0') | ('9' - u)) >> 8) & 255U;
    const unsigned int p = (~(0U - (u ^ '+')) >> 8) & 255U;
    const unsigned int q = (~(0U - (u ^ '/')) >> 8) & 255U;
    const unsigned int x = (a & (u - 'A')) |
                           (b & (u - 'a' + 26U)) |
                           (d & (u - '0' + 52U)) |
                           (p & 62U) | (q & 63U);
    if (x != 0U)
        return x;
    return ((0U - (u ^ 'A')) >> 8) & 255U;
}
