
#include <stdint.h>

static int ctz(uint64_t in)
{
    int r = 0;
    if (in == 0)
        return 64;
    while ((in & 1) == 0) {
        ++r;
        in >>= 1;
    }
    return r;
}



#include <stdint.h>

static int ctz(uint64_t in)
{
    int i;
    for (i = 0; i < 64; ++i) {
        if (((in >> i) & 1) != 0)
            return i;
    }
    return 64;
}



#include <stdint.h>

static int ctz(uint64_t in)
{
    int r = 0;
    while (r < 64 && (in & 1) == 0) {
        in >>= 1;
        ++r;
    }
    return r;
}



#include <stdint.h>

static int ctz(uint64_t in)
{
    uint64_t mask = 1;
    int r = 0;

    while (mask != 0 && (in & mask) == 0) {
        ++r;
        mask <<= 1;
    }
    return r;
}



#include <stdint.h>

static int ctz(uint64_t in)
{
    int r = 0;

    if (in == 0)
        return 64;
    if ((in & UINT64_C(0xffffffff)) == 0) {
        r += 32;
        in >>= 32;
    }
    if ((in & UINT64_C(0xffff)) == 0) {
        r += 16;
        in >>= 16;
    }
    if ((in & UINT64_C(0xff)) == 0) {
        r += 8;
        in >>= 8;
    }
    if ((in & UINT64_C(0xf)) == 0) {
        r += 4;
        in >>= 4;
    }
    if ((in & UINT64_C(0x3)) == 0) {
        r += 2;
        in >>= 2;
    }
    return r + ((in & 1) == 0);
}



#include <stdint.h>

static int ctz(uint64_t in)
{
    uint64_t bit;
    int r = 0;

    if (in == 0)
        return 64;

    bit = in & (~in + UINT64_C(1));
    if ((bit & UINT64_C(0xffffffff00000000)) != 0)
        r += 32;
    if ((bit & UINT64_C(0xffff0000ffff0000)) != 0)
        r += 16;
    if ((bit & UINT64_C(0xff00ff00ff00ff00)) != 0)
        r += 8;
    if ((bit & UINT64_C(0xf0f0f0f0f0f0f0f0)) != 0)
        r += 4;
    if ((bit & UINT64_C(0xcccccccccccccccc)) != 0)
        r += 2;
    if ((bit & UINT64_C(0xaaaaaaaaaaaaaaaa)) != 0)
        r += 1;
    return r;
}



#include <stdint.h>

static int ctz(uint64_t in)
{
    uint64_t bits = ~in & (in - UINT64_C(1));
    int r = 0;
    int i;

    for (i = 0; i < 64; ++i) {
        r += (int)(bits & 1);
        bits >>= 1;
    }
    return r;
}



#include <stdint.h>

static int ctz(uint64_t in)
{
    uint64_t x = ~in & (in - UINT64_C(1));

    x = x - ((x >> 1) & UINT64_C(0x5555555555555555));
    x = (x & UINT64_C(0x3333333333333333))
      + ((x >> 2) & UINT64_C(0x3333333333333333));
    x = (x + (x >> 4)) & UINT64_C(0x0f0f0f0f0f0f0f0f);
    x += x >> 8;
    x += x >> 16;
    x += x >> 32;
    return (int)(x & UINT64_C(0x7f));
}



#include <stdint.h>

static int ctz(uint64_t in)
{
    int i;
    int r = 0;

    for (i = 63; i >= 0; --i) {
        if (((in >> i) & 1) != 0)
            r = 0;
        else
            ++r;
    }
    return r;
}



#include <stdint.h>

static int ctz(uint64_t in)
{
    int r = 0;

    if (in == 0)
        return 64;

    while ((in & UINT64_C(15)) == 0) {
        r += 4;
        in >>= 4;
    }

    switch ((unsigned int)(in & UINT64_C(15))) {
    case 8:
        return r + 3;
    case 4:
    case 12:
        return r + 2;
    case 2:
    case 6:
    case 10:
    case 14:
        return r + 1;
    default:
        return r;
    }
}
