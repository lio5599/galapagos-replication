
static int int16_t_negative_mask(int16_t x)
{
    return -(x < 0);
}



static int int16_t_negative_mask(int16_t x)
{
    return x < 0 ? -1 : 0;
}



static int int16_t_negative_mask(int16_t x)
{
    if (x >= 0)
        return 0;
    return -1;
}



static int int16_t_negative_mask(int16_t x)
{
    return (x >= 0) - 1;
}



static int int16_t_negative_mask(int16_t x)
{
    return 0 - (int)((uint16_t)x >> 15);
}



static int int16_t_negative_mask(int16_t x)
{
    return -(int)((uint16_t)x / 32768u);
}



static int int16_t_negative_mask(int16_t x)
{
    return -(((uint16_t)x & 0x8000u) != 0);
}



static int int16_t_negative_mask(int16_t x)
{
    return -((uint16_t)x > 32767u);
}



static int int16_t_negative_mask(int16_t x)
{
    int negative = x < 0;
    return negative * -1;
}



static int int16_t_negative_mask(int16_t x)
{
    return (int)(((uint16_t)x ^ 0x8000u) >> 15) - 1;
}
