static uint64_t BitDeinterleave(uint64_t Ai)
{
    // The reference returns its input unchanged.
    // Its if (0) block never executes, so direct return is equivalent.
    // This preserves every uint64_t value, including zero and the maximum.
    return Ai;
}

static uint64_t BitDeinterleave(uint64_t Ai)
{
    // Copy the input without modifying it, matching the inactive reference block.
    // The identical unsigned type preserves every value, including both extremes.
    uint64_t result = Ai;
    return result;
}

static uint64_t BitDeinterleave(uint64_t Ai)
{
    // XOR with zero preserves every bit, matching the reference's identity result.
    // This also holds for zero, all-one bits, and every other input pattern.
    return Ai ^ (uint64_t)0;
}

static uint64_t BitDeinterleave(uint64_t Ai)
{
    // OR with zero leaves every bit unchanged, as does the reference.
    // No input pattern, including zero or all-one bits, is treated specially.
    return Ai | (uint64_t)0;
}

static uint64_t BitDeinterleave(uint64_t Ai)
{
    // AND with a 64-bit all-one mask preserves the reference's unchanged input.
    // Casting the complemented zero produces the full uint64_t mask.
    // Every bit is retained for all inputs, including the boundary values.
    const uint64_t mask = (uint64_t)~(uint64_t)0;
    return Ai & mask;
}

static uint64_t BitDeinterleave(uint64_t Ai)
{
    // Complement each bit twice to recover the reference's unchanged input.
    // The intermediate uint64_t stores exactly the inverted 64-bit pattern.
    // Zero and the maximum value are exchanged temporarily and then restored.
    uint64_t inverted = (uint64_t)~Ai;
    return (uint64_t)~inverted;
}

static uint64_t BitDeinterleave(uint64_t Ai)
{
    // Split into two 32-bit halves and reassemble them in their original positions.
    // This reconstructs the unchanged input returned by the reference.
    // The halves do not overlap, and all shifts are valid for every input.
    uint32_t lo = (uint32_t)Ai;
    uint32_t hi = (uint32_t)(Ai >> 32);
    return ((uint64_t)hi << 32) | (uint64_t)lo;
}

static uint64_t BitDeinterleave(uint64_t Ai)
{
    // Extract eight 8-bit groups and restore each to its original position.
    // Together they reconstruct the identity result of the reference.
    // Shift counts range from 0 to 56, preserving all inputs without overshifting.
    uint64_t result = 0;
    for (unsigned int shift = 0; shift < 64; shift += 8) {
        result |= ((Ai >> shift) & (uint64_t)0xff) << shift;
    }
    return result;
}

static uint64_t BitDeinterleave(uint64_t Ai)
{
    // XOR with the same mask twice cancels, reproducing the reference's input.
    // Each selected bit is toggled twice and every other bit is untouched.
    // This reasoning covers every pattern, including zero and all-one bits.
    const uint64_t mask = (uint64_t)0x5555555555555555ULL;
    uint64_t toggled = Ai ^ mask;
    return toggled ^ mask;
}

static uint64_t BitDeinterleave(uint64_t Ai)
{
    // Exchange the two 32-bit halves twice to restore the original input.
    // Thus the result matches the reference, whose conditional block is inactive.
    // Each shift is by 32 on a 64-bit value and works for all input patterns.
    uint64_t swapped = (Ai << 32) | (Ai >> 32);
    return (swapped << 32) | (swapped >> 32);
}