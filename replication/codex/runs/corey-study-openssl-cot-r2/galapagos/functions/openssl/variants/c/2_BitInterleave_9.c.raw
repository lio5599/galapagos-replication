static uint64_t BitInterleave(uint64_t Ai)
{
    // Reconstruct the input by copying each bit to its original position.
    // All 64 positions are covered, including for zero and all-ones inputs.
    // Every shift count is below 64, so no out-of-range shift occurs.
    uint64_t result = 0;
    for (unsigned int bit = 0; bit < 64; ++bit) {
        result |= Ai & ((uint64_t)1 << bit);
    }
    return result;
}
