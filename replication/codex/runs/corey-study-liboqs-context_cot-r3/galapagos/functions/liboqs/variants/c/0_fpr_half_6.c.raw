static uint64_t fpr_half(uint64_t x) {
    // After subtraction, exponent 2047 identifies exactly the cleared cases.
    // Negating that indicator and complementing gives the required keep mask.
    uint64_t y = x - ((uint64_t)1 << 52);
    uint64_t clear = (uint64_t)(((y >> 52) & 0x7FF) == 0x7FF);
    return y & ~((uint64_t)0 - clear);
}
