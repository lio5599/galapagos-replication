static uint64_t icbrt64(uint64_t x)
{
    // Computes floor(cube_root(x)) multiplied by 4096.
    // Reorders the trial increment without changing its value.
    // Intermediate products fit in uint64_t for every input.
    // The original comparisons and remainder updates preserve all edge cases.
    uint64_t r = 0;
    int s;

    for (s = 63; s >= 0; s -= 3) {
        uint64_t b;
        r <<= 1;
        b = r * (r + 1) * 3 + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            ++r;
        }
    }
    return r << 12;
}
