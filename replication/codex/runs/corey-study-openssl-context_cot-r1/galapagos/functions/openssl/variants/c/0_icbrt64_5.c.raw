static uint64_t icbrt64(uint64_t x)
{
    // Replaces the conditional update with an unsigned all-zero or all-one mask.
    // The comparison produces exactly the reference acceptance bit.
    // Masked subtraction and bit addition reproduce both branches for all inputs.
    // Every shift count is valid, and unsigned left shifts remain defined.
    uint64_t r = 0;
    int s;

    for (s = 63; s >= 0; s -= 3) {
        uint64_t b;
        uint64_t take;
        uint64_t mask;
        r <<= 1;
        b = 3 * r * (r + 1) + 1;
        take = (x >> s) >= b;
        mask = (uint64_t)0 - take;
        x -= (b << s) & mask;
        r += take;
    }
    return r << 12;
}
