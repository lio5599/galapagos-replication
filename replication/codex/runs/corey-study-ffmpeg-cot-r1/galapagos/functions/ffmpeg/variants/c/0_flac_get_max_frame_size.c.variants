static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Computes a maximum FLAC frame size from overhead and rounded payload bytes.
    // A conditional expression selects the original stereo or general formula.
    // Integer division and operation grouping are unchanged, including for zero
    // and negative inputs wherever the reference has defined arithmetic.
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);
    count += (ch == 2)
        ? ((2 * bps + 1) * blocksize + 7) / 8
        : (ch * bps * blocksize + 7) / 8;
    count += 2;
    return count;
}

static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Tests the non-stereo case first, reversing only the branch order.
    // Each selected expression and each addition matches the reference.
    // Zero and negative inputs retain the same truncation and grouping.
    int count;
    count = 16;
    count += ch * ((7 + bps + 7) / 8);
    if (ch != 2) {
        count += (ch * bps * blocksize + 7) / 8;
    } else {
        count += ((2 * bps + 1) * blocksize + 7) / 8;
    }
    count += 2;
    return count;
}

static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Uses a switch to select exactly the original channel-count branch.
    // All arithmetic is unchanged, so division still truncates toward zero.
    // This also preserves zero and negative cases with defined arithmetic.
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);
    switch (ch) {
    case 2:
        count += ((2 * bps + 1) * blocksize + 7) / 8;
        break;
    default:
        count += (ch * bps * blocksize + 7) / 8;
        break;
    }
    count += 2;
    return count;
}

static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Stores the selected payload byte count before adding it.
    // Only the selected branch is evaluated, avoiding extra overflow cases.
    // The original grouping and signed division cover edge cases identically.
    int count = 16;
    int payload;
    count += ch * ((7 + bps + 7) / 8);
    if (ch == 2) {
        payload = ((2 * bps + 1) * blocksize + 7) / 8;
    } else {
        payload = (ch * bps * blocksize + 7) / 8;
    }
    count += payload;
    count += 2;
    return count;
}

static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Returns early for stereo after performing the original additions.
    // The remaining path computes the unchanged non-stereo expression.
    // No reassociation changes overflow boundaries or negative division.
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);
    if (ch == 2) {
        count += ((2 * bps + 1) * blocksize + 7) / 8;
        count += 2;
        return count;
    }
    count += (ch * bps * blocksize + 7) / 8;
    count += 2;
    return count;
}

static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Jumps to a shared trailer step after the stereo payload calculation.
    // Exactly one original payload expression is evaluated.
    // Addition order and signed division remain identical for edge cases.
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);
    if (ch == 2) {
        count += ((2 * bps + 1) * blocksize + 7) / 8;
        goto trailer;
    }
    count += (ch * bps * blocksize + 7) / 8;
trailer:
    count += 2;
    return count;
}

static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Uses a single-pass loop to exit after processing the stereo case.
    // Both paths perform the same arithmetic as their reference branches.
    // Zero and negative values keep the original integer-division behavior.
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);
    do {
        if (ch == 2) {
            count += ((2 * bps + 1) * blocksize + 7) / 8;
            break;
        }
        count += (ch * bps * blocksize + 7) / 8;
    } while (0);
    count += 2;
    return count;
}

static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Stores the payload rate before multiplying by the block size.
    // The rate is exactly the original left operand of that multiplication.
    // Original operation order preserves defined edge cases and truncation.
    int count = 16;
    int rate;
    count += ch * ((7 + bps + 7) / 8);
    if (ch == 2) {
        rate = 2 * bps + 1;
    } else {
        rate = ch * bps;
    }
    count += (rate * blocksize + 7) / 8;
    count += 2;
    return count;
}

static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Splits the overhead and payload expressions into ordered integer steps.
    // Each step follows the original grouping without algebraic reassociation.
    // Thus zero, negative, and other defined inputs retain identical results.
    int count = 16;
    int overhead = 7 + bps;
    int payload;
    overhead += 7;
    overhead /= 8;
    count += ch * overhead;
    if (ch == 2) {
        payload = 2 * bps;
        payload += 1;
    } else {
        payload = ch * bps;
    }
    payload *= blocksize;
    payload += 7;
    payload /= 8;
    count += payload;
    count += 2;
    return count;
}

static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Expresses the calculation as one explicitly grouped return expression.
    // The conditional evaluates only the applicable original payload formula.
    // Grouping preserves addition order and signed truncation for edge cases
    // wherever the reference arithmetic is defined.
    return ((16 + ch * ((7 + bps + 7) / 8))
            + ((ch == 2)
                ? ((2 * bps + 1) * blocksize + 7) / 8
                : (ch * bps * blocksize + 7) / 8))
           + 2;
}