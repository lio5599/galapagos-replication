static int mix(int c0, int c1)
{
    // Splits each nonnegative input component into quotient and remainder modulo 3.
    // The remainder contribution supplies exactly the missing quotient carry.
    // This includes component endpoints 0 and 31; signed red is unchanged.
    int b0 = c0 & 31;
    int b1 = c1 & 31;
    int g0 = (c0 & 0x03E0) >> 5;
    int g1 = (c1 & 0x03E0) >> 5;
    int blue = 2 * (b0 / 3) + b1 / 3 + (2 * (b0 % 3) + b1 % 3) / 3;
    int green = 2 * (g0 / 3) + g1 / 3 + (2 * (g0 % 3) + g1 % 3) / 3;
    int red = (2 * (c0 >> 10) + (c1 >> 10)) / 3;
    return red * 1024 + green * 32 + blue;
}
