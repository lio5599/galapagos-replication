static int mix(int c0, int c1)
{
    // Greedily subtracts 3 times descending powers of two to form each quotient.
    // Blue and green sums are at most 93, so quotient bits 16 through 1 suffice.
    // Remainders below 3 are discarded, including at both range endpoints.
    // Signed red retains the original operations.
    int blue = 2 * (c0 & 31) + (c1 & 31);
    int green = (2 * (c0 & 0x03E0) + (c1 & 0x03E0)) >> 5;
    int red = 2 * (c0 >> 10) + (c1 >> 10);
    int b = 0;
    int g = 0;
    int bit;
    for (bit = 16; bit != 0; bit >>= 1) {
        int threshold = 3 * bit;
        if (blue >= threshold) {
            blue -= threshold;
            b += bit;
        }
        if (green >= threshold) {
            green -= threshold;
            g += bit;
        }
    }
    return (red / 3) * 1024 + g * 32 + b;
}
