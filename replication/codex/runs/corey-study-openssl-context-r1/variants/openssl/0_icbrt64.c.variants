
#include <stdint.h>

static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    for (int s = 63; s >= 0; s -= 3) {
        r += r;
        uint64_t b = 3 * r * (r + 1) + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            ++r;
        }
    }
    return r << 12;
}



#include <stdint.h>

static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    int s = 63;
    while (s >= 0) {
        r <<= 1;
        uint64_t b = 3 * r * r + 3 * r + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            r += 1;
        }
        s -= 3;
    }
    return r << 12;
}



#include <stdint.h>

static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    int s = 63;
    do {
        r <<= 1;
        uint64_t b = 3 * r * (r + 1) + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            ++r;
        }
        s -= 3;
    } while (s >= 0);
    return r << 12;
}



#include <stdint.h>

static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    for (unsigned int i = 0; i < 22; ++i) {
        unsigned int s = 63 - 3 * i;
        r <<= 1;
        uint64_t b = 3 * r * (r + 1) + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            ++r;
        }
    }
    return r << 12;
}



#include <stdint.h>

static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    for (int s = 63; s >= 0; s -= 3) {
        r <<= 1;
        uint64_t t = r * (r + 1);
        uint64_t b = t + t + t + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            ++r;
        }
    }
    return r << 12;
}



#include <stdint.h>

static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    for (int s = 63; s >= 0; s -= 3) {
        r <<= 1;
        uint64_t b = 3 * r * (r + 1) + 1;
        uint64_t take = (uint64_t)((x >> s) >= b);
        uint64_t mask = (uint64_t)0 - take;
        x -= (b << s) & mask;
        r += take;
    }
    return r << 12;
}



#include <stdint.h>

static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    for (int s = 63; s >= 0; s -= 3) {
        uint64_t doubled = r << 1;
        uint64_t b = 3 * doubled * (doubled + 1) + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            r = doubled + 1;
        } else {
            r = doubled;
        }
    }
    return r << 12;
}



#include <stdint.h>

static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    for (int s = 63; s >= 0; s -= 3) {
        r <<= 1;
        uint64_t b = 3 * r * (r + 1) + 1;
        if ((x >> s) < b)
            continue;
        x -= b << s;
        ++r;
    }
    return r << 12;
}



#include <stdint.h>

static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    for (int s = 63; s >= 0; s -= 3) {
        uint64_t candidate = (r << 1) + 1;
        uint64_t b = 3 * candidate * (candidate - 1) + 1;
        r = candidate - 1;
        if ((x >> s) >= b) {
            x -= b << s;
            r = candidate;
        }
    }
    return r << 12;
}



#include <stdint.h>

static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    unsigned int s = 63;
    for (;;) {
        r <<= 1;
        uint64_t b = 3 * r * (r + 1) + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            ++r;
        }
        if (s == 0)
            break;
        s -= 3;
    }
    return r << 12;
}
