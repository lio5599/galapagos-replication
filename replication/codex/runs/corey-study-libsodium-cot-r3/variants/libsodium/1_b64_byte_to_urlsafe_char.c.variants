static int b64_byte_to_urlsafe_char(unsigned int x)
{
    // Maps 0..63 to URL-safe Base64 characters; other inputs follow byte-mask arithmetic.
    // Naming the reference masks preserves its exact unsigned arithmetic.
    // Partial masks for inputs outside 0..63 are retained, including wraparound.
    unsigned int a = ((x - 26U) >> 8) & 0xFFU;
    unsigned int b = ((x - 52U) >> 8) & 0xFFU;
    unsigned int c = ((x - 62U) >> 8) & 0xFFU;
    unsigned int d = (((0U - (x ^ 62U)) >> 8) & 0xFFU) ^ 0xFFU;
    unsigned int e = (((0U - (x ^ 63U)) >> 8) & 0xFFU) ^ 0xFFU;

    return (int)((a & (x + 'A')) |
                 ((a ^ 0xFFU) & b & (x + ('a' - 26))) |
                 ((b ^ 0xFFU) & c & (x + ('0' - 52))) |
                 (d & '-') | (e & '_'));
}

static int b64_byte_to_urlsafe_char(unsigned int x)
{
    // Delay all byte truncation until the final result.
    // Bitwise operations act independently on each bit, so higher bits cannot interfere.
    // Complements match XOR with 255 in the retained byte, for every unsigned input.
    unsigned int a = (x - 26U) >> 8;
    unsigned int b = (x - 52U) >> 8;
    unsigned int c = (x - 62U) >> 8;
    unsigned int d = (0U - (x ^ 62U)) >> 8;
    unsigned int e = (0U - (x ^ 63U)) >> 8;
    unsigned int result = (a & (x + 'A')) |
                          (~a & b & (x + ('a' - 26))) |
                          (~b & c & (x + ('0' - 52))) |
                          (~d & '-') | (~e & '_');

    return (int)(result & 0xFFU);
}

static int b64_byte_to_urlsafe_char(unsigned int x)
{
    // Accumulate the five masked contributions separately.
    // OR is associative, so this preserves the reference even when masks overlap.
    // All mask calculations retain unsigned wraparound for out-of-range inputs.
    unsigned int a = ((x - 26U) >> 8) & 255U;
    unsigned int b = ((x - 52U) >> 8) & 255U;
    unsigned int c = ((x - 62U) >> 8) & 255U;
    unsigned int result = a & (x + 'A');

    result |= (255U ^ a) & b & (x + ('a' - 26));
    result |= (255U ^ b) & c & (x + ('0' - 52));
    result |= (255U ^ (((0U - (x ^ 62U)) >> 8) & 255U)) & '-';
    result |= (255U ^ (((0U - (x ^ 63U)) >> 8) & 255U)) & '_';
    return (int)result;
}

static int b64_byte_to_urlsafe_char(unsigned int x)
{
    // Reconstruct the result one bit at a time from the reference predicates.
    // Each condition tests the corresponding bit of a masked contribution.
    // This handles partial masks and overlapping contributions outside 0..63 exactly.
    unsigned int a = (x - 26U) >> 8;
    unsigned int b = (x - 52U) >> 8;
    unsigned int c = (x - 62U) >> 8;
    unsigned int d = (0U - (x ^ 62U)) >> 8;
    unsigned int e = (0U - (x ^ 63U)) >> 8;
    unsigned int result = 0U;
    unsigned int bit;

    for (bit = 1U; bit < 256U; bit <<= 1) {
        if (((a & bit) && ((x + 'A') & bit)) ||
            ((~a & bit) && (b & bit) && ((x + ('a' - 26)) & bit)) ||
            ((~b & bit) && (c & bit) && ((x + ('0' - 52)) & bit)) ||
            ((~d & bit) && ('-' & bit)) ||
            ((~e & bit) && ('_' & bit))) {
            result |= bit;
        }
    }
    return (int)result;
}

static int b64_byte_to_urlsafe_char(unsigned int x)
{
    // Store the five masks and candidate values in parallel arrays.
    // OR-reducing their intersections is exactly the reference expression.
    // No range assumption is made, so unsigned wraparound and partial masks remain.
    unsigned int a = ((x - 26U) >> 8) & 255U;
    unsigned int b = ((x - 52U) >> 8) & 255U;
    unsigned int masks[5] = {
        a,
        (255U ^ a) & b,
        (255U ^ b) & (((x - 62U) >> 8) & 255U),
        255U ^ (((0U - (x ^ 62U)) >> 8) & 255U),
        255U ^ (((0U - (x ^ 63U)) >> 8) & 255U)
    };
    unsigned int values[5] = {
        x + 'A', x + ('a' - 26), x + ('0' - 52), '-', '_'
    };
    unsigned int result = 0U;
    unsigned int i;

    for (i = 0U; i < 5U; ++i) {
        result |= masks[i] & values[i];
    }
    return (int)result;
}

static int b64_byte_to_urlsafe_char(unsigned int x)
{
    // Apply De Morgan's law to combine the five reference contributions.
    // Complementing their complemented intersection gives their bitwise OR.
    // Final byte truncation preserves the exact result for all unsigned inputs.
    unsigned int a = (x - 26U) >> 8;
    unsigned int b = (x - 52U) >> 8;
    unsigned int c = (x - 62U) >> 8;
    unsigned int d = (0U - (x ^ 62U)) >> 8;
    unsigned int e = (0U - (x ^ 63U)) >> 8;
    unsigned int inverted = ~(a & (x + 'A'));

    inverted &= ~(~a & b & (x + ('a' - 26)));
    inverted &= ~(~b & c & (x + ('0' - 52)));
    inverted &= ~(~d & '-');
    inverted &= ~(~e & '_');
    return (int)((~inverted) & 255U);
}

static int b64_byte_to_urlsafe_char(unsigned int x)
{
    // Combine byte-sized contributions using the identity OR equals sum minus AND.
    // Each intermediate result remains a byte, so the sums cannot overflow.
    // Overlapping and partial masks are preserved, including for out-of-range inputs.
    unsigned int a = ((x - 26U) >> 8) & 255U;
    unsigned int b = ((x - 52U) >> 8) & 255U;
    unsigned int result = a & (x + 'A');
    unsigned int term = (255U ^ a) & b & (x + ('a' - 26));

    result = result + term - (result & term);
    term = (255U ^ b) & (((x - 62U) >> 8) & 255U) & (x + ('0' - 52));
    result = result + term - (result & term);
    term = (255U ^ (((0U - (x ^ 62U)) >> 8) & 255U)) & '-';
    result = result + term - (result & term);
    term = (255U ^ (((0U - (x ^ 63U)) >> 8) & 255U)) & '_';
    result = result + term - (result & term);
    return (int)result;
}

static int b64_byte_to_urlsafe_char(unsigned int x)
{
    // Factor the first two terms using a bitwise selection identity.
    // Selecting between the first value and the second masked value matches their OR.
    // The remaining terms stay unchanged, preserving partial masks for every input.
    unsigned int a = ((x - 26U) >> 8) & 255U;
    unsigned int b = ((x - 52U) >> 8) & 255U;
    unsigned int first = (x + 'A') & 255U;
    unsigned int second = b & (x + ('a' - 26));
    unsigned int result = second ^ ((first ^ second) & a);

    result |= (255U ^ b) & (((x - 62U) >> 8) & 255U) & (x + ('0' - 52));
    result |= (255U ^ (((0U - (x ^ 62U)) >> 8) & 255U)) & '-';
    result |= (255U ^ (((0U - (x ^ 63U)) >> 8) & 255U)) & '_';
    return (int)result;
}

static int b64_byte_to_urlsafe_char(unsigned int x)
{
    // Only the low sixteen input bits can affect the reference's extracted masks.
    // Candidate values contribute only their low eight bits.
    // Reducing x modulo 65536 therefore preserves every result, including wraparound.
    unsigned int y = x & 65535U;
    unsigned int a = ((y - 26U) >> 8) & 255U;
    unsigned int b = ((y - 52U) >> 8) & 255U;
    unsigned int c = ((y - 62U) >> 8) & 255U;
    unsigned int d = (((0U - (y ^ 62U)) >> 8) & 255U) ^ 255U;
    unsigned int e = (((0U - (y ^ 63U)) >> 8) & 255U) ^ 255U;

    return (int)((a & (y + 'A')) |
                 ((255U ^ a) & b & (y + ('a' - 26))) |
                 ((255U ^ b) & c & (y + ('0' - 52))) |
                 (d & '-') | (e & '_'));
}

static int b64_byte_to_urlsafe_char(unsigned int x)
{
    // Extract mask bytes using unsigned division and remainder instead of shifts.
    // Division by 256 matches shifting by eight, and remainder by 256 keeps a byte.
    // Subtraction remains unsigned, preserving all edge cases and out-of-range results.
    unsigned int a = ((x - 26U) / 256U) % 256U;
    unsigned int b = ((x - 52U) / 256U) % 256U;
    unsigned int c = ((x - 62U) / 256U) % 256U;
    unsigned int d = 255U - (((0U - (x ^ 62U)) / 256U) % 256U);
    unsigned int e = 255U - (((0U - (x ^ 63U)) / 256U) % 256U);

    return (int)((a & (x + 'A')) |
                 ((255U - a) & b & (x + ('a' - 26))) |
                 ((255U - b) & c & (x + ('0' - 52))) |
                 (d & '-') | (e & '_'));
}