static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;

    for (unsigned int i = 22; i != 0; --i) {
        unsigned int s = 3 * (i - 1);
        r += r;
        uint64_t b = 3 * r * (r + 1) + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            ++r;
        }
    }

    return r << 12;
}
