
#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    return d + ((UINT32_C(0) - (d >> 31)) & p);
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    if (d >> 31) {
        d += p;
    }
    return d;
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    return d + p * (d >> 31);
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    uint32_t mask = UINT32_C(0) - (d >> 31);
    uint32_t corrected = d + p;
    return (d & ~mask) | (corrected & mask);
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    uint32_t corrected = d + p;
    uint32_t mask = UINT32_C(0) - (d >> 31);
    return d ^ ((d ^ corrected) & mask);
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    uint32_t mask = UINT32_C(0) - (d >> 31);
    uint32_t negative_p = UINT32_C(0) - p;
    return d - (negative_p & mask);
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint32_t low = (uint32_t)(z * p0i);
    uint64_t w = (uint64_t)(low & UINT32_C(0x7FFFFFFF)) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    d += p & (UINT32_C(0) - (d >> 31));
    return d;
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t low = z & UINT64_C(0x7FFFFFFF);
    uint64_t factor = (low * p0i) & UINT64_C(0x7FFFFFFF);
    uint32_t d = (uint32_t)((z + factor * p) >> 31) - p;
    return d + (p & (UINT32_C(0) - (d >> 31)));
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t factor = (z * p0i) % UINT64_C(0x80000000);
    uint64_t sum = z + factor * p;
    uint32_t d = (uint32_t)(sum / UINT64_C(0x80000000)) - p;
    return d + (p & (UINT32_C(0) - (d >> 31)));
}



#include <stdint.h>

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t lo = (uint64_t)a * (b & UINT32_C(0xFFFF));
    uint64_t hi = (uint64_t)a * (b >> 16);
    uint64_t z = lo + (hi << 16);
    uint64_t w = ((z * p0i) & UINT64_C(0x7FFFFFFF)) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    return d + (p & (UINT32_C(0) - (d >> 31)));
}
