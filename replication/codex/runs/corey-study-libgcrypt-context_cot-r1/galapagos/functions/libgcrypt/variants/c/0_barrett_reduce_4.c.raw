int16_t barrett_reduce(int16_t a) {
  // Splits the reciprocal into 16384 + 3775 and adds the bias first.
  // Every intermediate fits int32_t throughout the int16_t input range.
  // The final numerator and both narrowing steps equal the reference.
  int32_t numerator = 33554432 + (int32_t)a * 16384;
  numerator += (int32_t)a * 3775;
  int16_t t = numerator >> 26;
  t *= 3329;
  return a - t;
}
