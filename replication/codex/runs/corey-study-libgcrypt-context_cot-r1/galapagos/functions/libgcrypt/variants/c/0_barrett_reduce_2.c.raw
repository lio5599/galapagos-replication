int16_t barrett_reduce(int16_t a) {
  // Uses 20159 = 20160 - 1 to calculate the same numerator.
  // Multiplication and subtraction fit int32_t even at both input extremes.
  // The shift and subsequent narrowing match the reference.
  int32_t numerator = (int32_t)a * 20160;
  numerator -= a;
  numerator += 33554432;
  int16_t t = numerator >> 26;
  t *= 3329;
  return a - t;
}
