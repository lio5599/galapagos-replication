static int alaw_to_s16(unsigned char a_val)
{
    int x = a_val ^ 0x55;
    int code = x & 127;
    int t;

    if (code < 16)
        t = code * 16 + 8;
    else if (code < 32)
        t = (code - 16) * 16 + 264;
    else if (code < 64)
        t = (((code & 15) * 16) + 264) << ((code >> 4) - 1);
    else
        t = (((code & 15) * 16) + 264) << ((code >> 4) - 1);

    return (x & 128) ? t : -t;
}
