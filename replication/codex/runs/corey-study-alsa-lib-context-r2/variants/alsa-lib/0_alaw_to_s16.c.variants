
static int alaw_to_s16(unsigned char a_val)
{
    int x = a_val ^ 0x55;
    int seg = (x >> 4) & 7;
    int t = ((x & 15) << 4) + 8;

    if (seg != 0)
        t = (t + 256) << (seg - 1);

    return (x & 128) ? t : -t;
}



static int alaw_to_s16(unsigned char a_val)
{
    int x = a_val ^ 0x55;
    int seg = (x >> 4) & 7;
    int t;

    if (seg == 0)
        t = (x & 15) * 16 + 8;
    else
        t = ((x & 15) * 16 + 264) * (1 << (seg - 1));

    return (x & 128) ? t : -t;
}



static int alaw_to_s16(unsigned char a_val)
{
    int x = a_val ^ 0x55;
    int n = x & 15;
    int t;

    switch ((x >> 4) & 7) {
    case 0: t = n * 16 + 8; break;
    case 1: t = n * 16 + 264; break;
    case 2: t = n * 32 + 528; break;
    case 3: t = n * 64 + 1056; break;
    case 4: t = n * 128 + 2112; break;
    case 5: t = n * 256 + 4224; break;
    case 6: t = n * 512 + 8448; break;
    default: t = n * 1024 + 16896; break;
    }

    return (x & 128) ? t : -t;
}



static int alaw_to_s16(unsigned char a_val)
{
    int x = a_val ^ 0x55;
    int seg = (x >> 4) & 7;
    int nonzero = seg != 0;
    int shift = seg - nonzero;
    int t = ((x & 15) * 16 + 8 + nonzero * 256) << shift;

    return t * (((x >> 7) & 1) * 2 - 1);
}



static int alaw_to_s16(unsigned char a_val)
{
    int n = (a_val & 15) ^ 5;
    int seg = ((a_val >> 4) & 7) ^ 5;
    int t = n * 16 + 8;

    if (seg > 0)
        t = (t + 256) << (seg - 1);

    return (a_val & 128) ? t : -t;
}



static int alaw_to_s16(unsigned char a_val)
{
    int x = a_val ^ 0x55;
    int seg = (x >> 4) & 7;
    int t;

    if (seg == 0)
        t = ((x & 15) * 2 + 1) * 8;
    else
        t = ((x & 15) * 2 + 33) << (seg + 2);

    if ((x & 128) == 0)
        return -t;
    return t;
}



static int alaw_to_s16(unsigned char a_val)
{
    int x = a_val ^ 0x55;
    int code = x & 127;
    int t;

    if (code < 16)
        t = code * 16 + 8;
    else if (code < 32)
        t = (code - 16) * 16 + 264;
    else if (code < 64)
        t = (((code & 15) * 16) + 264) << ((code >> 4) - 1);
    else
        t = (((code & 15) * 16) + 264) << ((code >> 4) - 1);

    return (x & 128) ? t : -t;
}



static int alaw_to_s16(unsigned char a_val)
{
    int x = a_val ^ 0x55;
    int seg = (x >> 4) & 7;
    int t = ((x & 15) << 4) + 8;

    if (seg > 0)
        t += 256;
    if (seg > 1)
        t *= 2;
    if (seg > 2)
        t *= 2;
    if (seg > 3)
        t *= 2;
    if (seg > 4)
        t *= 2;
    if (seg > 5)
        t *= 2;
    if (seg > 6)
        t *= 2;

    return (x & 128) ? t : -t;
}



static int alaw_to_s16(unsigned char a_val)
{
    int x = a_val ^ 0x55;
    int seg = (x >> 4) & 7;
    int shift = seg > 0 ? seg - 1 : 0;
    int t = ((x & 15) * 16 + (seg > 0 ? 264 : 8)) << shift;
    int negative = (x & 128) == 0;

    return t - 2 * negative * t;
}



static int alaw_to_s16(unsigned char a_val)
{
    int x = a_val ^ 0x55;
    int seg = (x >> 4) & 7;
    int t;

    if (seg == 0) {
        t = ((x & 15) << 4) + 8;
    } else {
        int scale = 1 << (seg - 1);
        t = (x & 15) * (scale << 4) + (scale << 8) + (scale << 3);
    }

    return (a_val < 128) ? -t : t;
}
