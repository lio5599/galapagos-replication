static int alaw_to_s16(unsigned char a_val)
{
	// Decodes an A-law byte into a signed 16-bit PCM sample returned as int.
	// Segment zero uses the unscaled midpoint; other segments add the bias.
	// The largest magnitude is 32256, and the sign bit selects polarity.
	int x = a_val ^ 0x55;
	int seg = (x >> 4) & 7;
	int mant = x & 15;
	int t;

	if (seg == 0)
		t = (mant << 4) + 8;
	else
		t = ((mant << 4) + 264) << (seg - 1);

	return (x & 128) ? t : -t;
}

static int alaw_to_s16(unsigned char a_val)
{
	// Select the segment-dependent bias and a nonnegative shift count.
	// Segment zero has bias 8 and shift zero, avoiding a negative shift.
	// All other segments reproduce the reference bias and scaling.
	int x = a_val ^ 0x55;
	int seg = (x >> 4) & 7;
	int bias = seg ? 264 : 8;
	int shift = seg ? seg - 1 : 0;
	int t = ((x & 15) * 16 + bias) << shift;

	return (x & 128) ? t : -t;
}

static int alaw_to_s16(unsigned char a_val)
{
	// Replace magnitude shifting with multiplication by a power of two.
	// Segment zero is handled separately, so every shift count is valid.
	// Products remain between 8 and 32256, matching all reference magnitudes.
	int x = a_val ^ 0x55;
	int seg = (x >> 4) & 7;
	int t = (x & 15) * 16 + 8;

	if (seg != 0)
		t = (t + 256) * (1 << (seg - 1));

	if (x & 128)
		return t;
	return -t;
}

static int alaw_to_s16(unsigned char a_val)
{
	// Enumerate the eight possible segment scales explicitly.
	// Segment zero removes the extra 256 bias; segments one through seven
	// multiply the biased mantissa by exactly the reference power of two.
	int x = a_val ^ 0x55;
	int t = (x & 15) * 16 + 264;

	switch ((x >> 4) & 7) {
	case 0: t -= 256; break;
	case 1: break;
	case 2: t *= 2; break;
	case 3: t *= 4; break;
	case 4: t *= 8; break;
	case 5: t *= 16; break;
	case 6: t *= 32; break;
	case 7: t *= 64; break;
	}

	return (x & 128) ? t : -t;
}

static int alaw_to_s16(unsigned char a_val)
{
	// Classify the seven-bit magnitude code by its segment boundaries.
	// Each interval uses the corresponding reference bias and fixed shift.
	// The first and last intervals include the minimum and maximum codes.
	int x = a_val ^ 0x55;
	int code = x & 127;
	int base = (code & 15) * 16 + 264;
	int t;

	if (code < 16)
		t = code * 16 + 8;
	else if (code < 32)
		t = base;
	else if (code < 48)
		t = base << 1;
	else if (code < 64)
		t = base << 2;
	else if (code < 80)
		t = base << 3;
	else if (code < 96)
		t = base << 4;
	else if (code < 112)
		t = base << 5;
	else
		t = base << 6;

	return (x & 128) ? t : -t;
}

static int alaw_to_s16(unsigned char a_val)
{
	// Decompose the required shift into contributions of one, two, and four.
	// Segment zero retains its own bias and uses no scaling.
	// Shift counts range from zero to six, and intermediate values stay bounded.
	int x = a_val ^ 0x55;
	int seg = (x >> 4) & 7;
	int shift = 0;
	int t = (x & 15) * 16 + 8;

	if (seg != 0) {
		t += 256;
		shift = seg - 1;
	}
	if (shift & 1)
		t <<= 1;
	if (shift & 2)
		t <<= 2;
	if (shift & 4)
		t <<= 4;

	return (x & 128) ? t : -t;
}

static int alaw_to_s16(unsigned char a_val)
{
	// Each crossed boundary above segment one contributes one doubling.
	// Codes below 16 use the small-segment bias and cross no boundaries.
	// Segment seven crosses six boundaries, yielding the maximum scale of 64.
	int x = a_val ^ 0x55;
	int code = x & 127;
	int t = (code & 15) * 16 + 8;

	if (code >= 16)
		t += 256;
	if (code >= 32)
		t += t;
	if (code >= 48)
		t += t;
	if (code >= 64)
		t += t;
	if (code >= 80)
		t += t;
	if (code >= 96)
		t += t;
	if (code >= 112)
		t += t;

	return (x & 128) ? t : -t;
}

static int alaw_to_s16(unsigned char a_val)
{
	// Factor eight out of the biased mantissa for nonzero segments.
	// Thus 16 times mantissa plus 264 becomes eight times twice mantissa plus 33.
	// Segment zero remains separate; the largest shift is nine and is safe.
	int x = a_val ^ 0x55;
	int seg = (x >> 4) & 7;
	int mant = x & 15;
	int t;

	if (seg)
		t = (2 * mant + 33) << (seg + 2);
	else
		t = (2 * mant + 1) << 3;

	return (x & 128) ? t : -t;
}

static int alaw_to_s16(unsigned char a_val)
{
	// Form the small-segment midpoint directly from the low nibble.
	// Nonzero segments add 256 before scaling, giving the reference bias 264.
	// Apply the sign by multiplying by exactly positive or negative one.
	int x = a_val ^ 0x55;
	int seg = (x >> 4) & 7;
	int t = ((x & 15) << 4) | 8;
	int sign = 2 * ((x >> 7) & 1) - 1;

	if (seg)
		t = (t + 256) << (seg - 1);

	return t * sign;
}

static int alaw_to_s16(unsigned char a_val)
{
	// Decode fields directly from the original byte using the XOR pattern.
	// XOR 0x55 toggles segment bits by 5 and mantissa bits by 5, not the sign.
	// Segment zero uses its special midpoint; all other scales match exactly.
	int seg = ((a_val >> 4) & 7) ^ 5;
	int mant = (a_val & 15) ^ 5;
	int t;

	if (seg == 0)
		t = mant * 16 + 8;
	else
		t = (mant * 16 + 264) << (seg - 1);

	return (a_val & 0x80) ? t : -t;
}