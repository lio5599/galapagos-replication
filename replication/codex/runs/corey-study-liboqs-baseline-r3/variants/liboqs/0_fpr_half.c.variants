
static uint64_t fpr_half(uint64_t x) {
    if (((x >> 52) & 0x7FF) == 0) {
        return 0;
    }
    return x - ((uint64_t)1 << 52);
}



static uint64_t fpr_half(uint64_t x) {
    return ((x >> 52) & 0x7FF)
        ? x - ((uint64_t)1 << 52)
        : 0;
}



static uint64_t fpr_half(uint64_t x) {
    uint64_t mask = (uint64_t)0 - (uint64_t)(((x >> 52) & 0x7FF) != 0);
    return (x - ((uint64_t)1 << 52)) & mask;
}



static uint64_t fpr_half(uint64_t x) {
    uint64_t nonzero = (uint64_t)(((x >> 52) & 0x7FF) != 0);
    return (x - ((uint64_t)1 << 52)) * nonzero;
}



static uint64_t fpr_half(uint64_t x) {
    uint64_t y = x - ((uint64_t)1 << 52);
    if (((y >> 52) & 0x7FF) == 0x7FF) {
        y = 0;
    }
    return y;
}



static uint64_t fpr_half(uint64_t x) {
    uint64_t y = x - ((uint64_t)1 << 52);
    uint64_t mask = (uint64_t)(((y >> 52) & 0x7FF) == 0x7FF) - 1;
    return y & mask;
}



static uint64_t fpr_half(uint64_t x) {
    uint64_t e = (x >> 52) & 0x7FF;
    uint64_t nonzero = (e | ((uint64_t)0 - e)) >> 63;
    return (x - ((uint64_t)1 << 52)) & ((uint64_t)0 - nonzero);
}



static uint64_t fpr_half(uint64_t x) {
    uint64_t e = (x >> 52) & 0x7FF;
    uint64_t is_zero = (e - 1) >> 63;
    return (x - ((uint64_t)1 << 52)) & (is_zero - 1);
}



static uint64_t fpr_half(uint64_t x) {
    uint64_t e = (x >> 52) & 0x7FF;
    uint64_t nonzero = (e + 0x7FF) >> 11;
    return (x - ((uint64_t)1 << 52)) & ((uint64_t)0 - nonzero);
}



static uint64_t fpr_half(uint64_t x) {
    switch ((x >> 52) & 0x7FF) {
        case 0:
            return 0;
        default:
            return x - ((uint64_t)1 << 52);
    }
}
