uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t low = z & UINT64_C(0x7FFFFFFF);
    uint64_t inverse = (uint64_t)p0i & UINT64_C(0x7FFFFFFF);
    uint64_t m = (low * inverse) & UINT64_C(0x7FFFFFFF);
    uint32_t d = (uint32_t)((z + m * p) >> 31) - p;
    return d + (p & (uint32_t)(0 - (d >> 31)));
}
