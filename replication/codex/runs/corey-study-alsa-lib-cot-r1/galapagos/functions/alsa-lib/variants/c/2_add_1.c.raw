static inline unsigned int add(unsigned int a, unsigned int b)
{
	// Split the saturation test into equality and strict inequality.
	// Together these cover exactly the original greater-than-or-equal test.
	// Equality returns the limit; all remaining cases return the sum.
	if (a == 4294967295 - b)
		return 4294967295;
	if (a > 4294967295 - b)
		return 4294967295;
	return a + b;
}
