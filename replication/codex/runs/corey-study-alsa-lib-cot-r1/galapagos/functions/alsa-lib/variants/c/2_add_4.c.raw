static inline unsigned int add(unsigned int a, unsigned int b)
{
	// Dispatch on the original comparison, whose value is either zero or one.
	// A false comparison returns the sum; a true comparison returns the limit.
	// Using the same comparison preserves all boundary cases.
	switch (a >= 4294967295 - b) {
	case 0:
		return a + b;
	default:
		return 4294967295;
	}
}
