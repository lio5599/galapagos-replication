static inline unsigned int add(unsigned int a, unsigned int b)
{
	// Use an unsigned mask and XOR to select between the sum and the limit.
	// A zero mask leaves the sum; an all-one mask changes it to the limit.
	// The original comparison controls selection, including equality and zero.
	unsigned int sum = a + b;
	unsigned int limit = 4294967295;
	unsigned int mask = 0u - (unsigned int)(a >= 4294967295 - b);
	return sum ^ ((sum ^ limit) & mask);
}
