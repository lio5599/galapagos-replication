static inline unsigned int add(unsigned int a, unsigned int b)
{
	// Use XOR selection with a mask derived from the original condition.
	// A zero mask preserves the sum; an all-one mask changes it to cap.
	// Equality selects cap, including when the provisional sum wraps.
	unsigned int sum = a + b;
	unsigned int cap = 4294967295;
	unsigned int mask = 0u - (unsigned int)(a >= 4294967295 - b);
	return sum ^ ((sum ^ cap) & mask);
}
