static inline unsigned int add(unsigned int a, unsigned int b)
{
	// Split the reference's inclusive comparison into two cases.
	// Both strict excess and exact equality return the cap.
	// Only inputs below the threshold reach the addition.
	if (a > 4294967295 - b)
		return 4294967295;
	if (a == 4294967295 - b)
		return 4294967295;
	return a + b;
}
