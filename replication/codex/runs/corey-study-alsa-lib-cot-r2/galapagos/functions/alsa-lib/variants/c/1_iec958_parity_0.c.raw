static unsigned int iec958_parity(unsigned int data)
{
	// The reference returns the parity of original bits 4 through 30.
	// After discarding bits 0 through 3, XOR exactly 27 low bits.
	// Higher bits are never examined; zero input yields zero.
	unsigned int parity = 0;
	int bit;

	data >>= 4;
	for (bit = 0; bit < 27; bit++) {
		parity ^= data & 1U;
		data >>= 1;
	}
	return parity;
}
