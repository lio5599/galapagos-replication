static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    int i;

    for (i = 21; i >= 0; --i) {
        uint64_t candidate = r + ((uint64_t)1 << i);

        if (candidate <= 2642245 &&
            candidate * candidate * candidate <= x)
            r = candidate;
    }

    return r << 12;
}
