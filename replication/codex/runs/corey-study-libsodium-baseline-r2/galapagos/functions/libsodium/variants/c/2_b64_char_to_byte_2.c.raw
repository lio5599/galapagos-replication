static unsigned int b64_char_to_byte(int c)
{
    const unsigned int u = (unsigned int)c;
    unsigned int a = ((u - 'A') >> 8) | (('Z' - u) >> 8);
    unsigned int b = ((u - 'a') >> 8) | (('z' - u) >> 8);
    unsigned int d = ((u - '0') >> 8) | (('9' - u) >> 8);
    unsigned int p = (0U - (u ^ '+')) >> 8;
    unsigned int s = (0U - (u ^ '/')) >> 8;
    unsigned int x = (~a & (u - 'A'))
                   | (~b & (u - ('a' - 26)))
                   | (~d & (u - ('0' - 52)))
                   | (~p & 62U)
                   | (~s & 63U);

    x &= 255U;
    if (x == 0U)
        x = ((0U - (u ^ 'A')) >> 8) & 255U;
    return x;
}
