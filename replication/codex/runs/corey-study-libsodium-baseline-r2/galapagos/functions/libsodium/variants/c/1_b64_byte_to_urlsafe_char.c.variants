
static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int a = ((x - 26U) >> 8) & 0xFFU;
    unsigned int b = ((x - 52U) >> 8) & 0xFFU;
    unsigned int c = ((x - 62U) >> 8) & 0xFFU;
    unsigned int d = (~((0U - (x ^ 62U)) >> 8)) & 0xFFU;
    unsigned int e = (~((0U - (x ^ 63U)) >> 8)) & 0xFFU;

    return (int)((a & (x + 'A')) |
                 ((a ^ 0xFFU) & b & (x + ('a' - 26))) |
                 ((b ^ 0xFFU) & c & (x + ('0' - 52))) |
                 (d & '-') | (e & '_'));
}



static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int a = (x - 26U) >> 8;
    unsigned int b = (x - 52U) >> 8;
    unsigned int c = (x - 62U) >> 8;
    unsigned int d = (0U - (x ^ 62U)) >> 8;
    unsigned int e = (0U - (x ^ 63U)) >> 8;
    unsigned int result = a & (x + 'A');

    result |= ~a & b & (x + ('a' - 26));
    result |= ~b & c & (x + ('0' - 52));
    result |= ~d & '-';
    result |= ~e & '_';

    return (int)(result & 0xFFU);
}



static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int masks[5];
    unsigned int values[5];
    unsigned int result = 0U;
    unsigned int i;

    masks[0] = (x - 26U) >> 8;
    masks[1] = ~masks[0] & ((x - 52U) >> 8);
    masks[2] = ~((x - 52U) >> 8) & ((x - 62U) >> 8);
    masks[3] = ~((0U - (x ^ 62U)) >> 8);
    masks[4] = ~((0U - (x ^ 63U)) >> 8);

    values[0] = x + 'A';
    values[1] = x + ('a' - 26);
    values[2] = x + ('0' - 52);
    values[3] = '-';
    values[4] = '_';

    for (i = 0U; i < 5U; ++i)
        result |= masks[i] & values[i];

    return (int)(result & 0xFFU);
}



static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int a = (x - 26U) >> 8;
    unsigned int b = (x - 52U) >> 8;
    unsigned int c = (x - 62U) >> 8;
    unsigned int d = (0U - (x ^ 62U)) >> 8;
    unsigned int e = (0U - (x ^ 63U)) >> 8;

    unsigned int result =
        (~a | ~(x + 'A')) &
        (a | ~b | ~(x + ('a' - 26))) &
        (b | ~c | ~(x + ('0' - 52))) &
        (d | ~(unsigned int)'-') &
        (e | ~(unsigned int)'_');

    return (int)(~result & 0xFFU);
}



static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int a = (x - 26U) >> 8;
    unsigned int b = (x - 52U) >> 8;
    unsigned int c = (x - 62U) >> 8;
    unsigned int upper = x + 'A';
    unsigned int lower = b & (x + ('a' - 26));
    unsigned int digits = ~b & c & (x + ('0' - 52));
    unsigned int punctuation =
        (~((0U - (x ^ 62U)) >> 8) & '-') |
        (~((0U - (x ^ 63U)) >> 8) & '_');

    return (int)(((lower ^ ((upper ^ lower) & a)) |
                  digits | punctuation) & 0xFFU);
}



static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int a = (x - 26U) >> 8;
    unsigned int b = (x - 52U) >> 8;
    unsigned int c = (x - 62U) >> 8;
    unsigned int lower = ~a & (x + ('a' - 26));
    unsigned int digits = c & (x + ('0' - 52));
    unsigned int middle = digits ^ ((lower ^ digits) & b);

    return (int)(((a & (x + 'A')) | middle |
                  (~((0U - (x ^ 62U)) >> 8) & '-') |
                  (~((0U - (x ^ 63U)) >> 8) & '_')) & 0xFFU);
}



static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int a = (x - 26U) >> 8;
    unsigned int b = (x - 52U) >> 8;
    unsigned int c = (x - 62U) >> 8;
    unsigned int d = ~((0U - (x ^ 62U)) >> 8);
    unsigned int e = ~((0U - (x ^ 63U)) >> 8);
    unsigned int result = 0U;
    unsigned int bit;

    for (bit = 1U; bit <= 0x80U; bit <<= 1) {
        if ((a & (x + 'A') & bit) ||
            (~a & b & (x + ('a' - 26)) & bit) ||
            (~b & c & (x + ('0' - 52)) & bit) ||
            (d & '-' & bit) ||
            (e & '_' & bit))
            result |= bit;
    }

    return (int)result;
}



static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int a = (x - 26U) >> 8;
    unsigned int b = (x - 52U) >> 8;
    unsigned int terms[5] = {
        a & (x + 'A'),
        ~a & b & (x + ('a' - 26)),
        ~b & ((x - 62U) >> 8) & (x + ('0' - 52)),
        ~((0U - (x ^ 62U)) >> 8) & '-',
        ~((0U - (x ^ 63U)) >> 8) & '_'
    };
    unsigned int result = 0U;
    unsigned int i = 5U;

    while (i != 0U) {
        --i;
        result ^= terms[i] & ~result;
    }

    return (int)(result & 0xFFU);
}



static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int a = ((x - 26U) / 256U) % 256U;
    unsigned int b = ((x - 52U) / 256U) % 256U;
    unsigned int c = ((x - 62U) / 256U) % 256U;
    unsigned int d = ((0U - (x ^ 62U)) / 256U) % 256U;
    unsigned int e = ((0U - (x ^ 63U)) / 256U) % 256U;

    return (int)((a & (x + 'A')) |
                 ((255U - a) & b & (x + ('a' - 26))) |
                 ((255U - b) & c & (x + ('0' - 52))) |
                 ((255U - d) & '-') |
                 ((255U - e) & '_'));
}



static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int a = (x - 26U) >> 8;
    unsigned int b = (x - 52U) >> 8;
    unsigned int c = (x - 62U) >> 8;
    unsigned int d = (0U - (x ^ 62U)) >> 8;
    unsigned int e = (0U - (x ^ 63U)) >> 8;
    unsigned int upper = x + 'A';
    unsigned int lower = x + ('a' - 26);
    unsigned int digit = x + ('0' - 52);
    unsigned int dash = '-';
    unsigned int underscore = '_';

    upper &= a;
    lower &= b;
    lower ^= lower & a;
    digit &= c;
    digit ^= digit & b;
    dash ^= dash & d;
    underscore ^= underscore & e;

    return (int)((upper | lower | digit | dash | underscore) & 0xFFU);
}
