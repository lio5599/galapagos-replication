static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Expands the header computation into its original arithmetic steps.
    // Payload selection and accumulation are unchanged.
    // Signed division and operation order preserve edge cases, including
    // zero and negatives, wherever the reference is defined.
    int count = 16;
    int header = 7 + bps;

    header += 7;
    header /= 8;
    header = ch * header;
    count += header;

    if (ch == 2)
        count += ((2 * bps + 1) * blocksize + 7) / 8;
    else
        count += (ch * bps * blocksize + 7) / 8;

    count += 2;
    return count;
}
