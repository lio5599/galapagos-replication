uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t q = ((z & UINT64_C(0x7FFFFFFF)) * p0i)
               & UINT64_C(0x7FFFFFFF);
    uint32_t d = (uint32_t)((z + q * p) >> 31) - p;
    uint32_t mask = ~((d >> 31) - UINT32_C(1));
    return d + (p & mask);
}
