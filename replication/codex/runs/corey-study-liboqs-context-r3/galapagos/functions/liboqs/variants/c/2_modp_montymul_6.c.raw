uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z = (uint64_t)a * b;
    uint64_t q = (z * p0i) & UINT64_C(0x7FFFFFFF);
    uint64_t w = q * p;
    uint32_t carry = (uint32_t)(((z & UINT64_C(0x7FFFFFFF))
                              + (w & UINT64_C(0x7FFFFFFF))) >> 31);
    uint32_t t = (uint32_t)(z >> 31) + (uint32_t)(w >> 31) + carry;
    uint32_t d = t - p;
    return d + (p & (UINT32_C(0) - (d >> 31)));
}
