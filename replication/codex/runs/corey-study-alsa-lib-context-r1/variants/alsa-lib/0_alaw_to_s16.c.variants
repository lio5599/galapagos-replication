
static int alaw_to_s16(unsigned char a_val)
{
	int x = a_val ^ 0x55;
	int seg = (x >> 4) & 7;
	int t = ((x & 15) << 4) + 8;

	if (seg != 0)
		t = (t + 256) << (seg - 1);

	return (x & 128) ? t : -t;
}



static int alaw_to_s16(unsigned char a_val)
{
	int seg = ((a_val >> 4) ^ 5) & 7;
	int mantissa = (a_val ^ 5) & 15;
	int t;

	if (seg == 0)
		t = mantissa * 16 + 8;
	else
		t = (mantissa * 16 + 264) * (1 << (seg - 1));

	return (a_val & 0x80) ? t : -t;
}



static int alaw_to_s16(unsigned char a_val)
{
	int x = a_val ^ 0x55;
	int t = ((x & 15) << 4) + 264;

	switch ((x >> 4) & 7) {
	case 0: t -= 256; break;
	case 1: break;
	case 2: t <<= 1; break;
	case 3: t <<= 2; break;
	case 4: t <<= 3; break;
	case 5: t <<= 4; break;
	case 6: t <<= 5; break;
	case 7: t <<= 6; break;
	}

	return (x & 128) ? t : -t;
}



static int alaw_to_s16(unsigned char a_val)
{
	int x = a_val ^ 0x55;
	int seg = (x >> 4) & 7;
	int t = ((x & 15) << 4) + 8;

	if (seg > 0) {
		t += 256;
		while (seg > 1) {
			t *= 2;
			--seg;
		}
	}

	return (x & 128) ? t : -t;
}



static int alaw_to_s16(unsigned char a_val)
{
	int x = a_val ^ 0x55;
	int seg = (x >> 4) & 7;
	int nonzero = (seg != 0);
	int shift = seg - nonzero;
	int t = (((x & 15) << 4) + 8 + 256 * nonzero) << shift;

	return t * (2 * ((x >> 7) & 1) - 1);
}



static int alaw_to_s16(unsigned char a_val)
{
	int x = a_val ^ 0x55;
	int seg = (x >> 4) & 7;
	int shift = seg ? seg - 1 : 0;
	int t = (((x & 15) << 4) + 264) << shift;

	if (seg == 0)
		t -= 256;
	if (!(x & 128))
		t = -t;

	return t;
}



static int alaw_to_s16(unsigned char a_val)
{
	int x = a_val ^ 0x55;
	int seg = (x >> 4) & 7;
	int t;

	if (seg == 0)
		t = ((x & 15) * 2 + 1) * 8;
	else
		t = ((x & 15) * 2 + 33) << (seg + 2);

	return (x & 128) ? t : -t;
}



static int alaw_to_s16(unsigned char a_val)
{
	int x = a_val ^ 0x55;
	int code = x & 127;
	int t;

	if (code < 16)
		t = code * 16 + 8;
	else if (code < 32)
		t = (code - 16) * 16 + 264;
	else if (code < 48)
		t = (code - 32) * 32 + 528;
	else if (code < 64)
		t = (code - 48) * 64 + 1056;
	else if (code < 80)
		t = (code - 64) * 128 + 2112;
	else if (code < 96)
		t = (code - 80) * 256 + 4224;
	else if (code < 112)
		t = (code - 96) * 512 + 8448;
	else
		t = (code - 112) * 1024 + 16896;

	return (x & 128) ? t : -t;
}



static int alaw_to_s16(unsigned char a_val)
{
	int x = a_val ^ 0x55;
	int seg = (x >> 4) & 7;
	int t;

	if (seg == 0) {
		t = ((x & 15) << 4) + 8;
	} else {
		int shift = seg - 1;
		t = ((x & 15) << 4) + 264;
		if (shift & 1)
			t <<= 1;
		if (shift & 2)
			t <<= 2;
		if (shift & 4)
			t <<= 4;
	}

	return (x & 128) ? t : -t;
}



static int alaw_to_s16(unsigned char a_val)
{
	int x = a_val ^ 0x55;
	int seg = (x >> 4) & 7;
	int t;

	if (seg == 0) {
		t = ((x & 15) << 4) + 8;
	} else {
		int scale = 1 << (seg - 1);
		t = (x & 15) * (16 * scale) + 264 * scale;
	}

	if (a_val & 0x80)
		return t;
	return -t;
}
