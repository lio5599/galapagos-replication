    masks[0] = ((x - 26U) >> 8) & 0xFFU;
    masks[1] = ((x - 52U) >> 8) & 0xFFU;
    masks[2] = ((x - 62U) >> 8) & 0xFFU;
    masks[3] = (((0U - (x ^ 62U)) >> 8) & 0xFFU) ^ 0xFFU;
    masks[4] = (((0U - (x ^ 63U)) >> 8) & 0xFFU) ^ 0xFFU;

