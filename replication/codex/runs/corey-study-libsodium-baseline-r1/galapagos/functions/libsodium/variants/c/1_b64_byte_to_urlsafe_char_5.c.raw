static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int a = ((x - 26U) >> 8) & 0xFFU;
    unsigned int b = ((x - 52U) >> 8) & 0xFFU;
    unsigned int c = ((x - 62U) >> 8) & 0xFFU;
    unsigned int upper = a & (x + 'A');
    unsigned int lower = (a ^ 0xFFU) & b & (x + ('a' - 26));
    unsigned int digit = (b ^ 0xFFU) & c & (x + ('0' - 52));
    unsigned int dash = ((((0U - (x ^ 62U)) >> 8) & 0xFFU) ^ 0xFFU) & '-';
    unsigned int under = ((((0U - (x ^ 63U)) >> 8) & 0xFFU) ^ 0xFFU) & '_';

    return (int)~(~upper & ~lower & ~digit & ~dash & ~under);
}
