static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int a = ((x - 26U) >> 8) & 0xFFU;
    unsigned int b = ((x - 52U) >> 8) & 0xFFU;
    unsigned int c = ((x - 62U) >> 8) & 0xFFU;
    unsigned int d = ((0U - (x ^ 62U)) >> 8) & 0xFFU;
    unsigned int e = ((0U - (x ^ 63U)) >> 8) & 0xFFU;
    unsigned int r = 0U;
    unsigned int bit;

    for (bit = 1U; bit <= 0x80U; bit <<= 1)
    {
        if ((a & (x + 'A') & bit) ||
            ((a ^ 0xFFU) & b & (x + ('a' - 26)) & bit) ||
            ((b ^ 0xFFU) & c & (x + ('0' - 52)) & bit) ||
            ((d ^ 0xFFU) & '-' & bit) ||
            ((e ^ 0xFFU) & '_' & bit))
            r |= bit;
    }

    return (int)r;
}
