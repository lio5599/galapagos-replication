static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int masks[5];
    unsigned int values[5];
    unsigned int r = 0U;
    unsigned int i;

    masks[0] = ((x - 26U) >> 8) & 0xFFU;
    masks[1] = ((x - 52U) >> 8) & 0xFFU;
    masks[2] = ((x - 62U) >> 8) & 0xFFU;
    masks[3] = (((0U - (x ^ 62U)) >> 8) & 0xFFU) ^ 0xFFU;
    masks[4] = (((0U - (x ^ 63U)) >> 8) & 0xFFU) ^ 0xFFU;

    masks[2] &= masks[1] ^ 0xFFU;
    masks[1] &= masks[0] ^ 0xFFU;

    values[0] = x + 'A';
    values[1] = x + ('a' - 26);
    values[2] = x + ('0' - 52);
    values[3] = '-';
    values[4] = '_';

    for (i = 0U; i < 5U; ++i)
        r |= masks[i] & values[i];

    return (int)r;
}
