
int16_t barrett_reduce(int16_t a) {
  int32_t t = ((int32_t)20159 * a + 33554432) >> 26;
  return (int16_t)((int32_t)a - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  int64_t t = ((int64_t)a * 20159 + 33554432) >> 26;
  return (int16_t)((int64_t)a - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  int32_t n = (int32_t)a * 20159 + 33554432;
  int32_t t = n / 67108864;
  t -= (n < 0 && n % 67108864 != 0);
  return (int16_t)((int32_t)a - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  uint32_t n = (uint32_t)((int32_t)a * 20159 + 1107296256);
  int32_t t = (int32_t)(n >> 26) - 16;
  return (int16_t)((int32_t)a - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  int32_t x = a;
  int32_t n = x * 16384 + x * 4096 - x * 256 - x * 64 - x;
  int32_t t = (n + 33554432) >> 26;
  return (int16_t)(x - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  int32_t x = a;
  int32_t magnitude = x < 0 ? -x : x;
  int32_t t = (magnitude * 20159 + 33554432) / 67108864;
  if (x < 0)
    t = -t;
  return (int16_t)(x - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  int32_t x = a;
  int32_t quotient = x / 3329;
  int32_t remainder = x % 3329;
  int32_t correction =
      (remainder * 20159 + quotient * 447 + 33554432) >> 26;
  return (int16_t)(remainder - correction * 3329);
}



int16_t barrett_reduce(int16_t a) {
  int32_t n = (int32_t)a * 20159 + 33554432;
  int32_t t = 0;

  while (n >= 67108864) {
    n -= 67108864;
    ++t;
  }
  while (n < 0) {
    n += 67108864;
    --t;
  }

  return (int16_t)((int32_t)a - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  uint64_t n =
      (uint64_t)((int64_t)a * 20159 + 33554432 + ((int64_t)1 << 32));
  int32_t t = (int32_t)(n >> 26) - 64;
  return (int16_t)((int32_t)a - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  int32_t n = (int32_t)a * 20159 + 33554432;
  int32_t t;

  if (n >= 0)
    t = n / 67108864;
  else
    t = -1 - (-(n + 1) / 67108864);

  return (int16_t)((int32_t)a - t * 3329);
}
