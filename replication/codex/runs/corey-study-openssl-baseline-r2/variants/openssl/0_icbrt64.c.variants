
static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    int s = 63;

    do {
        r *= 2;
        uint64_t b = 3 * r * (r + 1) + 1;
        if (b <= (x >> s)) {
            x -= b << s;
            ++r;
        }
        s -= 3;
    } while (s >= 0);

    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    uint64_t remainder = 0;

    for (int s = 63; s >= 0; s -= 3) {
        remainder = (remainder << 3) | ((x >> s) & 7);
        uint64_t trial = 12 * r * r + 6 * r + 1;
        r <<= 1;
        if (remainder >= trial) {
            remainder -= trial;
            ++r;
        }
    }

    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t lo = 0;
    uint64_t hi = 2642246;

    while (hi - lo > 1) {
        uint64_t mid = lo + (hi - lo) / 2;
        uint64_t cube = mid * mid * mid;

        if (cube <= x)
            lo = mid;
        else
            hi = mid;
    }

    return lo << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t lo = 0;
    uint64_t hi = (uint64_t)1 << 22;

    while (lo < hi) {
        uint64_t mid = lo + (hi - lo + 1) / 2;

        if (mid <= x / mid / mid)
            lo = mid;
        else
            hi = mid - 1;
    }

    return lo << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;

    for (uint64_t bit = (uint64_t)1 << 21; bit; bit >>= 1) {
        uint64_t candidate = r | bit;
        if (candidate <= x / candidate / candidate)
            r = candidate;
    }

    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;

    for (int i = 21; i >= 0; --i) {
        uint64_t candidate = r + ((uint64_t)1 << i);

        if (candidate <= 2642245 &&
            candidate * candidate * candidate <= x)
            r = candidate;
    }

    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    if (x == 0)
        return 0;

    uint64_t r = (uint64_t)1 << 22;

    for (;;) {
        uint64_t next = (2 * r + x / (r * r)) / 3;
        if (next >= r)
            return r << 12;
        r = next;
    }
}



static uint64_t icbrt64(uint64_t x)
{
    if (x == 0)
        return 0;

    unsigned bits = 0;
    for (uint64_t v = x; v; v >>= 1)
        ++bits;

    uint64_t r = (uint64_t)1 << ((bits + 2) / 3);
    uint64_t next = (2 * r + x / (r * r)) / 3;

    while (next < r) {
        r = next;
        next = (2 * r + x / (r * r)) / 3;
    }

    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    uint64_t cube = 0;

    for (uint64_t bit = (uint64_t)1 << 21; bit; bit >>= 1) {
        if (r + bit > 2642245)
            continue;

        uint64_t delta =
            3 * r * r * bit + 3 * r * bit * bit + bit * bit * bit;

        if (delta <= x - cube) {
            cube += delta;
            r += bit;
        }
    }

    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    uint64_t cube = 0;
    uint64_t delta = 1;
    uint64_t second_difference = 6;

    while (delta <= x - cube) {
        cube += delta;
        ++r;
        delta += second_difference;
        second_difference += 6;
    }

    return r << 12;
}
