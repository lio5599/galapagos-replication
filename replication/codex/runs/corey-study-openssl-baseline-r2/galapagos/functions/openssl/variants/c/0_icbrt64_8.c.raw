static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    uint64_t cube = 0;

    for (uint64_t bit = (uint64_t)1 << 21; bit; bit >>= 1) {
        if (r + bit > 2642245)
            continue;

        uint64_t delta =
            3 * r * r * bit + 3 * r * bit * bit + bit * bit * bit;

        if (delta <= x - cube) {
            cube += delta;
            r += bit;
        }
    }

    return r << 12;
}
