int fpr_lt(uint64_t x, uint64_t y) {
    // Map encodings to unsigned keys that increase in the reference's order.
    // Complement negative encodings and flip the sign bit of positive ones.
    // This preserves equality and places every negative encoding before positives.
    uint64_t sign = (uint64_t)1 << 63;
    uint64_t kx = (x & sign) ? ~x : (x ^ sign);
    uint64_t ky = (y & sign) ? ~y : (y ^ sign);

    return kx < ky;
}
