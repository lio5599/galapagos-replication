static uint64_t fpr_half(uint64_t x) {
    // Adding the unsigned additive inverse of 2^52 implements the same subtraction.
    // Test the exponent directly through its bit mask.
    // All zero-exponent encodings return zero; other encodings keep the modular sum.
    if ((x & ((uint64_t)0x7FF << 52)) == 0) {
        return 0;
    }
    return x + (~((uint64_t)1 << 52) + (uint64_t)1);
}
