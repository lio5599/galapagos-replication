uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Split p into 16-bit limbs when forming the correction product.
    // The partial products sum exactly to q times p and fit in 64 bits.
    // Subsequent wrapping and the bit-31 test match the reference for all inputs.
    uint64_t z = (uint64_t)a * b;
    uint64_t q = (z * p0i) & (uint64_t)0x7FFFFFFF;
    uint64_t w = q * (p & (uint32_t)0xFFFF)
        + ((q * (p >> 16)) << 16);
    uint32_t d = (uint32_t)((z + w) >> 31) - p;

    d += p & -(d >> 31);
    return d;
}
