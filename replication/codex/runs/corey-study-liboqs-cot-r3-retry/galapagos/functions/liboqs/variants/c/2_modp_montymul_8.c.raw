uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Split p0i into 16-bit limbs to compute only the low 31 product bits.
    // The shifted upper-limb term needs only the low 15 bits of z.
    // All intermediate terms fit; masking yields the same factor for all inputs.
    uint64_t z = (uint64_t)a * b;
    uint64_t q = ((z & (uint64_t)0x7FFFFFFF)
        * (p0i & (uint32_t)0xFFFF)
        + (((z & (uint64_t)0x7FFF) * (p0i >> 16)) << 16))
        & (uint64_t)0x7FFFFFFF;
    uint64_t w = q * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;

    d += p & -(d >> 31);
    return d;
}
