uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Add z and w in 32-bit limbs, explicitly propagating the low-limb carry.
    // Truncating the high limb reproduces 64-bit overflow exactly.
    // Combining bits 31 through 62 gives the reference's truncated quotient.
    uint64_t z = (uint64_t)a * b;
    uint64_t w = ((z * p0i) & (uint64_t)0x7FFFFFFF) * p;
    uint64_t low_sum = (uint64_t)(uint32_t)z + (uint32_t)w;
    uint32_t low = (uint32_t)low_sum;
    uint32_t high = (uint32_t)((z >> 32) + (w >> 32)
        + (low_sum >> 32));
    uint32_t t = (low >> 31) | (uint32_t)((uint64_t)high << 1);
    uint32_t d = t - p;

    d += p & -(d >> 31);
    return d;
}
