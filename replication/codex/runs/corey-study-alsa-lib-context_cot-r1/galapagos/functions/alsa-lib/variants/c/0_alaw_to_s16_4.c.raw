static int alaw_to_s16(unsigned char a_val)
{
	// Factor eight out of the mantissa and bias.
	// Nonzero segments use 16*m + 264 = 8*(2*m + 33).
	// Segment zero instead uses 8*(2*m + 1), including both endpoints.
	int x = a_val ^ 0x55;
	int seg = (x >> 4) & 7;
	int mant = x & 15;
	int t;

	if (seg == 0)
		t = (2 * mant + 1) * 8;
	else
		t = (2 * mant + 33) << (seg + 2);

	return (x & 128) ? t : -t;
}
