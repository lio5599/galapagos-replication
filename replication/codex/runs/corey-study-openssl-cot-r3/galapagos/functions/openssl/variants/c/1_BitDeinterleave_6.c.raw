static uint64_t BitDeinterleave(uint64_t Ai)
{
    // Extract the lower and upper 32-bit halves, then reassemble them unchanged.
    // The halves cover all 64 bits, preserving every input and both extremes.
    uint32_t lo = (uint32_t)Ai;
    uint32_t hi = (uint32_t)(Ai >> 32);
    return ((uint64_t)hi << 32) | (uint64_t)lo;
}
