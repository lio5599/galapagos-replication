int16_t barrett_reduce(int16_t a) {
  // Repeatedly add or subtract the modulus until the residue is centered.
  // Each step preserves congruence, and the centered representative is unique.
  // At most ten steps are needed, including for -32768 and 32767.
  int32_t r = a;
  while (r > 1664)
    r -= 3329;
  while (r < -1664)
    r += 3329;
  return (int16_t)r;
}
