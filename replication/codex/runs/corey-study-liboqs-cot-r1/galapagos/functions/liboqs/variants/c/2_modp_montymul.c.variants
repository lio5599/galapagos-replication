static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Computes a radix-2^31 Montgomery-style product with the reference correction.
    // Naming the masked multiplier separately leaves every operation unchanged.
    // The same unsigned wrapping and bit-31 test apply for all input values.
    uint64_t z = (uint64_t)a * (uint64_t)b;
    uint64_t m = (z * p0i) & (uint64_t)0x7FFFFFFF;
    uint64_t w = m * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    d += p & (uint32_t)(0u - (d >> 31));
    return d;
}

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Replace the masked addition with an explicit conditional addition.
    // The condition tests bit 31, exactly as the reference does.
    // It does not substitute a borrow test, so arbitrary inputs remain equivalent.
    uint64_t z = (uint64_t)a * (uint64_t)b;
    uint64_t w = ((z * p0i) & (uint64_t)0x7FFFFFFF) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    if ((d >> 31) != 0u)
        d += p;
    return d;
}

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Select between d and its wrapped sum with p using an XOR mask.
    // The mask is all ones exactly when the reference adds p.
    // Both candidate results retain the reference's 32-bit wrapping.
    uint64_t z = (uint64_t)a * (uint64_t)b;
    uint64_t w = ((z * p0i) & (uint64_t)0x7FFFFFFF) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    uint32_t corrected = d + p;
    uint32_t mask = (uint32_t)(0u - (d >> 31));
    return d ^ ((d ^ corrected) & mask);
}

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Multiply p by the correction bit instead of masking p.
    // That bit is zero or one, so the added value is exactly zero or p.
    // The final conversion preserves wrapping even at the 32-bit boundary.
    uint64_t z = (uint64_t)a * (uint64_t)b;
    uint64_t w = ((z * p0i) & (uint64_t)0x7FFFFFFF) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    return (uint32_t)((uint64_t)d + (uint64_t)(d >> 31) * p);
}

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Extract the shifted result through the sum's two 32-bit halves.
    // Bits 31 through 62 are exactly the reference's truncated quotient.
    // The sum wraps before extraction, preserving overflow edge cases.
    uint64_t z = (uint64_t)a * (uint64_t)b;
    uint64_t w = ((z * p0i) & (uint64_t)0x7FFFFFFF) * p;
    uint64_t sum = z + w;
    uint32_t low = (uint32_t)sum;
    uint32_t high = (uint32_t)(sum >> 32);
    uint32_t q = (uint32_t)(((uint64_t)high << 1) | (low >> 31));
    uint32_t d = q - p;
    return d + (p & (uint32_t)(0u - (d >> 31)));
}

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Add z and w using 32-bit limbs and an explicit carry.
    // Truncating the high limb reproduces the reference's 64-bit wrap.
    // Reassembling bits 31 through 62 preserves the quotient and correction.
    uint64_t z = (uint64_t)a * (uint64_t)b;
    uint64_t w = ((z * p0i) & (uint64_t)0x7FFFFFFF) * p;
    uint64_t low_sum = (uint64_t)(uint32_t)z + (uint32_t)w;
    uint32_t low = (uint32_t)low_sum;
    uint32_t high = (uint32_t)((z >> 32) + (w >> 32) + (low_sum >> 32));
    uint32_t q = (uint32_t)(((uint64_t)high << 1) | (low >> 31));
    uint32_t d = q - p;
    d += p & (uint32_t)(0u - (d >> 31));
    return d;
}

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Reduce both multiplier operands modulo 2^31 before multiplying.
    // Only their low 31 bits can affect the reference's masked product.
    // The remaining sum, truncation, and correction preserve all wrap cases.
    uint64_t z = (uint64_t)a * (uint64_t)b;
    uint64_t m = ((z & (uint64_t)0x7FFFFFFF)
        * (p0i & (uint32_t)0x7FFFFFFF)) & (uint64_t)0x7FFFFFFF;
    uint64_t sum = z + m * p;
    uint32_t d = (uint32_t)(sum >> 31) - p;
    return d + (p & (uint32_t)(0u - (d >> 31)));
}

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Build the masked multiplier times p by binary shift-and-add.
    // Its 31 bits are exhausted by the loop, yielding the exact product.
    // The subsequent unsigned sum and correction match even on overflow.
    uint64_t z = (uint64_t)a * (uint64_t)b;
    uint32_t m = (uint32_t)((z * p0i) & (uint64_t)0x7FFFFFFF);
    uint64_t w = 0;
    uint64_t term = p;
    while (m != 0u) {
        if ((m & 1u) != 0u)
            w += term;
        term <<= 1;
        m >>= 1;
    }
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    d += p & (uint32_t)(0u - (d >> 31));
    return d;
}

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // After subtracting p, adding it back recovers q modulo 2^32.
    // Select q directly when the reference's correction bit is set.
    // Testing d rather than comparing q with p preserves arbitrary-input cases.
    uint64_t z = (uint64_t)a * (uint64_t)b;
    uint64_t w = ((z * p0i) & (uint64_t)0x7FFFFFFF) * p;
    uint32_t q = (uint32_t)((z + w) >> 31);
    uint32_t d = q - p;
    return (d >> 31) != 0u ? q : d;
}

static uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Expand a times b into four products of 16-bit limbs.
    // The expansion equals the exact 64-bit product, including maximal inputs.
    // The masked multiplication, wrapped sum, and correction are unchanged.
    uint64_t a0 = a & (uint32_t)0xFFFF;
    uint64_t a1 = a >> 16;
    uint64_t b0 = b & (uint32_t)0xFFFF;
    uint64_t b1 = b >> 16;
    uint64_t z = a0 * b0
        + ((a0 * b1 + a1 * b0) << 16)
        + ((a1 * b1) << 32);
    uint64_t w = ((z * p0i) & (uint64_t)0x7FFFFFFF) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    d += p & (uint32_t)(0u - (d >> 31));
    return d;
}