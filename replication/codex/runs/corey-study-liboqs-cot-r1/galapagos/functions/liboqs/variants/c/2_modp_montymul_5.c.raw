uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Add z and w using 32-bit limbs and an explicit carry.
    // Truncating the high limb reproduces the reference's 64-bit wrap.
    // Reassembling bits 31 through 62 preserves the quotient and correction.
    uint64_t z = (uint64_t)a * (uint64_t)b;
    uint64_t w = ((z * p0i) & (uint64_t)0x7FFFFFFF) * p;
    uint64_t low_sum = (uint64_t)(uint32_t)z + (uint32_t)w;
    uint32_t low = (uint32_t)low_sum;
    uint32_t high = (uint32_t)((z >> 32) + (w >> 32) + (low_sum >> 32));
    uint32_t q = (uint32_t)(((uint64_t)high << 1) | (low >> 31));
    uint32_t d = q - p;
    d += p & (uint32_t)(0u - (d >> 31));
    return d;
}
