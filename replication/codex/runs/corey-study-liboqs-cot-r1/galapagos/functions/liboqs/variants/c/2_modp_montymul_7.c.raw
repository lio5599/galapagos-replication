uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Build the masked multiplier times p by binary shift-and-add.
    // Its 31 bits are exhausted by the loop, yielding the exact product.
    // The subsequent unsigned sum and correction match even on overflow.
    uint64_t z = (uint64_t)a * (uint64_t)b;
    uint32_t m = (uint32_t)((z * p0i) & (uint64_t)0x7FFFFFFF);
    uint64_t w = 0;
    uint64_t term = p;
    while (m != 0u) {
        if ((m & 1u) != 0u)
            w += term;
        term <<= 1;
        m >>= 1;
    }
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    d += p & (uint32_t)(0u - (d >> 31));
    return d;
}
