uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    // Expand a times b into four products of 16-bit limbs.
    // The expansion equals the exact 64-bit product, including maximal inputs.
    // The masked multiplication, wrapped sum, and correction are unchanged.
    uint64_t a0 = a & (uint32_t)0xFFFF;
    uint64_t a1 = a >> 16;
    uint64_t b0 = b & (uint32_t)0xFFFF;
    uint64_t b1 = b >> 16;
    uint64_t z = a0 * b0
        + ((a0 * b1 + a1 * b0) << 16)
        + ((a1 * b1) << 32);
    uint64_t w = ((z * p0i) & (uint64_t)0x7FFFFFFF) * p;
    uint32_t d = (uint32_t)((z + w) >> 31) - p;
    d += p & (uint32_t)(0u - (d >> 31));
    return d;
}
