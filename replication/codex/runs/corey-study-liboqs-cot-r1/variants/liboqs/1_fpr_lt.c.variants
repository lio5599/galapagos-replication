static int fpr_lt(uint64_t x, uint64_t y) {
    // The reference orders sign-magnitude encodings, with negatives first.
    // Equal-sign positives ascend; equal-sign negatives descend.
    // Equality is false, and negative zero precedes positive zero.
    if ((x >> 63) != (y >> 63)) {
        return (int)(x >> 63);
    }
    if (x >> 63) {
        return x > y;
    }
    return x < y;
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Select among different-sign, positive, and negative comparisons.
    // Different signs select the negative operand as smaller.
    // Strict comparisons preserve equality and distinguish signed zeros.
    unsigned sx = (unsigned)(x >> 63);
    unsigned sy = (unsigned)(y >> 63);
    return (int)(((sx ^ sy) & sx)
        | ((1U ^ (sx ^ sy))
        & ((sx & (unsigned)(x > y))
        | ((1U ^ sx) & (unsigned)(x < y)))));
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Convert each encoding into an ascending unsigned ordering key.
    // Complement negatives and flip the sign bit of positives.
    // Keys are unique, with negative zero immediately before positive zero.
    uint64_t sign = (uint64_t)1 << 63;
    uint64_t kx = (x >> 63) ? ~x : (x ^ sign);
    uint64_t ky = (y >> 63) ? ~y : (y ^ sign);
    return kx < ky;
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Compare signs first, then compare the sign-cleared magnitudes.
    // Negative magnitudes use reversed order; positive ones use normal order.
    // Equal encodings compare false, while opposite signed zeros use signs.
    uint64_t mask = ((uint64_t)1 << 63) - 1;
    uint64_t mx = x & mask;
    uint64_t my = y & mask;
    unsigned sx = (unsigned)(x >> 63);
    unsigned sy = (unsigned)(y >> 63);
    return sx != sy ? (int)sx : (sx ? mx > my : mx < my);
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // For equal signs, the unsigned difference's top bit detects ordering.
    // Such operands differ by at most 2 to the power 63 minus one.
    // Reverse subtraction for negatives; equality produces zero.
    // Different signs are handled directly, including signed zeros.
    uint64_t sx = x >> 63;
    uint64_t sy = y >> 63;
    uint64_t d;
    if (sx != sy) {
        return (int)sx;
    }
    d = sx ? y - x : x - y;
    return (int)(d >> 63);
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Compare equal-sign encodings lexicographically by their 32-bit halves.
    // Reverse each comparison for negatives, preserving strict equality.
    // Handle different signs first, so signed zeros retain reference order.
    unsigned sx = (unsigned)(x >> 63);
    uint32_t xh = (uint32_t)(x >> 32);
    uint32_t yh = (uint32_t)(y >> 32);
    uint32_t xl = (uint32_t)x;
    uint32_t yl = (uint32_t)y;
    if (sx != (unsigned)(y >> 63)) {
        return (int)sx;
    }
    if (xh != yh) {
        return sx ? xh > yh : xh < yh;
    }
    return sx ? xl > yl : xl < yl;
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Swap operands only when both are negative to reverse their order.
    // Flipping the sign bits then puts negatives before positives.
    // The strict unsigned comparison handles equality and signed zeros.
    uint64_t sign = (uint64_t)1 << 63;
    uint64_t mask = (uint64_t)0 - ((x & y) >> 63);
    uint64_t swap = (x ^ y) & mask;
    uint64_t a = x ^ swap;
    uint64_t b = y ^ swap;
    return (a ^ sign) < (b ^ sign);
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Exclude equality before complementing the comparison for negatives.
    // For distinct equal-sign values, reversing less-than gives greater-than.
    // Different signs use the sign of x, including opposite signed zeros.
    if (x == y) {
        return 0;
    }
    if ((x ^ y) >> 63) {
        return (int)(x >> 63);
    }
    return (x < y) ^ (int)(x >> 63);
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Extract unsigned less-than from the borrow bit of unsigned subtraction.
    // For equal-sign negatives, invert it only when the operands differ.
    // Different signs select x's sign, preserving the signed-zero ordering.
    uint64_t d = x - y;
    uint64_t borrow = ((~x & y) | (~(x ^ y) & d)) >> 63;
    unsigned sx = (unsigned)(x >> 63);
    unsigned different = (unsigned)((x ^ y) >> 63);
    unsigned same_result = (unsigned)borrow
        ^ (sx & (unsigned)(x != y));
    return (int)((different & sx) | ((1U ^ different) & same_result));
}

static int fpr_lt(uint64_t x, uint64_t y) {
    // Inspect bytes from most significant to least for equal-sign values.
    // The first unequal byte determines order, reversed for negatives.
    // No unequal byte means equality; different signs include signed zeros.
    unsigned sx = (unsigned)(x >> 63);
    int shift;
    if (sx != (unsigned)(y >> 63)) {
        return (int)sx;
    }
    for (shift = 56; shift >= 0; shift -= 8) {
        unsigned bx = (unsigned)((x >> shift) & 255U);
        unsigned by = (unsigned)((y >> shift) & 255U);
        if (bx != by) {
            return sx ? bx > by : bx < by;
        }
    }
    return 0;
}