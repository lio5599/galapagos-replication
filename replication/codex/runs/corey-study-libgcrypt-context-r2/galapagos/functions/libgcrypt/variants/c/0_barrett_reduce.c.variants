
#include <stdint.h>

int16_t barrett_reduce(int16_t a) {
  int16_t t;
  t = ((int32_t)20159 * a + 33554432) >> 26;
  t *= 3329;
  return a - t;
}



#include <stdint.h>

int16_t barrett_reduce(int16_t a) {
  int32_t x = a;
  int32_t product = 20160 * x - x;
  int16_t t = (product + 33554432) >> 26;
  t *= 3329;
  return a - t;
}



#include <stdint.h>

int16_t barrett_reduce(int16_t a) {
  int32_t x = a;
  int32_t product = 16384 * x + 3775 * x;
  int16_t t = (product + 33554432) >> 26;
  t *= 3329;
  return a - t;
}



#include <stdint.h>

int16_t barrett_reduce(int16_t a) {
  int32_t x = a;
  int32_t product = 32768 * x - 12609 * x;
  int16_t t = (product + 33554432) >> 26;
  t *= 3329;
  return a - t;
}



#include <stdint.h>

int16_t barrett_reduce(int16_t a) {
  int32_t x = a;
  int32_t product = (315 * x) * 64 - x;
  int16_t t = (product + 33554432) >> 26;
  t *= 3329;
  return a - t;
}



#include <stdint.h>

int16_t barrett_reduce(int16_t a) {
  int64_t numerator = (int64_t)20159 * a + 33554432;
  int16_t t = numerator >> 26;
  t *= 3329;
  return a - t;
}



#include <stdint.h>

int16_t barrett_reduce(int16_t a) {
  int32_t numerator = (int32_t)20159 * a + 33554432;
  int32_t intermediate = numerator >> 13;
  int16_t t = intermediate >> 13;
  t *= 3329;
  return a - t;
}



#include <stdint.h>

int16_t barrett_reduce(int16_t a) {
  int32_t numerator = (int32_t)20159 * a + 1107296256;
  int16_t t = (numerator >> 26) - 16;
  t *= 3329;
  return a - t;
}



#include <stdint.h>

int16_t barrett_reduce(int16_t a) {
  int32_t numerator = (int32_t)20159 * a + 33554432;
  int16_t t = numerator >> 26;
  int32_t scaled = (int32_t)t * 3328 + t;
  t = (int16_t)scaled;
  return a - t;
}



#include <stdint.h>

int16_t barrett_reduce(int16_t a) {
  int32_t numerator = (int32_t)20159 * a + 33554432;
  int16_t t = numerator >> 26;
  int32_t scaled = (int32_t)t * 4096 - (int32_t)t * 767;
  t = (int16_t)scaled;
  return a - t;
}
