static int mix(int c0, int c1)
{
    // Blue and green weighted sums lie in 0 through 93.
    // In that range, multiplying by 171 and shifting by 9 equals division by 3.
    // Products fit in int; red keeps signed division for all negative edge cases.
    int blue = 2 * (c0 & 31) + (c1 & 31);
    int green = 2 * ((c0 & 992) >> 5) + ((c1 & 992) >> 5);
    int red = 2 * (c0 >> 10) + (c1 >> 10);
    return red / 3 * 1024
         + ((green * 171) >> 9) * 32
         + ((blue * 171) >> 9);
}
