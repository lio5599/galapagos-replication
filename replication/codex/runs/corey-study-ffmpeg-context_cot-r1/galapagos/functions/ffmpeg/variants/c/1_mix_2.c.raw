static int mix(int c0, int c1)
{
    // Uses 3*a + (b-a), which equals 2*a + b for each component.
    // Extracted component ranges keep these intermediate operations in range.
    // Signed red division still truncates toward zero, including negative cases.
    int b0 = c0 & 31;
    int g0 = (c0 & 992) >> 5;
    int r0 = c0 >> 10;
    int blue = 3 * b0 + ((c1 & 31) - b0);
    int green = 3 * g0 + (((c1 & 992) >> 5) - g0);
    int red = 3 * r0 + ((c1 >> 10) - r0);
    return red / 3 * 1024 + green / 3 * 32 + blue / 3;
}
