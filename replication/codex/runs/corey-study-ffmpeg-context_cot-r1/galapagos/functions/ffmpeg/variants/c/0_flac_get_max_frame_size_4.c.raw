static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Returns early for stereo after performing the original additions.
    // Other channels follow the original default calculation.
    // No arithmetic is reassociated, so negative and boundary inputs are preserved.
    int count = 16;

    count += ch * ((7 + bps + 7) / 8);
    if (ch == 2) {
        count += ((2 * bps + 1) * blocksize + 7) / 8;
        count += 2;
        return count;
    }

    count += (ch * bps * blocksize + 7) / 8;
    count += 2;
    return count;
}
