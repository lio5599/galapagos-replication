static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Uses a conditional expression to select the original payload calculation.
    // Only the selected operand is evaluated, preserving branch-specific behavior.
    // Arithmetic grouping and signed division remain unchanged, including negatives.
    int count = 16;

    count += ch * ((7 + bps + 7) / 8);
    count += (ch == 2)
        ? ((2 * bps + 1) * blocksize + 7) / 8
        : (ch * bps * blocksize + 7) / 8;
    count += 2;
    return count;
}
