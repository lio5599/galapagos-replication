static int mix(int c0, int c1)
{
    // Computes a 2:1 weighted blend with each component divided by 3.
    // Extracting green before weighting is exact because its mask is aligned.
    // Red retains signed right shifts and division toward zero for negative inputs.
    int blue = 2 * (c0 & 31) + (c1 & 31);
    int green = 2 * ((c0 & 992) >> 5) + ((c1 & 992) >> 5);
    int red = 2 * (c0 >> 10) + (c1 >> 10);
    return (red / 3) * 1024 + (green / 3) * 32 + blue / 3;
}

static int mix(int c0, int c1)
{
    // Repeated addition replaces multiplication by 2.
    // Masked components stay nonnegative, and shifted red values remain signed.
    // The intermediate ranges and signed division match the reference.
    int b0 = c0 & 31;
    int b1 = c1 & 31;
    int g0 = (c0 & 992) >> 5;
    int g1 = (c1 & 992) >> 5;
    int r0 = c0 >> 10;
    int r1 = c1 >> 10;
    return ((r0 + r0 + r1) / 3) * 1024
         + ((g0 + g0 + g1) / 3) * 32
         + (b0 + b0 + b1) / 3;
}

static int mix(int c0, int c1)
{
    // Uses 3*a + (b-a), which equals 2*a + b for each component.
    // Extracted component ranges keep these intermediate operations in range.
    // Signed red division still truncates toward zero, including negative cases.
    int b0 = c0 & 31;
    int g0 = (c0 & 992) >> 5;
    int r0 = c0 >> 10;
    int blue = 3 * b0 + ((c1 & 31) - b0);
    int green = 3 * g0 + (((c1 & 992) >> 5) - g0);
    int red = 3 * r0 + ((c1 >> 10) - r0);
    return red / 3 * 1024 + green / 3 * 32 + blue / 3;
}

static int mix(int c0, int c1)
{
    // Keeps green in its masked position and divides its weighted sum by 96.
    // That sum is nonnegative and exactly 32 times the extracted green sum.
    // Red uses the original signed operations, preserving negative-input behavior.
    int blue = 2 * (c0 & 31) + (c1 & 31);
    int green_scaled = 2 * (c0 & 992) + (c1 & 992);
    int red = 2 * (c0 >> 10) + (c1 >> 10);
    return red / 3 * 1024 + green_scaled / 96 * 32 + blue / 3;
}

static int mix(int c0, int c1)
{
    // Packs the divided components using a base-32 Horner expression.
    // Blue and green quotients are in 0 through 31, so carries cannot occur.
    // The signed red quotient and all defined-result boundary cases are preserved.
    int blue = (2 * (c0 & 31) + (c1 & 31)) / 3;
    int green = (2 * ((c0 & 992) >> 5) + ((c1 & 992) >> 5)) / 3;
    int red = (2 * (c0 >> 10) + (c1 >> 10)) / 3;
    return (red * 32 + green) * 32 + blue;
}

static int mix(int c0, int c1)
{
    // Uses 3*a - (a-b) to form each weighted component.
    // Shifted and masked component bounds prevent intermediate overflow.
    // Division remains signed, so negative red values retain truncation toward zero.
    int b0 = c0 & 31;
    int g0 = (c0 & 992) >> 5;
    int r0 = c0 >> 10;
    int blue = 3 * b0 - (b0 - (c1 & 31));
    int green = 3 * g0 - (g0 - ((c1 & 992) >> 5));
    int red = 3 * r0 - (r0 - (c1 >> 10));
    return red / 3 * 1024 + green / 3 * 32 + blue / 3;
}

static int mix(int c0, int c1)
{
    // Subtracting each signed remainder makes its numerator divisible by 3.
    // The identity (v - v%3)/3 equals v/3 even when v is negative.
    // Weighted component bounds make the remainder subtraction safe.
    int blue = 2 * (c0 & 31) + (c1 & 31);
    int green = (2 * (c0 & 992) + (c1 & 992)) >> 5;
    int red = 2 * (c0 >> 10) + (c1 >> 10);
    blue = (blue - blue % 3) / 3;
    green = (green - green % 3) / 3;
    red = (red - red % 3) / 3;
    return red * 1024 + green * 32 + blue;
}

static int mix(int c0, int c1)
{
    // Blue and green weighted sums lie in 0 through 93.
    // In that range, multiplying by 171 and shifting by 9 equals division by 3.
    // Products fit in int; red keeps signed division for all negative edge cases.
    int blue = 2 * (c0 & 31) + (c1 & 31);
    int green = 2 * ((c0 & 992) >> 5) + ((c1 & 992) >> 5);
    int red = 2 * (c0 >> 10) + (c1 >> 10);
    return red / 3 * 1024
         + ((green * 171) >> 9) * 32
         + ((blue * 171) >> 9);
}

static int mix(int c0, int c1)
{
    // For nonnegative values through 93, (v*86)>>8 equals v/3 exactly.
    // Both masked weighted components satisfy this bound, including endpoints.
    // Red is not masked or approximated, preserving its full signed semantics.
    int blue = (c0 & 31) + ((c0 & 31) + (c1 & 31));
    int green = ((c0 & 992) >> 5)
              + (((c0 & 992) >> 5) + ((c1 & 992) >> 5));
    int red = 2 * (c0 >> 10) + (c1 >> 10);
    return red / 3 * 1024
         + ((green * 86) >> 8) * 32
         + ((blue * 86) >> 8);
}

static int mix(int c0, int c1)
{
    // Divides red's magnitude and restores its sign explicitly.
    // Weighted shifted red values cannot reach INT_MIN, so negation is safe.
    // Restoring the sign implements truncation toward zero, including near zero.
    int blue = 2 * (c0 & 31) + (c1 & 31);
    int green = (2 * (c0 & 992) + (c1 & 992)) >> 5;
    int red = 2 * (c0 >> 10) + (c1 >> 10);
    int red_quotient = red < 0 ? -((-red) / 3) : red / 3;
    return red_quotient * 1024 + green / 3 * 32 + blue / 3;
}