
static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);
    count += ch == 2
        ? ((2 * bps + 1) * blocksize + 7) / 8
        : (ch * bps * blocksize + 7) / 8;
    return count + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);

    switch (ch) {
    case 2:
        count += ((2 * bps + 1) * blocksize + 7) / 8;
        break;
    default:
        count += (ch * bps * blocksize + 7) / 8;
        break;
    }

    count += 2;
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);

    if (ch != 2) {
        count += (ch * bps * blocksize + 7) / 8;
    } else {
        count += ((2 * bps + 1) * blocksize + 7) / 8;
    }

    return count + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);

    if (ch == 2) {
        count += ((2 * bps + 1) * blocksize + 7) / 8;
        return count + 2;
    }

    count += (ch * bps * blocksize + 7) / 8;
    return count + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count;
    int payload;

    count = 16;
    count += ch * ((7 + bps + 7) / 8);

    if (ch == 2)
        payload = ((2 * bps + 1) * blocksize + 7) / 8;
    else
        payload = (ch * bps * blocksize + 7) / 8;

    count += payload;
    count += 2;
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    int bits;

    count += ch * ((7 + bps + 7) / 8);
    bits = ch == 2 ? 2 * bps + 1 : ch * bps;
    count += (bits * blocksize + 7) / 8;
    count += 2;

    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    return ((16 + ch * ((7 + bps + 7) / 8))
        + (ch == 2
            ? ((2 * bps + 1) * blocksize + 7) / 8
            : (ch * bps * blocksize + 7) / 8))
        + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    int header;

    header = 7 + bps;
    header += 7;
    header /= 8;
    count += ch * header;

    if (ch == 2)
        count += ((2 * bps + 1) * blocksize + 7) / 8;
    else
        count += (ch * bps * blocksize + 7) / 8;

    count += 2;
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    int payload;

    count += ch * ((7 + bps + 7) / 8);

    if (ch == 2) {
        payload = 2 * bps;
        payload += 1;
    } else {
        payload = ch * bps;
    }

    payload *= blocksize;
    payload += 7;
    payload /= 8;

    count += payload;
    count += 2;
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);

    if (ch == 2)
        goto stereo;

    count += (ch * bps * blocksize + 7) / 8;
    goto finish;

stereo:
    count += ((2 * bps + 1) * blocksize + 7) / 8;

finish:
    count += 2;
    return count;
}
