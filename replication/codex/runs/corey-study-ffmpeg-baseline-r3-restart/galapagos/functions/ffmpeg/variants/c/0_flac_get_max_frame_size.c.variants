
static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);
    count += (ch == 2)
        ? ((2 * bps + 1) * blocksize + 7) / 8
        : (ch * bps * blocksize + 7) / 8;
    return count + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);

    if (ch != 2)
        count += (ch * bps * blocksize + 7) / 8;
    else
        count += ((2 * bps + 1) * blocksize + 7) / 8;

    count += 2;
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);

    switch (ch) {
    case 2:
        count += ((2 * bps + 1) * blocksize + 7) / 8;
        break;
    default:
        count += (ch * bps * blocksize + 7) / 8;
        break;
    }

    return count + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count += ch * ((7 + bps + 7) / 8);

    if (ch == 2) {
        count += ((2 * bps + 1) * blocksize + 7) / 8;
        return count + 2;
    }

    count += (ch * bps * blocksize + 7) / 8;
    return count + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    int sample_bits;

    count += ch * ((7 + bps + 7) / 8);

    if (ch == 2)
        sample_bits = 2 * bps + 1;
    else
        sample_bits = ch * bps;

    count += (sample_bits * blocksize + 7) / 8;
    count += 2;
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    int payload;

    count += ch * ((7 + bps + 7) / 8);
    payload = (ch == 2) ? (2 * bps + 1) : (ch * bps);
    payload *= blocksize;
    payload += 7;
    payload /= 8;
    count += payload;
    count += 2;

    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count;
    int channel_header;

    channel_header = 7 + bps;
    channel_header += 7;
    channel_header /= 8;

    count = 16;
    count += ch * channel_header;

    if (ch == 2)
        count += ((2 * bps + 1) * blocksize + 7) / 8;
    else
        count += (ch * bps * blocksize + 7) / 8;

    return count + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    return ((16 + ch * ((7 + bps + 7) / 8))
            + ((ch == 2)
               ? ((2 * bps + 1) * blocksize + 7) / 8
               : (ch * bps * blocksize + 7) / 8))
           + 2;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count = count + ch * ((7 + bps + 7) / 8);

    if (ch == 2)
        goto stereo;

    count = count + (ch * bps * blocksize + 7) / 8;
    goto finish;

stereo:
    count = count + ((2 * bps + 1) * blocksize + 7) / 8;

finish:
    count = count + 2;
    return count;
}



static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;

    count += ch * ((7 + bps + 7) / 8);

    do {
        if (ch == 2) {
            count += ((2 * bps + 1) * blocksize + 7) / 8;
            break;
        }
        count += (ch * bps * blocksize + 7) / 8;
    } while (0);

    count += 2;
    return count;
}
