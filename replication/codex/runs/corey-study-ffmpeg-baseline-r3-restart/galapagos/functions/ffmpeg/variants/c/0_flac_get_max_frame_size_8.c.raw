static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    count = count + ch * ((7 + bps + 7) / 8);

    if (ch == 2)
        goto stereo;

    count = count + (ch * bps * blocksize + 7) / 8;
    goto finish;

stereo:
    count = count + ((2 * bps + 1) * blocksize + 7) / 8;

finish:
    count = count + 2;
    return count;
}
