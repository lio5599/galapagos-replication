static int vp5_adjust(int v, int t)
{
    int negative = v < 0;
    int magnitude = negative ? -v : v;
    int result;

    if (magnitude >= 2 * t)
        goto outside;
    if (magnitude > t)
        goto descending;

    result = magnitude;
    goto finish;

descending:
    result = 2 * t - magnitude;
    goto finish;

outside:
    result = t < 0 ? 2 * t : 0;

finish:
    return negative ? -result : result;
}
