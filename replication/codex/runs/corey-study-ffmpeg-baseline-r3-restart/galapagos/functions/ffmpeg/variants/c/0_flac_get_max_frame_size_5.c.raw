static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    int count = 16;
    int payload;

    count += ch * ((7 + bps + 7) / 8);
    payload = (ch == 2) ? (2 * bps + 1) : (ch * bps);
    payload *= blocksize;
    payload += 7;
    payload /= 8;
    count += payload;
    count += 2;

    return count;
}
