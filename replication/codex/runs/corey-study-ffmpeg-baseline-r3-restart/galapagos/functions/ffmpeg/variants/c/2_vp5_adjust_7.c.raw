static int vp5_adjust(int v, int t)
{
    int sign = v >> 31;
    int magnitude = (v ^ sign) - sign;
    int delta, mask, result;

    magnitude = magnitude < 2 * t ? magnitude : 0;
    delta = magnitude - t;
    mask = delta >> 31;
    result = t - ((delta ^ mask) - mask);

    return (result + sign) ^ sign;
}
