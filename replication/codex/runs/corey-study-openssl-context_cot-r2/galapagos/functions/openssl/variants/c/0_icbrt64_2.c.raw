static uint64_t icbrt64(uint64_t x)
{
    // A do-while loop performs the same descending sequence of shifts.
    // The final iteration uses shift zero before the loop terminates.
    // Trial subtraction and scaling are unchanged for every input.
    uint64_t r = 0;
    int s = 63;

    do {
        uint64_t b;
        r <<= 1;
        b = 3 * r * (r + 1) + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            ++r;
        }
        s -= 3;
    } while (s >= 0);

    return r << 12;
}
