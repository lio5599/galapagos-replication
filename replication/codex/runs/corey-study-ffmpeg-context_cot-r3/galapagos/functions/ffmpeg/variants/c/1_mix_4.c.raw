static int mix(int c0, int c1)
{
    // Compute the three truncated averages before scaling them.
    // This only introduces temporaries and preserves every arithmetic step.
    // In particular, negative red averages still truncate toward zero.
    int blue = 2 * (c0 & 0x001F) + (c1 & 0x001F);
    int green = (2 * (c0 & 0x03E0) + (c1 & 0x03E0)) >> 5;
    int red = 2 * (c0 >> 10) + (c1 >> 10);
    int blue_average = blue / 3;
    int green_average = green / 3;
    int red_average = red / 3;
    return red_average * 1024 + green_average * 32 + blue_average;
}
