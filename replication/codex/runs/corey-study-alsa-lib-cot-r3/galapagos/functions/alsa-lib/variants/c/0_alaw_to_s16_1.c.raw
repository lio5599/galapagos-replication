static int alaw_to_s16(unsigned char a_val)
{
	// Decode the seven magnitude bits before selecting the reference formula.
	// Values below 16 are segment zero and require no exponent shift.
	// Otherwise the shift is between zero and six, so it is always valid.
	// Applying the original sign bit preserves every positive and negative code.
	int decoded = a_val ^ 0x55;
	int code = decoded & 0x7f;
	int magnitude = (code < 16)
		? code * 16 + 8
		: ((code % 16) * 16 + 264) << (code / 16 - 1);

	return (decoded & 0x80) ? magnitude : -magnitude;
}
