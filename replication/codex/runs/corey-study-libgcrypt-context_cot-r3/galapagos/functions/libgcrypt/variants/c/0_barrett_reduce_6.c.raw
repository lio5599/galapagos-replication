int16_t barrett_reduce(int16_t a) {
  // Add ten whole quotient units before shifting, then subtract ten.
  // The biased numerator is nonnegative and fits in int32_t for all inputs.
  // Shifting therefore computes the same rounded quotient without a negative shift.
  // Preserve the reference's subsequent int16_t conversions.
  int16_t t;
  int32_t x = (int32_t)20159 * a + 33554432;
  t = ((x + 671088640) >> 26) - 10;
  t *= 3329;
  return a - t;
}
