
int16_t barrett_reduce(int16_t a) {
  int32_t t = ((int32_t)20159 * a + 33554432) >> 26;
  return (int16_t)((int32_t)a - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  int64_t t = ((int64_t)a * 20159 + 33554432) >> 26;
  return (int16_t)((int64_t)a - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  int32_t x = (int32_t)a * 20159 + 33554432;
  int32_t t = x >= 0
      ? x / 67108864
      : (x - 67108863) / 67108864;
  return (int16_t)((int32_t)a - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  uint32_t x = (uint32_t)((int32_t)a * 20159 + 704643072);
  int32_t t = (int32_t)(x >> 26) - 10;
  return (int16_t)((int32_t)a - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  int32_t x = a;
  int32_t product = x * 20480 - x * 320 - x;
  int32_t t = (product + 33554432) >> 26;
  return (int16_t)(x - t * 3329);
}



int16_t barrett_reduce(int16_t a) {
  int32_t r = (int32_t)a % 3329;
  if (r > 1664)
    r -= 3329;
  else if (r < -1664)
    r += 3329;
  return (int16_t)r;
}



int16_t barrett_reduce(int16_t a) {
  int32_t x = a;
  int32_t q = x / 3329;
  int32_t r = x - q * 3329;
  r -= (int32_t)(r > 1664) * 3329;
  r += (int32_t)(r < -1664) * 3329;
  return (int16_t)r;
}



int16_t barrett_reduce(int16_t a) {
  int32_t r = ((int32_t)a + 1664) % 3329;
  if (r < 0)
    r += 3329;
  return (int16_t)(r - 1664);
}



int16_t barrett_reduce(int16_t a) {
  int32_t x = a;
  int32_t magnitude = x < 0 ? -x : x;
  int32_t r = magnitude % 3329;
  if (r > 1664)
    r -= 3329;
  return (int16_t)(x < 0 ? -r : r);
}



int16_t barrett_reduce(int16_t a) {
  int32_t r = a;
  while (r > 1664)
    r -= 3329;
  while (r < -1664)
    r += 3329;
  return (int16_t)r;
}
