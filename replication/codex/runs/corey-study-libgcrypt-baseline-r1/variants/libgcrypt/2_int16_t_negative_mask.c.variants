
static int int16_t_negative_mask(int16_t x)
{
    return -(x < 0);
}



static int int16_t_negative_mask(int16_t x)
{
    return x < 0 ? -1 : 0;
}



static int int16_t_negative_mask(int16_t x)
{
    return (x >= 0) - 1;
}



static int int16_t_negative_mask(int16_t x)
{
    if (x < 0)
        return -1;
    return 0;
}



static int int16_t_negative_mask(int16_t x)
{
    return -(int)((uint16_t)x >> 15);
}



static int int16_t_negative_mask(int16_t x)
{
    return -(int)((uint16_t)x / 32768u);
}



static int int16_t_negative_mask(int16_t x)
{
    return -(((uint16_t)x & 0x8000u) != 0);
}



static int int16_t_negative_mask(int16_t x)
{
    return ((uint16_t)x < 0x8000u) - 1;
}



static int int16_t_negative_mask(int16_t x)
{
    int result = 0;
    if (x <= -1)
        --result;
    return result;
}



static int int16_t_negative_mask(int16_t x)
{
    return (int)(((long)x + 32768L) / 32768L) - 1;
}
