static unsigned int b64_char_to_byte(int c)
{
    // The reference maps Base64 characters to sextets and computes masked results for other integers.
    // Unsigned arithmetic preserves every defined reference computation, including unusual inputs.
    // Complementing each extracted byte is identical to XOR with 255.
    const unsigned int u = (unsigned int)c;
    const unsigned int a = (~((u - (unsigned int)'A') >> 8) & 255U) &
                           (~(((unsigned int)'Z' - u) >> 8) & 255U);
    const unsigned int b = (~((u - (unsigned int)'a') >> 8) & 255U) &
                           (~(((unsigned int)'z' - u) >> 8) & 255U);
    const unsigned int d = (~((u - (unsigned int)'0') >> 8) & 255U) &
                           (~(((unsigned int)'9' - u) >> 8) & 255U);
    const unsigned int p = ~((0U - (u ^ (unsigned int)'+')) >> 8) & 255U;
    const unsigned int s = ~((0U - (u ^ (unsigned int)'/')) >> 8) & 255U;
    const unsigned int x = (a & (u - (unsigned int)'A')) |
                           (b & (u - (unsigned int)'a' + 26U)) |
                           (d & (u - (unsigned int)'0' + 52U)) |
                           (p & 62U) | (s & 63U);
    const unsigned int z = ~((0U - x) >> 8) & 255U;
    const unsigned int n = ((0U - (u ^ (unsigned int)'A')) >> 8) & 255U;
    return x | (z & n);
}

static unsigned int b64_char_to_byte(int c)
{
    // De Morgan's law merges each pair of range masks before the shift.
    // Logical shifts distribute over OR, so every extracted mask bit is unchanged.
    // All arithmetic is unsigned, retaining the reference's behavior outside character inputs.
    const unsigned int u = (unsigned int)c;
    const unsigned int a = ~(((u - (unsigned int)'A') |
                              ((unsigned int)'Z' - u)) >> 8) & 255U;
    const unsigned int b = ~(((u - (unsigned int)'a') |
                              ((unsigned int)'z' - u)) >> 8) & 255U;
    const unsigned int d = ~(((u - (unsigned int)'0') |
                              ((unsigned int)'9' - u)) >> 8) & 255U;
    const unsigned int x =
        (a & (u - (unsigned int)'A')) |
        (b & (u - (unsigned int)'a' + 26U)) |
        (d & (u - (unsigned int)'0' + 52U)) |
        (~((0U - (u ^ (unsigned int)'+')) >> 8) & 62U) |
        (~((0U - (u ^ (unsigned int)'/')) >> 8) & 63U);
    return x | ((~((0U - x) >> 8) & 255U) &
                (((0U - (u ^ (unsigned int)'A')) >> 8) & 255U));
}

static unsigned int b64_char_to_byte(int c)
{
    // Extract rejection bits, then clear them from each candidate value.
    // Each candidate is restricted to the same low byte as in the reference.
    // The final rejection mask is preserved even for non-character integer inputs.
    const unsigned int u = (unsigned int)c;
    const unsigned int ra = (((u - (unsigned int)'A') |
                              ((unsigned int)'Z' - u)) >> 8) & 255U;
    const unsigned int rb = (((u - (unsigned int)'a') |
                              ((unsigned int)'z' - u)) >> 8) & 255U;
    const unsigned int rd = (((u - (unsigned int)'0') |
                              ((unsigned int)'9' - u)) >> 8) & 255U;
    const unsigned int rp = ((0U - (u ^ (unsigned int)'+')) >> 8) & 255U;
    const unsigned int rs = ((0U - (u ^ (unsigned int)'/')) >> 8) & 255U;
    const unsigned int x = ((u - (unsigned int)'A') & 255U & ~ra) |
                           ((u - (unsigned int)'a' + 26U) & 255U & ~rb) |
                           ((u - (unsigned int)'0' + 52U) & 255U & ~rd) |
                           (62U & ~rp) | (63U & ~rs);
    const unsigned int rz = ((0U - x) >> 8) & 255U;
    const unsigned int rn = ((0U - (u ^ (unsigned int)'A')) >> 8) & 255U;
    return x | (rn & ~rz);
}

static unsigned int b64_char_to_byte(int c)
{
    // For an extracted byte v, subtracting v from 255 equals XOR with 255.
    // This replaces mask complements without changing any of their eight bits.
    // Unsigned differences also preserve the reference on all its defined integer inputs.
    const unsigned int u = (unsigned int)c;
    const unsigned int a =
        (255U - (((u - (unsigned int)'A') >> 8) & 255U)) &
        (255U - ((((unsigned int)'Z' - u) >> 8) & 255U));
    const unsigned int b =
        (255U - (((u - (unsigned int)'a') >> 8) & 255U)) &
        (255U - ((((unsigned int)'z' - u) >> 8) & 255U));
    const unsigned int d =
        (255U - (((u - (unsigned int)'0') >> 8) & 255U)) &
        (255U - ((((unsigned int)'9' - u) >> 8) & 255U));
    const unsigned int p = 255U - (((0U - (u ^ (unsigned int)'+')) >> 8) & 255U);
    const unsigned int s = 255U - (((0U - (u ^ (unsigned int)'/')) >> 8) & 255U);
    const unsigned int x = (a & (u - (unsigned int)'A')) |
                           (b & (u - (unsigned int)'a' + 26U)) |
                           (d & (u - (unsigned int)'0' + 52U)) |
                           (p & 62U) | (s & 63U);
    const unsigned int z = 255U - (((0U - x) >> 8) & 255U);
    const unsigned int n = ((0U - (u ^ (unsigned int)'A')) >> 8) & 255U;
    return x | (z & n);
}

static unsigned int b64_char_to_byte(int c)
{
    // Accumulate the original five terms sequentially using a reusable mask.
    // Combining range differences before shifting is a bitwise De Morgan transformation.
    // The final mask remains unchanged, including its behavior on arbitrary integers.
    const unsigned int u = (unsigned int)c;
    unsigned int m;
    unsigned int x;
    m = ~(((u - (unsigned int)'A') | ((unsigned int)'Z' - u)) >> 8) & 255U;
    x = m & (u - (unsigned int)'A');
    m = ~(((u - (unsigned int)'a') | ((unsigned int)'z' - u)) >> 8) & 255U;
    x |= m & (u - (unsigned int)'a' + 26U);
    m = ~(((u - (unsigned int)'0') | ((unsigned int)'9' - u)) >> 8) & 255U;
    x |= m & (u - (unsigned int)'0' + 52U);
    m = ~((0U - (u ^ (unsigned int)'+')) >> 8) & 255U;
    x |= m & 62U;
    m = ~((0U - (u ^ (unsigned int)'/')) >> 8) & 255U;
    x |= m & 63U;
    m = ~((0U - x) >> 8) & 255U;
    return x | (m & (((0U - (u ^ (unsigned int)'A')) >> 8) & 255U));
}

static unsigned int b64_char_to_byte(int c)
{
    // Factor the common low-byte restriction out of the five-term OR.
    // Higher temporary bits cannot affect lower bits in these bitwise operations.
    // The final computation therefore matches even when c is not a character.
    const unsigned int u = (unsigned int)c;
    const unsigned int a = ~((u - (unsigned int)'A') >> 8) &
                           ~(((unsigned int)'Z' - u) >> 8) &
                           (u - (unsigned int)'A');
    const unsigned int b = ~((u - (unsigned int)'a') >> 8) &
                           ~(((unsigned int)'z' - u) >> 8) &
                           (u - (unsigned int)'a' + 26U);
    const unsigned int d = ~((u - (unsigned int)'0') >> 8) &
                           ~(((unsigned int)'9' - u) >> 8) &
                           (u - (unsigned int)'0' + 52U);
    const unsigned int p = ~((0U - (u ^ (unsigned int)'+')) >> 8) & 62U;
    const unsigned int s = ~((0U - (u ^ (unsigned int)'/')) >> 8) & 63U;
    const unsigned int x = (a | b | d | p | s) & 255U;
    return x | (~((0U - x) >> 8) &
                ((0U - (u ^ (unsigned int)'A')) >> 8) & 255U);
}

static unsigned int b64_char_to_byte(int c)
{
    // Use De Morgan's law to form the union of the five candidate terms.
    // Each term retains the exact original byte masks rather than character comparisons.
    // Thus negative and large inputs retain the reference's masked semantics.
    const unsigned int u = (unsigned int)c;
    const unsigned int a =
        (~(((u - (unsigned int)'A') | ((unsigned int)'Z' - u)) >> 8) & 255U) &
        (u - (unsigned int)'A');
    const unsigned int b =
        (~(((u - (unsigned int)'a') | ((unsigned int)'z' - u)) >> 8) & 255U) &
        (u - (unsigned int)'a' + 26U);
    const unsigned int d =
        (~(((u - (unsigned int)'0') | ((unsigned int)'9' - u)) >> 8) & 255U) &
        (u - (unsigned int)'0' + 52U);
    const unsigned int p = ~((0U - (u ^ (unsigned int)'+')) >> 8) & 62U;
    const unsigned int s = ~((0U - (u ^ (unsigned int)'/')) >> 8) & 63U;
    const unsigned int x = ~(~a & ~b & ~d & ~p & ~s);
    const unsigned int correction = ~((0U - x) >> 8) &
                                   ((0U - (u ^ (unsigned int)'A')) >> 8) & 255U;
    return ~(~x & ~correction);
}

static unsigned int b64_char_to_byte(int c)
{
    // Replace each accumulating OR with XOR of both operands and their intersection.
    // This bitwise identity does not assume that candidate terms are disjoint.
    // Exact byte masks preserve edge cases outside the ordinary Base64 alphabet.
    const unsigned int u = (unsigned int)c;
    const unsigned int a =
        (~(((u - (unsigned int)'A') | ((unsigned int)'Z' - u)) >> 8) & 255U) &
        (u - (unsigned int)'A');
    const unsigned int b =
        (~(((u - (unsigned int)'a') | ((unsigned int)'z' - u)) >> 8) & 255U) &
        (u - (unsigned int)'a' + 26U);
    const unsigned int d =
        (~(((u - (unsigned int)'0') | ((unsigned int)'9' - u)) >> 8) & 255U) &
        (u - (unsigned int)'0' + 52U);
    const unsigned int p = ~((0U - (u ^ (unsigned int)'+')) >> 8) & 62U;
    const unsigned int s = ~((0U - (u ^ (unsigned int)'/')) >> 8) & 63U;
    unsigned int x = a ^ b ^ (a & b);
    unsigned int correction;
    x = x ^ d ^ (x & d);
    x = x ^ p ^ (x & p);
    x = x ^ s ^ (x & s);
    correction = ~((0U - x) >> 8) &
                 ((0U - (u ^ (unsigned int)'A')) >> 8) & 255U;
    return x ^ correction ^ (x & correction);
}

static unsigned int b64_char_to_byte(int c)
{
    // Form unions using the unsigned identity a OR b equals a plus b minus a AND b.
    // The identity remains valid with modular arithmetic and overlapping mask bits.
    // Keeping all original mask bits preserves results for arbitrary defined inputs.
    const unsigned int u = (unsigned int)c;
    const unsigned int a =
        (~(((u - (unsigned int)'A') | ((unsigned int)'Z' - u)) >> 8) & 255U) &
        (u - (unsigned int)'A');
    const unsigned int b =
        (~(((u - (unsigned int)'a') | ((unsigned int)'z' - u)) >> 8) & 255U) &
        (u - (unsigned int)'a' + 26U);
    const unsigned int d =
        (~(((u - (unsigned int)'0') | ((unsigned int)'9' - u)) >> 8) & 255U) &
        (u - (unsigned int)'0' + 52U);
    const unsigned int p = ~((0U - (u ^ (unsigned int)'+')) >> 8) & 62U;
    const unsigned int s = ~((0U - (u ^ (unsigned int)'/')) >> 8) & 63U;
    unsigned int x = a + b - (a & b);
    unsigned int correction;
    x = x + d - (x & d);
    x = x + p - (x & p);
    x = x + s - (x & s);
    correction = ~((0U - x) >> 8) &
                 ((0U - (u ^ (unsigned int)'A')) >> 8) & 255U;
    return x + correction - (x & correction);
}

static unsigned int b64_char_to_byte(int c)
{
    // For unsigned values, division by 256 and remainder modulo 256 extract bits 8 through 15.
    // Replacing shifts and byte masks this way leaves the reference masks unchanged.
    // Unsigned subtraction preserves all defined reference results, including integer edge cases.
    const unsigned int u = (unsigned int)c;
    const unsigned int a =
        (255U ^ (((u - (unsigned int)'A') / 256U) % 256U)) &
        (255U ^ ((((unsigned int)'Z' - u) / 256U) % 256U));
    const unsigned int b =
        (255U ^ (((u - (unsigned int)'a') / 256U) % 256U)) &
        (255U ^ ((((unsigned int)'z' - u) / 256U) % 256U));
    const unsigned int d =
        (255U ^ (((u - (unsigned int)'0') / 256U) % 256U)) &
        (255U ^ ((((unsigned int)'9' - u) / 256U) % 256U));
    const unsigned int p = 255U ^ (((0U - (u ^ (unsigned int)'+')) / 256U) % 256U);
    const unsigned int s = 255U ^ (((0U - (u ^ (unsigned int)'/')) / 256U) % 256U);
    const unsigned int x = (a & (u - (unsigned int)'A')) |
                           (b & (u - (unsigned int)'a' + 26U)) |
                           (d & (u - (unsigned int)'0' + 52U)) |
                           (p & 62U) | (s & 63U);
    const unsigned int z = 255U ^ (((0U - x) / 256U) % 256U);
    const unsigned int n = ((0U - (u ^ (unsigned int)'A')) / 256U) % 256U;
    return x | (z & n);
}