static int b64_byte_to_char(unsigned int x)
{
    // Keep full shifted masks and truncate the combined result to one byte.
    // Complementing a full mask matches bytewise inversion in its low eight bits.
    // High bits cannot influence low bits through these bitwise operations.
    unsigned int a = (x - 26U) >> 8;
    unsigned int b = (x - 52U) >> 8;
    unsigned int c = (x - 62U) >> 8;
    unsigned int d = (0U - (x ^ 62U)) >> 8;
    unsigned int e = (0U - (x ^ 63U)) >> 8;
    unsigned int result =
        (a & (x + 'A')) |
        (~a & b & (x + ('a' - 26))) |
        (~b & c & (x + ('0' - 52))) |
        (~d & (unsigned int)'+') |
        (~e & (unsigned int)'/');
    return (int)(result & 0xFFU);
}
