static int64_t int_sin(int64_t a)
{
    int64_t a2, t, res;
    if (a < 0) a = 3294199 - a;
    a %= 2 * 3294199;
    if (a >= 3294199 * 3 / 2) a -= 2 * 3294199;
    if (a >= 3294199 / 2) a = 3294199 - a;
    a2 = (a * a) >> 20;
    res = a;
    t = -(a * a2 / 6291456);
    res += t;
    t = -(t * a2 / 20971520);
    res += t;
    t = -(t * a2 / 44040192);
    res += t;
    t = -(t * a2 / 75497472);
    res += t;
    return (res + 8) >> 4;
}
