static int weight(int i, int blen, int offset)
{
    int result = 8;
    int d = -1;
    int found = 0;
    if (i < 2*offset) {
        d = i;
        found = 1;
    } else if (i > blen-1 - 2*offset) {
        d = blen-1 - i;
        found = 1;
    }
    if (found) {
        if (offset == 1)
            result = (d == 0) ? 3 : 5;
        else
            result = 1 + (6*d + offset - 1) / (2*offset - 1);
    }
    return result;
}
