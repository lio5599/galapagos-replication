            r |= ((Ai >> (2 * i + 1)) & 1ULL) << (i + 32);
            r |= ((Ai >> (2 * i + 32)) & 1ULL) << (i + 16);
            r |= ((Ai >> (2 * i + 33)) & 1ULL) << (i + 48);
        }
        Ai = r;
    }
