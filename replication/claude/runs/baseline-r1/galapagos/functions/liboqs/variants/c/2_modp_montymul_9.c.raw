uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z, w;
    uint32_t d;

    z = (uint64_t)a * (uint64_t)b;
    w = ((uint64_t)((uint32_t)z * p0i) & (uint64_t)0x7FFFFFFF) * (uint64_t)p;
    z += w;
    d = (uint32_t)(z >> 31);
    d -= p;
    d += (uint32_t)(-(int64_t)(d >> 31)) & p;
    return d;
}
