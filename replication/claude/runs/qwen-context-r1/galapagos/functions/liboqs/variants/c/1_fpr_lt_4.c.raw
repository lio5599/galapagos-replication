int fpr_lt(uint64_t x, uint64_t y) {
    int64_t sx = *(int64_t *)&x;
    int64_t sy = *(int64_t *)&y;
    
    int sign_mask = (sx ^ sy) >> 63;
    int x_is_neg = sx >> 63;
    
    if (sign_mask) {
        return x_is_neg & 1;
    }
    
    int64_t diff = sx - sy;
    if (x_is_neg) {
        return (diff > 0) ? 1 : 0;
    }
    
    return (diff < 0) ? 1 : 0;
}
