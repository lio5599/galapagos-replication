static int b64_byte_to_char(unsigned int x)
{
    int result = 0;
    if (x <= 25)
        result = x + 'A';
    else if (x <= 51)
        result = x + 'a' - 26;
    else if (x <= 61)
        result = x + '0' - 52;
    else if (x == 62)
        result = '+';
    else if (x == 63)
        result = '/';
    return result;
}
