static int vp5_adjust(int v, int t)
{
    int s1 = v >> 31;
    int abs_v = (v ^ s1) - s1;
    int lt = abs_v < 2 * t;
    abs_v = lt ? abs_v : 0;
    int diff = abs_v - t;
    int s2 = diff >> 31;
    int abs_diff = (diff ^ s2) - s2;
    int result = t - abs_diff;
    result = (result ^ s1) - s1;
    return result;
}
