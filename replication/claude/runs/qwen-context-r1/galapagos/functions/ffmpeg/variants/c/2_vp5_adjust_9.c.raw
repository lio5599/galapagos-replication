static int vp5_adjust(int v, int t)
{
    int abs_v = v;
    int neg = 0;
    if (v < 0) {
        abs_v = -v;
        neg = 1;
    }
    if (abs_v >= 2 * t)
        abs_v = 0;
    int diff = abs_v - t;
    int abs_diff = diff;
    if (abs_diff < 0)
        abs_diff = -abs_diff;
    int result = t - abs_diff;
    if (neg)
        result = -result;
    return result;
}
