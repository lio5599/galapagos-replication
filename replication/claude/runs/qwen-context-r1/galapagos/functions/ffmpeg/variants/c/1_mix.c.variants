
static int mix(int c0, int c1)
{
    int blue = 2 * (c0 & 0x001F) + (c1 & 0x001F);
    int green = (2 * (c0 & 0x03E0) + (c1 & 0x03E0)) >> 5;
    int red = 2 * (c0 >> 10) + (c1 >> 10);
    return (red / 3) * 1024 + (green / 3) * 32 + (blue / 3);
}



static int mix(int c0, int c1)
{
    int b0 = c0 & 0x001F;
    int b1 = c1 & 0x001F;
    int g0 = (c0 & 0x03E0) >> 5;
    int g1 = (c1 & 0x03E0) >> 5;
    int r0 = c0 >> 10;
    int r1 = c1 >> 10;
    int blue = 2 * b0 + b1;
    int green = 2 * g0 + g1;
    int red = 2 * r0 + r1;
    return (red / 3) * 1024 + (green / 3) * 32 + (blue / 3);
}



static int mix(int c0, int c1)
{
    int blue = (c0 & 0x001F) * 2 + (c1 & 0x001F);
    int green = ((c0 & 0x03E0) * 2 + (c1 & 0x03E0)) >> 5;
    int red = (c0 >> 10) * 2 + (c1 >> 10);
    int r = red / 3;
    int g = green / 3;
    int b = blue / 3;
    return r * 1024 + g * 32 + b;
}



static int mix(int c0, int c1)
{
    int blue = (c0 & 31) * 2 + (c1 & 31);
    int green = ((c0 & 0x3E0) * 2 + (c1 & 0x3E0)) >> 5;
    int red = (c0 >> 10) * 2 + (c1 >> 10);
    return (red / 3) << 10 + (green / 3) << 5 + (blue / 3);
}



static int mix(int c0, int c1)
{
    int b0 = c0 & 0x1F;
    int b1 = c1 & 0x1F;
    int g0 = (c0 >> 5) & 0x1F;
    int g1 = (c1 >> 5) & 0x1F;
    int r0 = c0 >> 10;
    int r1 = c1 >> 10;
    int blue = b0 + b0 + b1;
    int green = g0 + g0 + g1;
    int red = r0 + r0 + r1;
    return (red / 3) * 1024 + (green / 3) * 32 + (blue / 3);
}



static int mix(int c0, int c1)
{
    int blue = 2 * (c0 & 0x1F) + (c1 & 0x1F);
    int green = 2 * ((c0 & 0x3E0) >> 5) + ((c1 & 0x3E0) >> 5);
    int red = 2 * (c0 >> 10) + (c1 >> 10);
    return (red / 3) * 1024 + (green / 3) * 32 + (blue / 3);
}



static int mix(int c0, int c1)
{
    int b0 = c0 & 0x001F;
    int b1 = c1 & 0x001F;
    int g0 = (c0 & 0x03E0) >> 5;
    int g1 = (c1 & 0x03E0) >> 5;
    int r0 = c0 >> 10;
    int r1 = c1 >> 10;
    int blue = b0 << 1 | (b1 & 1);
    blue += b0 + (b1 >> 1);
    int green = g0 << 1 | (g1 & 1);
    green += g0 + (g1 >> 1);
    int red = r0 << 1 | (r1 & 1);
    red += r0 + (r1 >> 1);
    return (red / 3) * 1024 + (green / 3) * 32 + (blue / 3);
}



static int mix(int c0, int c1)
{
    int blue = (c0 & 0x1F) + (c0 & 0x1F) + (c1 & 0x1F);
    int green = ((c0 & 0x3E0) + (c0 & 0x3E0) + (c1 & 0x3E0)) >> 5;
    int red = (c0 >> 10) + (c0 >> 10) + (c1 >> 10);
    return (red / 3) * 1024 + (green / 3) * 32 + (blue / 3);
}



static int mix(int c0, int c1)
{
    int b0 = c0 & 0x001F;
    int b1 = c1 & 0x001F;
    int g0 = (c0 & 0x03E0) >> 5;
    int g1 = (c1 & 0x03E0) >> 5;
    int r0 = c0 >> 10;
    int r1 = c1 >> 10;
    int blue = b0 * 2 + b1;
    int green = g0 * 2 + g1;
    int red = r0 * 2 + r1;
    int r = red / 3;
    int g = green / 3;
    int b = blue / 3;
    return (r << 10) + (g << 5) + b;
}



static int mix(int c0, int c1)
{
    int blue = 2 * (c0 & 0x001F) + (c1 & 0x001F);
    int green = (2 * (c0 & 0x03E0) + (c1 & 0x03E0)) >> 5;
    int red = 2 * (c0 >> 10) + (c1 >> 10);
    int result = 0;
    result += (red / 3) * 1024;
    result += (green / 3) * 32;
    result += (blue / 3);
    return result;
}
