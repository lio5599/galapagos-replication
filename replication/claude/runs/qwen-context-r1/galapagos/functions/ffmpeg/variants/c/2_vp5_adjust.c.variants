
static int vp5_adjust(int v, int t)
{
    int s1 = v >> 31;
    v ^= s1;
    v -= s1;
    v *= v < 2 * t;
    v -= t;
    int s2 = v >> 31;
    v ^= s2;
    v -= s2;
    v = t - v;
    v += s1;
    v ^= s1;
    return v;
}



static int vp5_adjust(int v, int t)
{
    int abs_v = (v >= 0) ? v : -v;
    int sign = (v < 0) ? 1 : 0;
    abs_v *= abs_v < 2 * t;
    abs_v -= t;
    int abs_diff = (abs_diff >= 0) ? abs_diff : -abs_diff;
    int result = t - abs_diff;
    if (sign)
        result = -result;
    return result;
}



static int vp5_adjust(int v, int t)
{
    int s1 = v >> 31;
    int abs_v = (v ^ s1) - s1;
    int clamped = (abs_v < 2 * t) ? abs_v : 0;
    int diff = clamped - t;
    int abs_diff = (diff ^ (diff >> 31)) - (diff >> 31);
    int result = t - abs_diff;
    result = (result ^ s1) - s1;
    return result;
}



static int vp5_adjust(int v, int t)
{
    int abs_v;
    int s1;
    if (v < 0) {
        abs_v = -v;
        s1 = 1;
    } else {
        abs_v = v;
        s1 = 0;
    }
    if (abs_v >= 2 * t)
        abs_v = 0;
    int diff = abs_v - t;
    int abs_diff;
    if (diff < 0)
        abs_diff = -diff;
    else
        abs_diff = diff;
    int result = t - abs_diff;
    if (s1)
        result = -result;
    return result;
}



static int vp5_adjust(int v, int t)
{
    int s1 = v >> 31;
    int abs_v = (v ^ s1) - s1;
    int mask = -(abs_v < 2 * t);
    abs_v &= mask;
    int diff = abs_v - t;
    int s2 = diff >> 31;
    int abs_diff = (diff ^ s2) - s2;
    int result = t - abs_diff;
    result = (result ^ s1) - s1;
    return result;
}



static int vp5_adjust(int v, int t)
{
    int abs_v = v;
    int neg = 0;
    if (v < 0) {
        abs_v = -v;
        neg = 1;
    }
    if (abs_v >= 2 * t)
        abs_v = 0;
    int diff = abs_v - t;
    if (diff < 0)
        diff = -diff;
    int result = t - diff;
    if (neg)
        result = -result;
    return result;
}



static int vp5_adjust(int v, int t)
{
    int s1 = v >> 31;
    int abs_v = (v ^ s1) - s1;
    int clamped = abs_v;
    if (clamped >= 2 * t)
        clamped = 0;
    int diff = clamped - t;
    int s2 = diff >> 31;
    int abs_diff = (diff ^ s2) - s2;
    int result = t - abs_diff;
    if (s1)
        result = -result;
    return result;
}



static int vp5_adjust(int v, int t)
{
    int abs_v;
    int sign_bit;
    if (v < 0) {
        abs_v = -v;
        sign_bit = 1;
    } else {
        abs_v = v;
        sign_bit = 0;
    }
    int clamped = (abs_v < 2 * t) ? abs_v : 0;
    int diff = clamped - t;
    int abs_diff = (diff < 0) ? -diff : diff;
    int result = t - abs_diff;
    if (sign_bit)
        result = -result;
    return result;
}



static int vp5_adjust(int v, int t)
{
    int s1 = v >> 31;
    int abs_v = (v ^ s1) - s1;
    int lt = abs_v < 2 * t;
    abs_v = lt ? abs_v : 0;
    int diff = abs_v - t;
    int s2 = diff >> 31;
    int abs_diff = (diff ^ s2) - s2;
    int result = t - abs_diff;
    result = (result ^ s1) - s1;
    return result;
}



static int vp5_adjust(int v, int t)
{
    int abs_v = v;
    int neg = 0;
    if (v < 0) {
        abs_v = -v;
        neg = 1;
    }
    if (abs_v >= 2 * t)
        abs_v = 0;
    int diff = abs_v - t;
    int abs_diff = diff;
    if (abs_diff < 0)
        abs_diff = -abs_diff;
    int result = t - abs_diff;
    if (neg)
        result = -result;
    return result;
}
