
static unsigned int iec958_parity(unsigned int data)
{
	unsigned int parity;
	int bit;

	data >>= 4;
	parity = 0;
	for (bit = 4; bit <= 30; bit++) {
		parity += data & 1;
		data >>= 1;
	}
	return (parity & 1);
}



static unsigned int iec958_parity(unsigned int data)
{
	unsigned int temp;
	unsigned int parity;
	int bit;

	temp = data >> 4;
	parity = 0;
	for (bit = 0; bit < 27; bit++) {
		if (temp & 1)
			parity ^= 1;
		temp >>= 1;
	}
	return parity;
}



static unsigned int iec958_parity(unsigned int data)
{
	unsigned int temp;
	unsigned int parity;
	int i;

	temp = data >> 4;
	parity = 0;
	for (i = 0; i < 27; i++) {
		parity += (temp & 1);
		temp >>= 1;
	}
	return (parity & 1);
}



