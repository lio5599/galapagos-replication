static unsigned int iec958_parity(unsigned int data)
{
	unsigned int temp;
	unsigned int p;
	int i;

	temp = data >> 4;
	p = 0;
	for (i = 0; i < 27; i++) {
		p ^= (temp & 1);
		temp >>= 1;
	}
	return p;
}



static unsigned int iec958_parity(unsigned int data)
{
	unsigned int val;
	unsigned int parity;
	int bit;

	val = data >> 4;
	parity = 0;
	for (bit = 0; bit < 27; bit++) {
		if (val & 1)
			parity++;
		val >>= 1;
	}
	return (parity & 1);
}



