
static int ctz(uint64_t in)
{
    int r = 0;
    uint64_t m = 0;
    int i;
    for (i = 0; i < 64; i++)
    {
        uint64_t b = (in >> i) & 1;
        m |= b;
        r += (int)((m ^ 1) & (b ^ 1));
    }
    return r;
}



static int ctz(uint64_t in)
{
    int r = 0;
    int found = 0;
    int i;
    for (i = 0; i < 64; i++)
    {
        int b = (int)((in >> i) & 1);
        if (b)
            found = 1;
        if (!found && !b)
            r++;
    }
    return r;
}



static int ctz(uint64_t in)
{
    int r = 0;
    int seen_one = 0;
    int i;
    for (i = 0; i < 64; i++)
    {
        int bit = (int)((in >> i) & 1);
        if (bit)
            seen_one = 1;
        if (!seen_one)
            r++;
    }
    return r;
}



static int ctz(uint64_t in)
{
    int r = 0;
    int i;
    for (i = 0; i < 64; i++)
    {
        if ((in & 1) == 0)
            r++;
        else
            break;
        in >>= 1;
    }
    return r;
}



static int ctz(uint64_t in)
{
    int r = 0;
    int i;
    for (i = 0; i < 64; i++)
    {
        if (in & 1)
            break;
        r++;
        in >>= 1;
    }
    return r;
}



static int ctz(uint64_t in)
{
    int r = 0;
    uint64_t mask = 1;
    int i;
    for (i = 0; i < 64; i++)
    {
        if ((in & mask) == 0)
            r++;
        else
            break;
        mask <<= 1;
    }
    return r;
}



static int ctz(uint64_t in)
{
    int r = 0;
    int i;
    for (i = 0; i < 64; i++)
    {
        if (!(in & ((uint64_t)1 << i)))
            r++;
        else
            break;
    }
    return r;
}



static int ctz(uint64_t in)
{
    int r = 0;
    int i;
    for (i = 0; i < 64; i++)
    {
        if ((in & ((uint64_t)1 << i)) == 0)
            r++;
        else
            break;
    }
    return r;
}



static int ctz(uint64_t in)
{
    int r = 0;
    uint64_t tmp = in;
    int i;
    for (i = 0; i < 64; i++)
    {
        if (tmp & 1)
            break;
        r++;
        tmp >>= 1;
    }
    return r;
}



static int ctz(uint64_t in)
{
    int r = 0;
    int i;
    for (i = 0; i < 64; i++)
    {
        if ((in >> i) & 1)
            break;
        r++;
    }
    return r;
}
