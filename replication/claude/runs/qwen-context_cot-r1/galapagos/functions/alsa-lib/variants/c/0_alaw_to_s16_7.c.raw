static int alaw_to_s16(unsigned char a_val)
// Combines magnitude and sign computation in single expression.
// Uses ternary operator for both magnitude and sign.
// Segment logic remains unchanged for correctness.
// XOR 0x55 prepares A-law code for decoding.
// All inputs produce identical results to reference.
{
	int t;
	int seg;
	a_val ^= 0x55;
	t = a_val & 0x7f;
	if (t < 16)
		t = (t << 4) + 8;
	else {
		seg = (t >> 4) & 0x07;
		t = ((t & 0x0f) << 4) + 0x108;
		t <<= seg - 1;
	}
	return (a_val & 0x80) ? t : -t;
}
