
static unsigned int iec958_parity(unsigned int data)
{
	// Reference computes parity of bits 4-30 of input (27 bits).
	// It shifts right by 4, then counts set bits in positions 0-26
	// (originally 4-30), returning the LSB of the count.
	unsigned int parity;
	int bit;

	data >>= 4;
	parity = 0;
	for (bit = 4; bit <= 30; bit++) {
		if (data & 1)
			parity++;
		data >>= 1;
	}
	return (parity & 1);
}

static unsigned int iec958_parity(unsigned int data)
{
	// Count set bits in bits 4-30 by iterating through each bit position.
	// Shift data right by 4 to align bit 4 to position 0.
	// Loop 27 times (bits 4 to 30 inclusive) checking LSB each time.
	unsigned int temp = data >> 4;
	unsigned int count = 0;
	int i;
	for (i = 0; i < 27; i++) {
		count += temp & 1;
		temp >>= 1;
	}
	return count & 1;
}

static unsigned int iec958_parity(unsigned int data)
{
	// Extract bits 4-30 using mask and count parity via XOR accumulation.
	// Mask 0x7FFFFF00 isolates bits 8-31, but we need bits 4-30.
	// Shift right by 4 to get bits 4-30 into positions 0-26, then count.
	unsigned int temp = (data >> 4) & 0x1FFFFFF;
	unsigned int parity = 0;
	while (temp) {
		parity ^= temp & 1;
		temp >>= 1;
	}
	return parity;
}

static unsigned int iec958_parity(unsigned int data)
{
	// Use Brian Kernighan's algorithm to count set bits in bits 4-30.
	// Shift right by 4, mask to 27 bits, then clear lowest set bit each iteration.
	unsigned int temp = (data >> 4) & 0x1FFFFFF;
	unsigned int count = 0;
	while (temp) {
		temp &= temp - 1;
		count++;
	}
	return count & 1;
}

static unsigned int iec958_parity(unsigned int data)
{
	// Compute parity by XORing all bits in the range 4-30.
	// Shift right by 4 to align, then XOR each bit into accumulator.
	unsigned int temp = data >> 4;
	unsigned int parity = 0;
	int i;
	for (i = 0; i < 27; i++) {
		parity ^= (temp >> i) & 1;
	}
	return parity;
}

static unsigned int iec958_parity(unsigned int data)
{
	// Fold the 27-bit value (bits 4-30) using XOR folding to compute parity.
	// Shift right by 4, mask to 27 bits, then repeatedly XOR halves.
	unsigned int temp = (data >> 4) & 0x1FFFFFF;
	temp ^= temp >> 16;
	temp ^= temp >> 8;
	temp ^= temp >> 4;
	temp ^= temp >> 2;
	temp ^= temp >> 1;
	return temp & 1;
}

static unsigned int iec958_parity(unsigned int data)
{
	// Use a lookup table approach conceptually by computing parity via
	// repeated XOR of shifted values to reduce 27 bits to 1 bit.
	unsigned int temp = (data >> 4) & 0x1FFFFFF;
	temp = temp ^ (temp >> 1);
	temp = temp ^ (temp >> 2);
	temp = temp ^ (temp >> 4);
	temp = temp ^ (temp >> 8);
	temp = temp ^ (temp >> 16);
	return temp & 1;
}

static unsigned int iec958_parity(unsigned int data)
{
	// Count bits by processing 27 bits individually using bit extraction.
	// For each bit position 0-26 in the shifted value, add to count.
	unsigned int shifted = data >> 4;
	unsigned int count = 0;
	int i;
	for (i = 0; i < 27; i++) {
		if ((shifted >> i) & 1) {
			count++;
		}
	}
	return count & 1;
}

static unsigned int iec958_parity(unsigned int data)
{
	// Compute parity using a loop that processes bits from MSB to LSB.
	// Shift right by 4, then check each of 27 bits by masking with 1.
	unsigned int temp = data >> 4;
	unsigned int parity = 0;
	int i;
	for (i = 26; i >= 0; i--) {
		if ((temp >> i) & 1) {
			parity++;
		}
	}
	return parity & 1;
}

static unsigned int iec958_parity(unsigned int data)
{
	// Use XOR-based parity computation on the extracted 27-bit field.
	// Shift right by 4 to isolate bits 4-30 into positions 0-26.
	// XOR all bits together: parity is 1 if odd number of bits set.
	unsigned int temp = (data >> 4) & 0x1FFFFFF;
	unsigned int result = 0;
	int i;
	for (i = 0; i < 27; i++) {
		result ^= (temp >> i) & 1;
	}
	return result;
}
