int fpr_lt(uint64_t x, uint64_t y) {
    // Reinterpret as signed integers and handle cases.
    // Cast to int64_t to access sign bit naturally.
    // Handle sign differences and magnitude comparisons.
    int64_t sx = *(int64_t *)&x;
    int64_t sy = *(int64_t *)&y;
    int xs = sx < 0;
    int ys = sy < 0;
    if (xs != ys) return xs;
    if (xs) return sx > sy;
    return sx < sy;
}
