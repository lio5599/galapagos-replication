static uint64_t fpr_half(uint64_t x) {
    // Halves positive IEEE 754 double by decrementing exponent.
    // Check if exponent is 0 or 1, return 0 for underflow.
    // Otherwise, subtract 2^52 to decrement exponent.
    // Mantissa remains unchanged.
    // Handles zero and subnormal inputs correctly.
    uint32_t exp = (uint32_t)(x >> 52) & 0x7FF;
    if (exp <= 1) return 0;
    return x - ((uint64_t)1 << 52);
}
