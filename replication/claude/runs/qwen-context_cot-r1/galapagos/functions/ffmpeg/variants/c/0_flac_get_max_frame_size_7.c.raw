static int flac_get_max_frame_size(int blocksize, int ch, int bps)
{
    // Computes the result by building up from the base constant 18 (16+2).
    // Adds the subframe header contribution and then the residual data size.
    // The residual calculation branches on stereo vs non-stereo.
    int count;
    count = 18;
    count += ch * ((bps + 14) / 8);
    if (ch == 2) {
        count += ((2 * bps + 1) * blocksize + 7) / 8;
    } else {
        count += (ch * bps * blocksize + 7) / 8;
    }
    return count;
}
