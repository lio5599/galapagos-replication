static int mix(int c0, int c1)
{
    // Use temporary variables for clarity of channel operations.
    // Extract, weight, average, and repack each RGB channel.
    // Integer division truncates, matching reference behavior.
    int c0_r = c0 >> 10, c1_r = c1 >> 10;
    int c0_g = (c0 >> 5) & 0x3F, c1_g = (c1 >> 5) & 0x3F;
    int c0_b = c0 & 0x1F, c1_b = c1 & 0x1F;
    int r = (2 * c0_r + c1_r) / 3;
    int g = (2 * c0_g + c1_g) / 3;
    int b = (2 * c0_b + c1_b) / 3;
    return (r << 10) | (g << 5) | b;
}
