static int b64_byte_to_urlsafe_char(unsigned int x)
{
    // Reference computes URL-safe base64 char for x in [0,63]:
    // 0-25 -> 'A'+x, 26-51 -> 'a'+(x-26), 52-61 -> '0'+(x-52), 62 -> '-', 63 -> '_'
    // Uses branchless arithmetic with overflow checks via >> 8 masking
    if (x < 26) return 'A' + x;
    if (x < 52) return 'a' + (x - 26);
    if (x < 62) return '0' + (x - 52);
    if (x == 62) return '-';
    if (x == 63) return '_';
    return 0; // Undefined behavior for x >= 64 in reference
}
