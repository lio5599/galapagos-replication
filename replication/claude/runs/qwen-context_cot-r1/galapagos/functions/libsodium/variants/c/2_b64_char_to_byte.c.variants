        ['0'] = 52, ['1'] = 53, ['2'] = 54, ['3'] = 55, ['4'] = 56, ['5'] = 57, ['6'] = 58, ['7'] = 59,
        ['8'] = 60, ['9'] = 61,
        ['+'] = 62, ['/'] = 63
    };
    return table[(unsigned char)c];
}
static unsigned int b64_char_to_byte(int c)
// Branchless implementation using conditional expressions (ternary operators).
// Checks ranges in order. If char is in range, computes offset, else 0.
// Equivalent to reference as it covers all cases and returns 0 for invalid.
{
    unsigned int result = 0;
    if (c >= 'A' && c <= 'Z')
        result = (unsigned int)(c - 'A');
    else if (c >= 'a' && c <= 'z')
        result = (unsigned int)(c - 'a' + 26);
    else if (c >= '0' && c <= '9')
        result = (unsigned int)(c - '0' + 52);
    else if (c == '+')
        result = 62;
    else if (c == '/')
        result = 63;
    return result;
}
static unsigned int b64_char_to_byte(int c)
// Uses arithmetic to determine validity and value.
// Calculates potential value for each group, masked by validity.
// Validity is determined by checking if c is within the character range.
// Equivalent because masks ensure only one group contributes.
{
    unsigned int u = (unsigned int)c;
    unsigned int val = 0;
    unsigned int mask_upper = ((u >= 'A') & (u <= 'Z')) ? 0xFFFFFFFF : 0;
    unsigned int mask_lower = ((u >= 'a') & (u <= 'z')) ? 0xFFFFFFFF : 0;
    unsigned int mask_digit = ((u >= '0') & (u <= '9')) ? 0xFFFFFFFF : 0;
    unsigned int mask_plus  = (u == '+') ? 0xFFFFFFFF : 0;
    unsigned int mask_slash = (u == '/') ? 0xFFFFFFFF : 0;
    
    val |= mask_upper & (u - 'A');
    val |= mask_lower & (u - 'a' + 26);
    val |= mask_digit & (u - '0' + 52);
    val |= mask_plus & 62;
    val |= mask_slash & 63;
    return val;
}
static unsigned int b64_char_to_byte(int c)
// Implements logic using a helper array for offsets and ranges.
// Iterates through ranges to find match. Returns 0 if no match.
// Equivalent as it checks all valid base64 character sets.
{
    // Ranges: start, end, offset
    struct { char start; char end; unsigned int offset; } ranges[] = {
        {'A', 'Z', 0},
        {'a', 'z', 26},
        {'0', '9', 52},
        {'+', '+', 62},
        {'/', '/', 63}
    };
    int i;
    for (i = 0; i < 5; i++) {
        if (c >= ranges[i].start && c <= ranges[i].end) {
            return (unsigned int)(c - ranges[i].start + ranges[i].offset);
        }
    }
    return 0;
}
static unsigned int b64_char_to_byte(int c)
// Uses bitwise logic to create masks for each range.
// Similar to reference but with clearer variable names for masks.
// Combines masked values with OR. Invalid chars produce 0 masks.
{
    unsigned int u = (unsigned int)c;
    // Mask is all 1s if condition true, 0 otherwise
    unsigned int m1 = (u >= 'A' && u <= 'Z') ? ~0U : 0;
    unsigned int m2 = (u >= 'a' && u <= 'z') ? ~0U : 0;
    unsigned int m3 = (u >= '0' && u <= '9') ? ~0U : 0;
    unsigned int m4 = (u == '+') ? ~0U : 0;
    unsigned int m5 = (u == '/') ? ~0U : 0;
    
    unsigned int v1 = m1 & (u - 'A');
    unsigned int v2 = m2 & (u - 'a' + 26);
    unsigned int v3 = m3 & (u - '0' + 52);
    unsigned int v4 = m4 & 62;
    unsigned int v5 = m5 & 63;
    
    return v1 | v2 | v3 | v4 | v5;
}