int16_t barrett_reduce(int16_t a) {
  // Modular reduction modulo 3329 via Barrett method
  // Precomputed v enables replacing division with multiplication and shift
  // int32_t cast ensures 32-bit arithmetic for intermediate product
  // Rounding via addition of 2^25 before shift ensures correct quotient
  // Final result is a mod 3329 for all defined inputs
  int16_t t;
  const int16_t v = ((1<<26) + 3329/2)/3329;
  t = ((int32_t)v*a + (1<<25)) >> 26;
  t *= 3329;
  return a - t;
}
