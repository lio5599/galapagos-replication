
static int int16_t_negative_mask (int16_t x)
{
  return x < 0 ? -1 : 0;
}



static int int16_t_negative_mask (int16_t x)
{
  return -(x < 0);
}



static int int16_t_negative_mask (int16_t x)
{
  int v = x;
  return v >> 31;
}



static int int16_t_negative_mask (int16_t x)
{
  return x >> 15;
}



static int int16_t_negative_mask (int16_t x)
{
  uint16_t u = x;
  return (u & 0x8000u) ? -1 : 0;
}



static int int16_t_negative_mask (int16_t x)
{
  uint16_t u = x;
  unsigned int masked = u & 0x8000u;
  masked >>= 15;
  return -(int) masked;
}



static int int16_t_negative_mask (int16_t x)
{
  if (x < 0) {
    return -1;
  }
  return 0;
}



static int int16_t_negative_mask (int16_t x)
{
  uint16_t u = x;
  return -(int) (u >= 0x8000u);
}



static int int16_t_negative_mask (int16_t x)
{
  uint16_t u = x;
  unsigned int w = u;
  return (int) (0u - (w >> 15));
}



static int int16_t_negative_mask (int16_t x)
{
  int result = 0;
  if (x < 0) {
    result = -1;
  }
  return result;
}
