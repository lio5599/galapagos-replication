
// Implementation 1
static int ctz(uint64_t in)
{
 int i;

 for (i = 0; i < 64; i++)
 {
  if ((in >> i) & 1)
   break;
 }

 return i;
}

// Implementation 2
static int ctz(uint64_t in)
{
 int r = 0;

 while (r < 64 && !(in & 1))
 {
  in >>= 1;
  r++;
 }

 return r;
}

// Implementation 3
static int ctz(uint64_t in)
{
 int r = 0;

 if (in == 0)
  return 64;

 if ((in & 0xFFFFFFFFULL) == 0)
 {
  r += 32;
  in >>= 32;
 }
 if ((in & 0xFFFFULL) == 0)
 {
  r += 16;
  in >>= 16;
 }
 if ((in & 0xFFULL) == 0)
 {
  r += 8;
  in >>= 8;
 }
 if ((in & 0xFULL) == 0)
 {
  r += 4;
  in >>= 4;
 }
 if ((in & 0x3ULL) == 0)
 {
  r += 2;
  in >>= 2;
 }
 if ((in & 0x1ULL) == 0)
 {
  r += 1;
 }

 return r;
}

// Implementation 4
static int ctz(uint64_t in)
{
 int r = 0, s;
 uint64_t x = in;

 s = ((x & 0xFFFFFFFFULL) == 0) << 5;
 x >>= s;
 r += s;
 s = ((x & 0xFFFFULL) == 0) << 4;
 x >>= s;
 r += s;
 s = ((x & 0xFFULL) == 0) << 3;
 x >>= s;
 r += s;
 s = ((x & 0xFULL) == 0) << 2;
 x >>= s;
 r += s;
 s = ((x & 0x3ULL) == 0) << 1;
 x >>= s;
 r += s;
 s = ((x & 0x1ULL) == 0);
 r += s;
 r += (in == 0);

 return r;
}

// Implementation 5
static int ctz(uint64_t in)
{
 uint64_t y = (in & (~in + 1)) - 1;

 y = y - ((y >> 1) & 0x5555555555555555ULL);
 y = (y & 0x3333333333333333ULL) + ((y >> 2) & 0x3333333333333333ULL);
 y = (y + (y >> 4)) & 0x0F0F0F0F0F0F0F0FULL;

 return (int)((y * 0x0101010101010101ULL) >> 56);
}

// Implementation 6
static int ctz(uint64_t in)
{
 uint64_t y = ~in & (in - 1);
 int i, r = 0;

 for (i = 0; i < 64; i++)
 {
  r += (int)((y >> i) & 1);
 }

 return r;
}

// Implementation 7
static int ctz(uint64_t in)
{
 uint64_t y = in & (~in + 1);
 int r = 64;

 if (y)
  r -= 1;
 if (y & 0x00000000FFFFFFFFULL)
  r -= 32;
 if (y & 0x0000FFFF0000FFFFULL)
  r -= 16;
 if (y & 0x00FF00FF00FF00FFULL)
  r -= 8;
 if (y & 0x0F0F0F0F0F0F0F0FULL)
  r -= 4;
 if (y & 0x3333333333333333ULL)
  r -= 2;
 if (y & 0x5555555555555555ULL)
  r -= 1;

 return r;
}

// Implementation 8
static int ctz(uint64_t in)
{
 uint64_t y = in & (~in + 1);
 int r = 0;

 r |= ((y & 0xAAAAAAAAAAAAAAAAULL) != 0);
 r |= ((y & 0xCCCCCCCCCCCCCCCCULL) != 0) << 1;
 r |= ((y & 0xF0F0F0F0F0F0F0F0ULL) != 0) << 2;
 r |= ((y & 0xFF00FF00FF00FF00ULL) != 0) << 3;
 r |= ((y & 0xFFFF0000FFFF0000ULL) != 0) << 4;
 r |= ((y & 0xFFFFFFFF00000000ULL) != 0) << 5;
 r |= (in == 0) << 6;

 return r;
}

// Implementation 9
static int ctz(uint64_t in)
{
 int i, r = 64;

 for (i = 63; i >= 0; i--)
 {
  if ((in >> i) & 1)
   r = i;
 }

 return r;
}

// Implementation 10
static int ctz(uint64_t in)
{
 uint64_t mask = 1;
 int r = 0;

 while (mask != 0 && (in & mask) == 0)
 {
  mask <<= 1;
  r++;
 }

 return r;
}
