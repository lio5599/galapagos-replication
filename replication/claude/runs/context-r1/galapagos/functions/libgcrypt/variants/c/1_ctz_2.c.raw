int ctz(uint64_t in)
{
 int r = 0;

 if (in == 0)
  return 64;

 if ((in & 0xFFFFFFFFULL) == 0)
 {
  r += 32;
  in >>= 32;
 }
 if ((in & 0xFFFFULL) == 0)
 {
  r += 16;
  in >>= 16;
 }
 if ((in & 0xFFULL) == 0)
 {
  r += 8;
  in >>= 8;
 }
 if ((in & 0xFULL) == 0)
 {
  r += 4;
  in >>= 4;
 }
 if ((in & 0x3ULL) == 0)
 {
  r += 2;
  in >>= 2;
 }
 if ((in & 0x1ULL) == 0)
 {
  r += 1;
 }

 return r;
}
