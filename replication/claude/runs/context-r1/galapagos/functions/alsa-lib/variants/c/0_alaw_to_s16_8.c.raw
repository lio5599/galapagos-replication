static int alaw_to_s16(unsigned char a_val)
{
	int x = a_val ^ 0x55;
	int t = x & 0x7f;

	if (x & 0x80) {
		if (t < 16)
			return (t << 4) + 8;
		return (((t & 0x0f) << 4) + 0x108) << (((t >> 4) & 0x07) - 1);
	}
	if (t < 16)
		return -((t << 4) + 8);
	return -((((t & 0x0f) << 4) + 0x108) << (((t >> 4) & 0x07) - 1));
}
