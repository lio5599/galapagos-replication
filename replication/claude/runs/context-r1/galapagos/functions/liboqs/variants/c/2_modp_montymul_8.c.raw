uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z, w;
    uint32_t r, d, m;

    z = (uint64_t)a * (uint64_t)b;
    w = ((z * p0i) & (uint64_t)0x7FFFFFFF) * p;
    r = (uint32_t)((z + w) >> 31);
    d = r + ~p + 1u;
    m = (uint32_t)((int32_t)d >> 31);
    return d ^ ((d ^ r) & m);
}
