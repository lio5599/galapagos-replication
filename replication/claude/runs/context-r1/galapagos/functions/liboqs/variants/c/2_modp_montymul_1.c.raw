uint32_t modp_montymul(uint32_t a, uint32_t b, uint32_t p, uint32_t p0i) {
    uint64_t z, w;
    uint32_t d;

    z = (uint64_t)a * (uint64_t)b;
    w = (uint64_t)(((uint32_t)z * p0i) & 0x7FFFFFFFu) * (uint64_t)p;
    d = (uint32_t)((z + w) >> 31) - p;
    d += p & (uint32_t)((int32_t)d >> 31);
    return d;
}
