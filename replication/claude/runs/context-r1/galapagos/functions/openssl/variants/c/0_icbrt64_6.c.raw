static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    int s;

    for (s = 63; s >= 0; s -= 3) {
        uint64_t b;
        uint64_t mask;

        r <<= 1;
        b = 3 * r * (r + 1) + 1;
        mask = (uint64_t)0 - (uint64_t)((x >> s) >= b);
        x -= (b << s) & mask;
        r += mask & 1;
    }
    return r << 12;
}
