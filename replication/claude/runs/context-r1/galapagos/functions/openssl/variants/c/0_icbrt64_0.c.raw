static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    uint64_t b;
    int s = 63;

    while (s >= 0) {
        r = r * 2;
        b = 3 * r * (r + 1) + 1;
        if ((x >> s) >= b) {
            x = x - (b << s);
            r = r + 1;
        }
        s = s - 3;
    }
    return r << 12;
}
