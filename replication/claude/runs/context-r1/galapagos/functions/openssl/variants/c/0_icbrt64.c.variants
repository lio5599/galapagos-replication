
static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    uint64_t b;
    int s = 63;

    while (s >= 0) {
        r = r * 2;
        b = 3 * r * (r + 1) + 1;
        if ((x >> s) >= b) {
            x = x - (b << s);
            r = r + 1;
        }
        s = s - 3;
    }
    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    int i;

    for (i = 0; i < 22; i++) {
        int s = 63 - 3 * i;
        uint64_t b;

        r <<= 1;
        b = 3 * r * r + 3 * r + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            r += 1;
        }
    }
    return r * 4096;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    int s;

    for (s = 63; s >= 0; s -= 3) {
        uint64_t p;
        uint64_t b;

        r += r;
        p = r * (r + 1);
        b = (p << 1) + p + 1;
        if (b <= (x >> s)) {
            x -= b << s;
            r++;
        }
    }
    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    uint64_t r2 = 0;
    int s;

    for (s = 63; s >= 0; s -= 3) {
        uint64_t b;

        r <<= 1;
        r2 <<= 2;
        b = 3 * r2 + 3 * r + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            r2 += 2 * r + 1;
            r += 1;
        }
    }
    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    uint64_t bit = (uint64_t)1 << 21;

    while (bit != 0) {
        uint64_t c = r | bit;

        if (c <= 2642245 && c * c * c <= x) {
            r = c;
        }
        bit >>= 1;
    }
    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t lo = 0;
    uint64_t hi = 2642246;

    while (hi - lo > 1) {
        uint64_t mid = lo + (hi - lo) / 2;

        if (mid * mid * mid <= x) {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    return lo << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    int s;

    for (s = 63; s >= 0; s -= 3) {
        uint64_t b;
        uint64_t mask;

        r <<= 1;
        b = 3 * r * (r + 1) + 1;
        mask = (uint64_t)0 - (uint64_t)((x >> s) >= b);
        x -= (b << s) & mask;
        r += mask & 1;
    }
    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    uint64_t rem = 0;
    int s;

    for (s = 63; s >= 0; s -= 3) {
        uint64_t b;

        rem = (rem << 3) | ((x >> s) & 7);
        r <<= 1;
        b = 3 * r * (r + 1) + 1;
        if (rem >= b) {
            rem -= b;
            r++;
        }
    }
    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    int s = 66;

    do {
        uint64_t b;

        s -= 3;
        r <<= 1;
        b = 3 * r * (r + 1) + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            r |= 1;
        }
    } while (s != 0);
    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    int s;

    for (s = 63; s >= 0; s -= 3) {
        uint64_t d = r * 2;
        uint64_t b = 3 * d * (d + 1) + 1;
        int taken = (x >> s) >= b;

        x = taken ? x - (b << s) : x;
        r = d + (uint64_t)taken;
    }
    return r * 4096;
}
