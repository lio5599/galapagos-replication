static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    int i;

    for (i = 0; i < 22; i++) {
        int s = 63 - 3 * i;
        uint64_t b;

        r <<= 1;
        b = 3 * r * r + 3 * r + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            r += 1;
        }
    }
    return r * 4096;
}
