static int b64_byte_to_urlsafe_char(unsigned int x)
{
    unsigned int a = ((x - 26U) << 16) >> 24;
    unsigned int b = ((x - 52U) << 16) >> 24;
    unsigned int c = ((x - 62U) << 16) >> 24;
    unsigned int d = ((0U - (x ^ 62U)) << 16) >> 24;
    unsigned int e = ((0U - (x ^ 63U)) << 16) >> 24;
    unsigned int r = 0U;

    r |= (e ^ 0xFFU) & 95U;
    r |= (d ^ 0xFFU) & 45U;
    r |= (b ^ 0xFFU) & c & (x - 4U);
    r |= (a ^ 0xFFU) & b & (x + 71U);
    r |= a & (x + 65U);
    return (int) r;
}
