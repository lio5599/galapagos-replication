static int b64_byte_to_char(unsigned int x)
{
    unsigned int m26 = ((x + 0xFFFFFFE6U) >> 8) & 0xFFU;
    unsigned int m52 = ((x + 0xFFFFFFCCU) >> 8) & 0xFFU;
    unsigned int m62 = ((x + 0xFFFFFFC2U) >> 8) & 0xFFU;
    unsigned int n62 = (0U - (x ^ 0x3EU)) >> 8;
    unsigned int n63 = (0U - (x ^ 0x3FU)) >> 8;
    return (int) ((m26 & (x + 0x41U)) | ((m26 ^ 0xFFU) & m52 & (x + 0x47U)) | ((m52 ^ 0xFFU) & m62 & (x + 0xFFFFFFFCU)) | (~n62 & 0x2BU) | (~n63 & 0x2FU));
}
