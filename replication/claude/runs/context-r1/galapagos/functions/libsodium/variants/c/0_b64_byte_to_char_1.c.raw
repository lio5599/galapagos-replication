static int b64_byte_to_char(unsigned int x)
{
    unsigned int m26 = ((x - 26U) & 0xFF00U) >> 8;
    unsigned int m52 = ((x - 52U) & 0xFF00U) >> 8;
    unsigned int m62 = ((x - 62U) & 0xFF00U) >> 8;
    unsigned int e62 = ((~(0U - (x ^ 62U))) >> 8) & 0xFFU;
    unsigned int e63 = ((~(0U - (x ^ 63U))) >> 8) & 0xFFU;
    return (int) ((m26 & (x + 'A')) | (~m26 & m52 & (x + 71U)) | (~m52 & m62 & (x - 4U)) | (e62 & '+') | (e63 & '/'));
}
