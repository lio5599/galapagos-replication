static unsigned int b64_char_to_byte(int c)
{
    const unsigned int u = (unsigned int) c;
    const unsigned int x =
        ((((u - 65U) & 0xFF00U) ^ 0xFF00U) >> 8 & ((((90U - u) & 0xFF00U) ^ 0xFF00U) >> 8) & (u - 65U)) |
        ((((u - 97U) & 0xFF00U) ^ 0xFF00U) >> 8 & ((((122U - u) & 0xFF00U) ^ 0xFF00U) >> 8) & (u - 71U)) |
        ((((u - 48U) & 0xFF00U) ^ 0xFF00U) >> 8 & ((((57U - u) & 0xFF00U) ^ 0xFF00U) >> 8) & (u + 4U)) |
        ((((0U - (u ^ 43U)) & 0xFF00U) ^ 0xFF00U) >> 8 & 62U) |
        ((((0U - (u ^ 47U)) & 0xFF00U) ^ 0xFF00U) >> 8 & 63U);

    return x | ((((0U - x) & 0xFF00U) ^ 0xFF00U) >> 8 & (((0U - (u ^ 65U)) & 0xFF00U) >> 8));
}
