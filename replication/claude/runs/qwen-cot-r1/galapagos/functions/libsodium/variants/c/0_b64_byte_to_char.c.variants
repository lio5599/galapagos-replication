
static int b64_byte_to_char(unsigned int x)
// Reference: maps 0-25 to 'A'-'Z', 26-51 to 'a'-'z', 52-61 to '0'-'9', 62 to '+', 63 to '/'
// Uses arithmetic masking to select ranges without branches
// Each term is non-zero only when x falls in its specific range
// The mask ((x-N)>>8)&0xFF is 0xFF when x<N and 0x00 when x>=N (for small x)
// This creates a branchless lookup table via arithmetic
{
    return (((((unsigned int) (x) - (unsigned int) (26)) >> 8) & 0xFF) & (x + 'A')) |
           ((((((unsigned int) (x) - (unsigned int) (26)) >> 8) & 0xFF) ^ 0xFF) & ((((unsigned int) (x) - (unsigned int) (52)) >> 8) & 0xFF) & (x + ('a' - 26))) |
           ((((((unsigned int) (x) - (unsigned int) (52)) >> 8) & 0xFF) ^ 0xFF) & ((((unsigned int) (x) - (unsigned int) (62)) >> 8) & 0xFF) & (x + ('0' - 52))) | (((((0U - ((unsigned int) (x) ^ (unsigned int) (62))) >> 8) & 0xFF) ^ 0xFF) & '+') |
           (((((0U - ((unsigned int) (x) ^ (unsigned int) (63))) >> 8) & 0xFF) ^ 0xFF) & '/');
}
static int b64_byte_to_char(unsigned int x)
// Uses a switch-like approach with explicit range checks via subtraction and sign extension
// For x<26: returns x+'A'; for 26<=x<52: returns x-26+'a'; for 52<=x<62: returns x-52+'0'
// For x==62: returns '+'; for x==63: returns '/'
// The >>8 on unsigned subtraction creates 0xFF (all ones) when result is negative (borrow occurred)
// This effectively tests if x < constant by checking if x - constant underflows
{
    unsigned int m1 = ((x - 26) >> 8) & 0xFF;
    unsigned int m2 = ((x - 52) >> 8) & 0xFF;
    unsigned int m3 = ((x - 62) >> 8) & 0xFF;
    unsigned int eq62 = ((0U - (x ^ 62)) >> 8) & 0xFF;
    unsigned int eq63 = ((0U - (x ^ 63)) >> 8) & 0xFF;
    return (m1 & (x + 'A')) | ((~m1 & m2) & (x + 'a' - 26)) | ((~m2 & m3) & (x + '0' - 52)) | ((~eq62 & 0xFF) & '+') | ((~eq63 & 0xFF) & '/');
}
static int b64_byte_to_char(unsigned int x)
// Simplified variable names for the same arithmetic masking approach
// mask_lt_26 is 0xFF when x<26, else 0
// mask_lt_52 is 0xFF when x<52, else 0
// mask_lt_62 is 0xFF when x<62, else 0
// eq_62 is 0xFF when x==62, else 0
// eq_63 is 0xFF when x==63, else 0
// Each range selects its corresponding character offset
{
    unsigned int lt26 = ((x - 26) >> 8) & 0xFF;
    unsigned int lt52 = ((x - 52) >> 8) & 0xFF;
    unsigned int lt62 = ((x - 62) >> 8) & 0xFF;
    unsigned int is62 = ((0U - (x ^ 62)) >> 8) & 0xFF;
    unsigned int is63 = ((0U - (x ^ 63)) >> 8) & 0xFF;
    return (lt26 & (x + 'A')) | ((~lt26 & lt52) & (x + 'a' - 26)) | ((~lt52 & lt62) & (x + '0' - 52)) | ((~is62 & 0xFF) & '+') | ((~is63 & 0xFF) & '/');
}
static int b64_byte_to_char(unsigned int x)
// Uses conditional-like selection via arithmetic: if x<26 use 'A'+x, else if x<52 use 'a'+(x-26), etc.
// The key insight: (x-N)>>8 for unsigned 32-bit gives 0xFFFFFFFF when x<N (due to underflow/borrow)
// ANDing with 0xFF gives 0xFF for true, 0x00 for false
// XOR with 0xFF inverts the mask for "greater than or equal" conditions
// Equality checks use (0 - (x^N))>>8 which is 0xFF only when x==N
{
    unsigned int m_a = ((x - 26) >> 8) & 0xFF;
    unsigned int m_b = ((x - 52) >> 8) & 0xFF;
    unsigned int m_c = ((x - 62) >> 8) & 0xFF;
    unsigned int e62 = ((0U - (x ^ 62)) >> 8) & 0xFF;
    unsigned int e63 = ((0U - (x ^ 63)) >> 8) & 0xFF;
    return (m_a & (x + 'A')) | ((~m_a & m_b) & (x - 26 + 'a')) | ((~m_b & m_c) & (x - 52 + '0')) | ((~e62 & 0xFF) & '+') | ((~e63 & 0xFF) & '/');
}
static int b64_byte_to_char(unsigned int x)
// Equivalent to reference but with reordered terms for clarity
// First term handles 0-25 mapping to uppercase letters
// Second term handles 26-51 mapping to lowercase letters
// Third term handles 52-61 mapping to digits
// Fourth term handles exactly 62 mapping to '+'
// Fifth term handles exactly 63 mapping to '/'
// All terms use bitwise AND to zero out non-applicable ranges
{
    unsigned int mask1 = ((x - 26) >> 8) & 0xFF;
    unsigned int mask2 = ((x - 52) >> 8) & 0xFF;
    unsigned int mask3 = ((x - 62) >> 8) & 0xFF;
    unsigned int eq62 = ((0U - (x ^ 62)) >> 8) & 0xFF;
    unsigned int eq63 = ((0U - (x ^ 63)) >> 8) & 0xFF;
    return (mask1 & (x + 'A')) | ((~mask1 & mask2) & (x + 'a' - 26)) | ((~mask2 & mask3) & (x + '0' - 52)) | ((~eq62 & 0xFF) & '+') | ((~eq63 & 0xFF) & '/');
}
static int b64_byte_to_char(unsigned int x)
// Uses the same arithmetic branchless technique with explicit intermediate masks
// lt26: 0xFF if x < 26, else 0x00
// lt52: 0xFF if x < 52, else 0x00
// lt62: 0xFF if x < 62, else 0x00
// is62: 0xFF if x == 62, else 0x00
// is63: 0xFF if x == 63, else 0x00
// Each range is isolated by combining these masks with AND/OR/NOT
{
    unsigned int lt26 = ((x - 26) >> 8) & 0xFF;
    unsigned int lt52 = ((x - 52) >> 8) & 0xFF;
    unsigned int lt62 = ((x - 62) >> 8) & 0xFF;
    unsigned int is62 = ((0U - (x ^ 62)) >> 8) & 0xFF;
    unsigned int is63 = ((0U - (x ^ 63)) >> 8) & 0xFF;
    return (lt26 & (x + 'A')) | ((~lt26 & lt52) & (x + 'a' - 26)) | ((~lt52 & lt62) & (x + '0' - 52)) | ((~is62 & 0xFF) & '+') | ((~is63 & 0xFF) & '/');
}
static int b64_byte_to_char(unsigned int x)
// Direct translation of reference with minimal refactoring for readability
// The expression ((x-N)>>8)&0xFF acts as a predicate: 0xFF when x<N, 0x00 when x>=N
// This works because unsigned subtraction underflows to a large value when x<N
// Shifting right by 8 propagates the sign bit (which is 1 for underflow) to all bits
// Masking with 0xFF keeps only the low byte which is 0xFF or 0x00
// Equality check uses XOR: x^N is 0 when equal, so 0-0=0, and 0>>8=0, but we want 0xFF for equality
// Actually (0U - (x^N))>>8: when x==N, x^N=0, 0-0=0, 0>>8=0, then ~0&0xFF=0xFF. When x!=N, x^N!=0, 0-(nonzero) underflows to large value, >>8 gives 0xFF, ~0xFF=0x00
{
    unsigned int m1 = ((x - 26) >> 8) & 0xFF;
    unsigned int m2 = ((x - 52) >> 8) & 0xFF;
    unsigned int m3 = ((x - 62) >> 8) & 0xFF;
    unsigned int e62 = ((0U - (x ^ 62)) >> 8) & 0xFF;
    unsigned int e63 = ((0U - (x ^ 63)) >> 8) & 0xFF;
    return (m1 & (x + 'A')) | ((~m1 & m2) & (x + 'a' - 26)) | ((~m2 & m3) & (x + '0' - 52)) | ((~e62 & 0xFF) & '+') | ((~e63 & 0xFF) & '/');
}
static int b64_byte_to_char(unsigned int x)
// Same logic as reference, factored into named masks for each range boundary
// Range 0-25: mask is lt26, output is x+'A'
// Range 26-51: mask is (~lt26 & lt52), output is x+'a'-26
// Range 52-61: mask is (~lt52 & lt62), output is x+'0'-52
// Value 62: mask is (~is62 & 0xFF) where is62 detects equality, output is '+'
// Value 63: mask is (~is63 & 0xFF), output is '/'
// Note: for equality, when x==N, (0U-(x^N))>>8 = 0, so ~0&0xFF = 0xFF, meaning the term is active
{
    unsigned int lt26 = ((x - 26) >> 8) & 0xFF;
    unsigned int lt52 = ((x - 52) >> 8) & 0xFF;
    unsigned int lt62 = ((x - 62) >> 8) & 0xFF;
    unsigned int eq62 = ((0U - (x ^ 62)) >> 8) & 0xFF;
    unsigned int eq63 = ((0U - (x ^ 63)) >> 8) & 0xFF;
    return (lt26 & (x + 'A')) | ((~lt26 & lt52) & (x + 'a' - 26)) | ((~lt52 & lt62) & (x + '0' - 52)) | ((~eq62 & 0xFF) & '+') | ((~eq63 & 0xFF) & '/');
}
static int b64_byte_to_char(unsigned int x)
// Uses arithmetic predicates to implement a piecewise linear function
// For x in [0,25]: result = x + 'A'
// For x in [26,51]: result = x - 26 + 'a'
// For x in [52,61]: result = x - 52 + '0'
// For x = 62: result = '+'
// For x = 63: result = '/'
// Predicates are computed using unsigned arithmetic underflow detection
// (x-N)>>8 yields 0xFFFFFFFF when x<N (underflow), 0x00000000 when x>=N
// Masking with 0xFF gives 0xFF or 0x00 as a boolean mask
{
    unsigned int p1 = ((x - 26) >> 8) & 0xFF;
    unsigned int p2 = ((x - 52) >> 8) & 0xFF;
    unsigned int p3 = ((x - 62) >> 8) & 0xFF;
    unsigned int q62 = ((0U - (x ^ 62)) >> 8) & 0xFF;
    unsigned int q63 = ((0U - (x ^ 63)) >> 8) & 0xFF;
    return (p1 & (x + 'A')) | ((~p1 & p2) & (x + 'a' - 26)) | ((~p2 & p3) & (x + '0' - 52)) | ((~q62 & 0xFF) & '+') | ((~q63 & 0xFF) & '/');
}
static int b64_byte_to_char(unsigned int x)
// Final variant with same arithmetic masking strategy
// Computes five mutually exclusive masks for the five output categories
// Mask A: x < 26, selects uppercase letter
// Mask B: 26 <= x < 52, selects lowercase letter
// Mask C: 52 <= x < 62, selects digit
// Mask D: x == 62, selects '+'
// Mask E: x == 63, selects '/'
// Each mask is 0xFF when active, 0x00 when inactive
// Results are combined with OR since masks are mutually exclusive
{
    unsigned int mA = ((x - 26) >> 8) & 0xFF;
    unsigned int mB = ((x - 52) >> 8) & 0xFF;
    unsigned int mC = ((x - 62) >> 8) & 0xFF;
    unsigned int mD = ((0U - (x ^ 62)) >> 8) & 0xFF;
    unsigned int mE = ((0U - (x ^ 63)) >> 8) & 0xFF;
    return (mA & (x + 'A')) | ((~mA & mB) & (x + 'a' - 26)) | ((~mB & mC) & (x + '0' - 52)) | ((~mD & 0xFF) & '+') | ((~mE & 0xFF) & '/');
}
