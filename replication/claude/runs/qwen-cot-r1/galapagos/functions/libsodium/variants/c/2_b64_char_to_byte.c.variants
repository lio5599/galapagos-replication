static unsigned int b64_char_to_byte(int c)
{
    // Uses switch statement for clarity.
    // Each case returns the corresponding base64 value.
    // Default returns 0 for invalid characters.
    // Equivalent by exhaustive case coverage.
    switch (c) {
        case 'A': return 0; case 'B': return 1; case 'C': return 2; case 'D': return 3;
        case 'E': return 4; case 'F': return 5; case 'G': return 6; case 'H': return 7;
        case 'I': return 8; case 'J': return 9; case 'K': return 10; case 'L': return 11;
        case 'M': return 12; case 'N': return 13; case 'O': return 14; case 'P': return 15;
        case 'Q': return 16; case 'R': return 17; case 'S': return 18; case 'T': return 19;
        case 'U': return 20; case 'V': return 21; case 'W': return 22; case 'X': return 23;
        case 'Y': return 24; case 'Z': return 25;
        case 'a': return 26; case 'b': return 27; case 'c': return 28; case 'd': return 29;
        case 'e': return 30; case 'f': return 31; case 'g': return 32; case 'h': return 33;
        case 'i': return 34; case 'j': return 35; case 'k': return 36; case 'l': return 37;
        case 'm': return 38; case 'n': return 39; case 'o': return 40; case 'p': return 41;
        case 'q': return 42; case 'r': return 43; case 's': return 44; case 't': return 45;
        case 'u': return 46; case 'v': return 47; case 'w': return 48; case 'x': return 49;
        case 'y': return 50; case 'z': return 51;
        case '0': return 52; case '1': return 53; case '2': return 54; case '3': return 55;
        case '4': return 56; case '5': return 57; case '6': return 58; case '7': return 59;
        case '8': return 60; case '9': return 61;
        case '+': return 62; case '/': return 63;
        default: return 0;
    }
}
static unsigned int b64_char_to_byte(int c)
{
    // Branchless using comparison masks.
    // Computes range membership via subtraction and sign bit.
    // Masks out invalid results at the end.
    // Equivalent to reference but with clearer mask construction.
    unsigned int uc = (unsigned int)c;
    unsigned int mask_A = (((uc >= 'A') & (uc <= 'Z')) ? 0xFFFFFFFF : 0);
    unsigned int mask_a = (((uc >= 'a') & (uc <= 'z')) ? 0xFFFFFFFF : 0);
    unsigned int mask_0 = (((uc >= '0') & (uc <= '9')) ? 0xFFFFFFFF : 0);
    unsigned int mask_p = (uc == '+');
    unsigned int mask_s = (uc == '/');
    unsigned int val = (mask_A & (uc - 'A')) | (mask_a & (uc - 'a' + 26)) | (mask_0 & (uc - '0' + 52)) | (mask_p & 62) | (mask_s & 63);
    unsigned int valid = mask_A | mask_a | mask_0 | mask_p | mask_s;
    return val & valid;
}
static unsigned int b64_char_to_byte(int c)
{
    // Uses arithmetic range check with ternary-like bitwise ops.
    // For each range, computes value only if char is in range.
    // Final AND with validity mask zeroes invalid inputs.
    // Equivalent by same logical structure as reference.
    unsigned int uc = (unsigned int)c;
    unsigned int r1 = (uc >= 'A' && uc <= 'Z') ? (uc - 'A') : 0;
    unsigned int r2 = (uc >= 'a' && uc <= 'z') ? (uc - 'a' + 26) : 0;
    unsigned int r3 = (uc >= '0' && uc <= '9') ? (uc - '0' + 52) : 0;
    unsigned int r4 = (uc == '+') ? 62 : 0;
    unsigned int r5 = (uc == '/') ? 63 : 0;
    unsigned int val = r1 | r2 | r3 | r4 | r5;
    unsigned int valid = (uc >= 'A' && uc <= 'Z') || (uc >= 'a' && uc <= 'z') || (uc >= '0' && uc <= '9') || uc == '+' || uc == '/';
    return valid ? val : 0;
}
static unsigned int b64_char_to_byte(int c)
{
    // Compact lookup using computed index from character properties.
    // Builds index based on character class and offset.
    // Invalid chars produce index out of valid range, mapped to 0.
    // Equivalent by ensuring only valid chars produce correct values.
    unsigned int uc = (unsigned int)c;
    if (uc >= 'A' && uc <= 'Z') return uc - 'A';
    if (uc >= 'a' && uc <= 'z') return uc - 'a' + 26;
    if (uc >= '0' && uc <= '9') return uc - '0' + 52;
    if (uc == '+') return 62;
    if (uc == '/') return 63;
    return 0;
}
static unsigned int b64_char_to_byte(int c)
{
    // Uses bitwise operations to simulate conditional assignment.
    // Each condition creates a mask that selects the value.
    // OR combines all possible values, AND with validity clears invalid.
    // Equivalent by same mask-based selection as reference.
    unsigned int uc = (unsigned int)c;
    unsigned int m1 = -(unsigned int)(uc >= 'A' && uc <= 'Z');
    unsigned int m2 = -(unsigned int)(uc >= 'a' && uc <= 'z');
    unsigned int m3 = -(unsigned int)(uc >= '0' && uc <= '9');
    unsigned int m4 = -(unsigned int)(uc == '+');
    unsigned int m5 = -(unsigned int)(uc == '/');
    unsigned int v1 = m1 & (uc - 'A');
    unsigned int v2 = m2 & (uc - 'a' + 26);
    unsigned int v3 = m3 & (uc - '0' + 52);
    unsigned int v4 = m4 & 62;
    unsigned int v5 = m5 & 63;
    unsigned int val = v1 | v2 | v3 | v4 | v5;
    unsigned int valid = m1 | m2 | m3 | m4 | m5;
    return val & valid;
}
static unsigned int b64_char_to_byte(int c)
{
    // Precomputed array indexed by character code.
    // Direct mapping from ASCII to base64 value.
