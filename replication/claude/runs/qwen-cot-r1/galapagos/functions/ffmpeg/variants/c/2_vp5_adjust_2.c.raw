static int vp5_adjust(int v, int t)
{
    // Same logic but reordered final sign restoration: add s1 before xor.
    // s1 is 0 or -1; adding then xoring with s1 flips sign if s1 is -1.
    int s2, s1 = v >> 31;
    v ^= s1;
    v -= s1;
    v *= v < 2*t;
    v -= t;
    s2 = v >> 31;
    v ^= s2;
    v -= s2;
    v = t - v;
    v += s1;
    v ^= s1;
    return v;
}
