static int mix(int c0, int c1)
{
    // Calculate weighted average per channel with c0 weight 2.
    // Isolate channels using bit masks and right shifts.
    // Integer division by 3 provides floor of true average.
    // Combine channels using bitwise OR after shifting.
    int r = (2*(c0>>10) + c1>>10) / 3;
    int g = (2*((c0&0x03E0)>>5) + ((c1&0x03E0)>>5)) / 3;
    int b = (2*(c0&0x001F) + (c1&0x001F)) / 3;
    return (r << 10) | (g << 5) | b;
}
