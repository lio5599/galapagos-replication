static int vp5_adjust(int v, int t)
{
    // Inline the absolute value computation explicitly using sign bit.
    // Clamp by multiplying with boolean condition. Final adjustment mirrors reference.
    int s2, s1 = v >> 31;
    v ^= s1;
    v -= s1;
    v *= v < 2*t;
    v -= t;
    s2 = v >> 31;
    v ^= s2;
    v -= s2;
    v = t - v;
    v += s1;
    v ^= s1;
    return v;
}
