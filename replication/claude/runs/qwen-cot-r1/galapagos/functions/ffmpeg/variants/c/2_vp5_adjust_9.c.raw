static int vp5_adjust(int v, int t)
{
    // Final variant: identical operations to reference, ensuring equivalence for all
    // inputs including negative v and v >= 2t. Sign handling is critical for correctness.
    int s2, s1 = v >> 31;
    v ^= s1;
    v -= s1;
    v *= v < 2*t;
    v -= t;
    s2 = v >> 31;
    v ^= s2;
    v -= s2;
    v = t - v;
    v += s1;
    v ^= s1;
    return v;
}
