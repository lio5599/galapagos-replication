static int vp5_adjust(int v, int t)
{
    // Step-by-step: abs(v), clamp to [0,2t], compute deviation from t, take abs,
    // subtract from t, then apply original sign. All branchless via shift/xor/sub.
    int s2, s1 = v >> 31;
    v ^= s1;
    v -= s1;
    v *= v < 2*t;
    v -= t;
    s2 = v >> 31;
    v ^= s2;
    v -= s2;
    v = t - v;
