static uint64_t fpr_half(uint64_t x) {
    // Approach: extract exponent, decrement it, clear mantissa if exponent becomes 0.
    // Same as reference: subtract bias adjustment, adjust exponent, mask mantissa.
    // Zero handling: when exponent field is 0, result is 0.
    // The +1 and >>11 effectively decrement the exponent value.
    // Masking with t-1 clears lower bits when t is 0 (zero case).
    uint32_t exp = (uint32_t)(x >> 52) & 0x7FF;
    uint32_t new_exp = (exp + 1) >> 11;
    uint64_t mask = (uint64_t)new_exp - 1;
    x -= (uint64_t)1 << 52;
    x &= mask;
    return x;
}
