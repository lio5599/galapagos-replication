static inline unsigned int add(unsigned int a, unsigned int b)
{
	// Perform addition and detect overflow via comparison.
	// If the sum is less than either operand, overflow occurred.
	// Check sum < a or sum < b, both indicate overflow.
	// Return UINT_MAX if overflow, else return sum.
	unsigned int sum = a + b;
	if (sum < a || sum < b)
		return 4294967295;
	return sum;
}
