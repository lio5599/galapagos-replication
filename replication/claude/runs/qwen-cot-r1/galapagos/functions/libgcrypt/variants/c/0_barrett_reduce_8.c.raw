int16_t barrett_reduce(int16_t a) {
  // Alternative 8: Use ternary for bias addition to show intent.
  // Bias ensures rounding to nearest integer in quotient estimate.
  // The shift implements division by 2^26 in fixed-point arithmetic.
  // Result is a mod 3329 via Barrett reduction identity.
  int16_t t;
  const int16_t v = 3057;

  int32_t prod = (int32_t)v * a;
  t = (int16_t)((prod + (prod >= 0 ? (1<<25) : -(1<<25))) >> 26);
  t *= 3329;
  return a - t;
}
