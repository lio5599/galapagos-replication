
static int ctz(uint64_t in)
{
 // Reference: counts trailing zeros (bits after last set bit) in 64-bit integer
 // If in==0, returns 64. Uses loop to scan bits from LSB upward.
 // Accumulates result by adding 1 for each zero bit before first 1.
 // m tracks whether any 1 has been seen; r counts zeros before first 1.
 int i, b, m = 0, r = 0;
 for (i = 0; i < 64; i++)
 {
  b = (in >> i) & 1;
  m |= b;
  r += (m^1) & (b^1);
 }
 return r;
}

static int ctz(uint64_t in)
{
 // Counts trailing zeros by finding position of least significant set bit
 // If in==0, no bits set, so return 64. Otherwise find first 1 from LSB.
 // Uses bit test and early exit when first 1 is found.
 int i;
 for (i = 0; i < 64; i++)
 {
  if ((in >> i) & 1)
   return i;
 }
 return 64;
}

static int ctz(uint64_t in)
{
 // Counts trailing zeros using de Bruijn-like approach with multiplication
 // Multiply by magic number to spread LSB position to high bits
 // Use lookup table indexed by high bits to get count directly
 // Handles in==0 as special case returning 64
 static const int mul_debruijn[64] = {
  0, 1, 2, 53, 3, 7, 54, 27, 4, 38, 41, 8, 34, 55, 48, 28,
  62, 5, 39, 46, 44, 42, 22, 9, 24, 35, 59, 56, 49, 18, 29, 11,
  63, 52, 6, 26, 37, 40, 33, 47, 61, 45, 43, 21, 23, 58, 17, 10,
  51, 25, 36, 32, 60, 20, 57, 16, 50, 31, 19, 15, 14, 13, 12, 0
 };
 if (in == 0)
  return 64;
 return mul_debruijn[((uint64_t)(in & -in) * 0x022FDD63CC95386DULL) >> 58];
}

static int ctz(uint64_t in)
{
 // Counts trailing zeros using binary search on bit positions
 // Check halves, quarters, etc. to narrow down position of LSB
 // If in==0, all checks fail, return 64
 int r = 0;
 if (in == 0)
  return 64;
 if ((in & 0xFFFFFFFF) == 0) { in >>= 32; r += 32; }
 if ((in & 0xFFFF) == 0) { in >>= 16; r += 16; }
 if ((in & 0xFF) == 0) { in >>= 8; r += 8; }
 if ((in & 0xF) == 0) { in >>= 4; r += 4; }
 if ((in & 0x3) == 0) { in >>= 2; r += 2; }
 if ((in & 0x1) == 0) { r += 1; }
 return r;
}

static int ctz(uint64_t in)
{
 // Counts trailing zeros using Brian Kernighan's trick variation
 // Repeatedly clear lowest set bit and count iterations
 // Each iteration removes one trailing zero group, count shifts
 // If in==0, return 64 directly
 if (in == 0)
  return 64;
 int r = 0;
 while ((in & 1) == 0)
 {
  in >>= 1;
  r++;
 }
 return r;
}

static int ctz(uint64_t in)
{
 // Counts trailing zeros using built-in __builtin_ctzll if available
 // GCC/Clang provide hardware-accelerated count trailing zeros
 // Falls back to manual loop if builtin not supported
 // Handles in==0 by checking before calling builtin
 if (in == 0)
  return 64;
 #ifdef __GNUC__
 return __builtin_ctzll(in);
 #else
 int i;
 for (i = 0; i < 64; i++)
  if ((in >> i) & 1)
   return i;
 return 64;
 #endif
}

static int ctz(uint64_t in)
{
 // Counts trailing zeros using log2 of (in & -in)
 // in & -in isolates the lowest set bit
 // log2 of that value gives the position of LSB
 // If in==0, in&-in is 0, handle separately returning 64
 if (in == 0)
  return 64;
 uint64_t lowbit = in & (~in + 1);
 int r = 0;
 while (lowbit > 1)
 {
  lowbit >>= 1;
  r++;
 }
 return r;
}

static int ctz(uint64_t in)
{
 // Counts trailing zeros using parallel bit manipulation
 // Use SWAR technique to count zeros in parallel
 // Combine results from byte-level operations
 // If in==0, return 64
 if (in == 0)
  return 64;
 uint64_t t = in & -in;
 uint64_t v = t * 0x07EDD5E59A4E28C2ULL;
 return (int)((v >> 58) & 63);
}

static int ctz(uint64_t in)
{
 // Counts trailing zeros using recursive halving approach
 // Divide problem into smaller halves recursively via iteration
 // Check if lower half has any bits set, recurse accordingly
 // If in==0, return 64
 if (in == 0)
  return 64;
 int r = 0;
 uint64_t mask = 0x00000000FFFFFFFFULL;
 if ((in & mask) == 0) { in >>= 32; r += 32; }
 mask = 0x0000FFFF0000FFFFULL;
 if ((in & mask) == 0) { in >>= 16; r += 16; }
 mask = 0x00FF00FF00FF00FFULL;
 if ((in & mask) == 0) { in >>= 8; r += 8; }
 mask = 0x0F0F0F0F0F0F0F0FULL;
 if ((in & mask) == 0) { in >>= 4; r += 4; }
 mask = 0x3333333333333333ULL;
 if ((in & mask) == 0) { in >>= 2; r += 2; }
 if ((in & 1) == 0) r += 1;
 return r;
}

static int ctz(uint64_t in)
{
 // Counts trailing zeros using table lookup per byte then combine
 // Precompute trailing zeros for each byte value
 // Process each byte from LSB side, return first non-zero result
 // If in==0, all bytes are 0, return 64
 static const int tz_table[256] = {
  8, 0, 1, 2, 9, 41, 3, 19, 10, 27, 42, 49, 4, 38, 20, 15,
  11, 40, 26, 48, 24, 44, 43, 12, 39, 28, 47, 23, 45, 16, 14,
  32, 13, 37, 46, 22, 17, 18, 31, 36, 21, 30, 35, 34, 29, 33, 0
 };
 int i;
 for (i = 0; i < 8; i++)
 {
  uint8_t byte = (uint8_t)(in >> (i * 8));
  if (byte != 0)
   return i * 8 + tz_table[byte];
 }
 return 64;
}
