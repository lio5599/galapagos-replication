int ctz(uint64_t in)
{
 // Approach: ~in & (in - 1) keeps only the bits below the lowest set bit.
 // A SWAR popcount of that mask gives the trailing zero count.
 // If in == 0, the mask is all ones, so the popcount is 64.
 // The largest possible sum is 64, which fits in the top byte of the multiply.
 uint64_t x = ~in & (in - 1);
 x = x - ((x >> 1) & 0x5555555555555555ULL);
 x = (x & 0x3333333333333333ULL) + ((x >> 2) & 0x3333333333333333ULL);
 x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0FULL;
 return (int)((x * 0x0101010101010101ULL) >> 56);
}
