static int int16_t_negative_mask (int16_t x)
{
  // Reference: returns -1 (all bits set) if x is negative, otherwise 0.
  // Approach: compare x with zero directly and select -1 or 0.
  // Converting x to uint16_t and shifting by 15 isolates the sign bit,
  // which is 1 exactly when x < 0. So the reference yields -1 for negative x.
  // Edge cases: INT16_MIN gives -1, while 0 and INT16_MAX give 0.
  return x < 0 ? -1 : 0;
}
static int int16_t_negative_mask (int16_t x)
{
  // Approach: the comparison (x < 0) evaluates to the int 1 or 0.
  // Negating it gives -1 for negative x and 0 otherwise.
  // This matches the reference, where the shifted sign bit is 1 iff x < 0.
  // Edge cases: INT16_MIN gives -(1) = -1, and 0 gives -(0) = 0.
  return -(x < 0);
}
static int int16_t_negative_mask (int16_t x)
{
  // Approach: mask the sign bit 0x8000 of the 16-bit unsigned value.
  // Conversion to uint16_t is modular, so the bit is set iff x < 0.
  // A nonzero mask result maps to -1, and a zero result maps to 0.
  // Edge cases: INT16_MIN maps to 0x8000, giving -1. Also -1 maps to 0xFFFF, giving -1.
  uint16_t u = (uint16_t)x;
  return (u & 0x8000u) ? -1 : 0;
}
static int int16_t_negative_mask (int16_t x)
{
  // Approach: widen x to int32_t, convert to uint32_t (modular), then shift by 31.
  // Sign extension keeps the sign, so bit 31 is 1 iff x < 0.
  // Negating the resulting 0 or 1 gives 0 or -1, as in the reference.
  // Edge cases: INT16_MIN becomes 0xFFFF8000, so bit 31 is 1 and the result is -1.
  uint32_t w = (uint32_t)(int32_t)x;
  return -(int)(w >> 31);
}
static int int16_t_negative_mask (int16_t x)
{
  // Approach: use explicit branching on the sign of x.
  // Negative values return -1 and all other values return 0.
  // This is identical to the reference, whose sign bit is set iff x < 0.
  // Edge cases: INT16_MIN returns -1, and 0 returns 0 because 0 is not negative.
  if (x < 0)
    return -1;
  return 0;
}
static int int16_t_negative_mask (int16_t x)
{
  // Approach: divide the uint16_t value by 0x8000 instead of shifting by 15.
  // Values range from 0 to 0xFFFF, so the quotient is 1 iff the value is >= 0x8000.
  // Modular conversion makes that true exactly when x < 0.
  // Negating the quotient gives -1 or 0. Edge case: 0xFFFF / 0x8000 = 1, giving -1.
  uint16_t u = (uint16_t)x;
  return -(int)(u / 0x8000u);
}
static int int16_t_negative_mask (int16_t x)
{
  // Approach: compare the unsigned 16-bit image of x against 0x8000.
  // Negative x maps to the range 0x8000..0xFFFF, and non-negative x to 0..0x7FFF.
  // The comparison gives 1 or 0, and multiplying by -1 gives -1 or 0.
  // Edge cases: INT16_MIN maps to 0x8000, so the comparison is true and the result is -1.
  uint16_t u = (uint16_t)x;
  return (int)(u >= 0x8000u) * -1;
}
static int int16_t_negative_mask (int16_t x)
{
  // Approach: subtract the unsigned image of x from its signed value.
  // For x < 0, (uint16_t)x equals x + 65536, so the difference is -65536.
  // For x >= 0 the two are equal, so the difference is 0.
  // Dividing by 65536 gives exactly -1 or 0, with no rounding issues.
  int d = (int)x - (int)(uint16_t)x;
  return d / 65536;
}
static int int16_t_negative_mask (int16_t x)
{
  // Approach: take the sign bit s (0 or 1) with the reference shift, then compute ~(s - 1).
  // If s = 1, then s - 1 = 0, and ~0 = -1.
  // If s = 0, then s - 1 = -1, and ~(-1) = 0.
  // This matches -s for both possible values, so it matches the reference.
  int s = (int)((uint16_t)x >> 15);
  return ~(s - 1);
}
static int int16_t_negative_mask (int16_t x)
{
  // Approach: start with a result of 0 and set it to -1 if the unsigned image exceeds 0x7FFF.
  // An unsigned value above 0x7FFF means the sign bit is set, which happens iff x < 0.
  // So the result is -1 for negative x and 0 otherwise, as in the reference.
  // Edge cases: INT16_MAX maps to 0x7FFF, which is not greater, so the result is 0.
  int r = 0;
  if ((uint16_t)x > 0x7FFFu)
    r = -1;
  return r;
}