
static int64_t int_sin(int64_t a)
{
    int64_t a2, res = 0;
    int i;
    if (a < 0) a = 3294199 - a;
    a %= 2 * 3294199;

    if (a >= 3294199 * 3 / 2) a -= 2 * 3294199;
    else if (a >= 3294199 / 2) a = 3294199 - a;

    a2 = (a * a) >> 20;
    i = 2;
    while (i < 11) {
        res += a;
        a = -a * a2 / ((1 << 20) * i * (i + 1));
        i += 2;
    }
    return (res + 8) >> 4;
}



static int64_t int_sin(int64_t a)
{
    int64_t a2, res;
    if (a < 0) a = 3294199 - a;
    a %= 2 * 3294199;

    if (a >= 4941298) a -= 6588398;
    if (a >= 1647099) a = 3294199 - a;

    a2 = (a * a) / 1048576;
    res = a;
    a = -a * a2 / (1048576LL * 6);
    res += a;
    a = -a * a2 / (1048576LL * 20);
    res += a;
    a = -a * a2 / (1048576LL * 42);
    res += a;
    a = -a * a2 / (1048576LL * 72);
    res += a;
    return (res + 8) >> 4;
}



