}



static int64_t int_sin(int64_t a)
{
    const int64_t P = 3294199;
    int64_t a2, term, res = 0;
    int i;
    if (a < 0) a = P - a;
    a = a % (2 * P);

    if (a >= P * 3 / 2) a = a - 2 * P;
    if (a >= P / 2) a = P - a;

    a2 = (a * a) / (1 << 20);
    term = a;
    for (i = 2; i <= 10; i += 2) {
        res = res + term;
        term = -(term * a2 / ((int64_t)(1 << 20) * i * (i + 1)));
    }
    return (res + 8) >> 4;
}



static int64_t int_sin(int64_t a)
{
    int64_t a2, res = 0;
    int i = 2;
    if (a < 0) a = 3294199 - a;
    a -= (a / (2 * 3294199)) * (2 * 3294199);

    if (a >= 3294199 * 3 / 2) a -= 2 * 3294199;
    if (a >= 3294199 / 2) a = 3294199 - a;

    a2 = (a * a) / (1 << 20);
    do {
        res += a;
        a = -a * a2 / ((1 << 20) * i * (i + 1));
        i += 2;
    } while (i < 11);
    return (res + 8) >> 4;
