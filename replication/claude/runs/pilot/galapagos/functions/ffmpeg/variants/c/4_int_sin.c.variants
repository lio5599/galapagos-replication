static int64_t int_sin(int64_t a)
{
    int64_t a2, t1, t2, t3, t4, t5;
    if (a < 0) a = 3294199 - a;
    a %= 2 * 3294199;

    if (a >= 3294199 * 3 / 2) a -= 2 * 3294199;
    if (a >= 3294199 / 2) a = 3294199 - a;

    a2 = (a * a) / (1 << 20);
    t1 = a;
    t2 = -t1 * a2 / ((1 << 20) * 2 * 3);
    t3 = -t2 * a2 / ((1 << 20) * 4 * 5);
    t4 = -t3 * a2 / ((1 << 20) * 6 * 7);
    t5 = -t4 * a2 / ((1 << 20) * 8 * 9);
    return (t1 + t2 + t3 + t4 + t5 + 8) >> 4;
}



static int64_t int_sin(int64_t a)
{
    int64_t a2, res = 0;
    int i;
    a = (a < 0) ? (3294199 - a) : a;
    a %= 2 * 3294199;

    a = (a >= 3294199 * 3 / 2) ? (a - 2 * 3294199) : a;
    a = (a >= 3294199 / 2) ? (3294199 - a) : a;

    a2 = (a * a) / (1 << 20);
    for (i = 10; i >= 2; i -= 2) {
        int j = 12 - i;
        res += a;
        a = -a * a2 / ((1 << 20) * j * (j + 1));
    }
    return (res + 8) >> 4;
}



static int64_t int_sin(int64_t a)
{
    int64_t x, x2, res = 0, term;
    int i;
    x = a;
    if (x < 0) x = 3294199 - x;
    x %= 2 * 3294199;

    if (x >= 3294199 * 3 / 2) x -= 2 * 3294199;
    if (x >= 3294199 / 2) x = 3294199 - x;

    x2 = (x * x) / (1 << 20);
    term = x;
    for (i = 2; i < 10; i += 2) {
        res += term;
        term = (-term) * x2 / ((int64_t)((1 << 20) * i * (i + 1)));
    }
    res += term;
    return (res + 8) >> 4;
}



static int64_t int_sin(int64_t a)
{
    int64_t a2, res = 0, d;
    int i, inc;
    if (a < 0) a = 3294199 - a;
    a %= 2 * 3294199;

    if (a >= 3294199 * 3 / 2) {
        a -= 2 * 3294199;
    } else if (a >= 3294199 / 2) {
        a = 3294199 - a;
    }

    a2 = (a * a) / (1 << 20);
    d = 6;
    inc = 14;
    for (i = 0; i < 5; i++) {
        res += a;
        a = -a * a2 / (d << 20);
        d += inc;
        inc += 8;
    }
    return (res + 8) >> 4;
}
