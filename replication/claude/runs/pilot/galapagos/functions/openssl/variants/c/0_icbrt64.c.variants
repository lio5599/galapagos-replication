
static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    uint64_t b;
    int s = 63;

    while (s >= 0) {
        r <<= 1;
        b = 3 * r * (r + 1) + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            r++;
        }
        s -= 3;
    }
    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    int i;

    for (i = 21; i >= 0; i--) {
        int s = 3 * i;
        uint64_t b;
        r = r * 2;
        b = 3 * r * r + 3 * r + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            r += 1;
        }
    }
    return r * 4096;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t y = 0;
    uint64_t y2 = 0;
    uint64_t b;
    int s;

    for (s = 63; s >= 0; s -= 3) {
        y2 <<= 2;
        y <<= 1;
        b = 3 * (y2 + y) + 1;
        if ((x >> s) >= b) {
            x -= b << s;
            y2 += 2 * y + 1;
            y++;
        }
    }
    return y << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    int s;

    for (s = 63; s >= 0; s -= 3) {
        uint64_t part = x >> s;
        uint64_t c;
        r <<= 1;
        c = r + 1;
        if (c <= part / c / c)
            r = c;
    }
    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t lo = 0;
    uint64_t hi = 2642245;

    while (lo < hi) {
        uint64_t mid = lo + (hi - lo + 1) / 2;
        if (mid * mid * mid <= x)
            lo = mid;
        else
            hi = mid - 1;
    }
    return lo << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    int bit;

    for (bit = 21; bit >= 0; bit--) {
        uint64_t cand = r | ((uint64_t)1 << bit);
        if (cand <= x / cand / cand)
            r = cand;
    }
    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t y, t;

    if (x == 0)
        return 0;
    y = 2642245;
    for (;;) {
        t = (2 * y + x / (y * y)) / 3;
        if (t >= y)
            break;
        y = t;
    }
    return y << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t y, t, v;
    int n = 0;

    if (x == 0)
        return 0;
    v = x;
    while (v) {
        n++;
        v >>= 1;
    }
    y = (uint64_t)1 << ((n + 2) / 3);
    for (;;) {
        t = (2 * y + x / (y * y)) / 3;
        if (t >= y)
            break;
        y = t;
    }
    return y << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    uint64_t mask = (uint64_t)1 << 21;

    while (mask) {
        uint64_t cand = r | mask;
        if (cand <= 2642245 && cand * cand * cand <= x)
            r = cand;
        mask >>= 1;
    }
    return r << 12;
}



static uint64_t icbrt64(uint64_t x)
{
    uint64_t r = 0;
    uint64_t rem = 0;
    uint64_t b;
    int s;

    for (s = 63; s >= 0; s -= 3) {
        rem = (rem << 3) | ((x >> s) & 7);
        r <<= 1;
        b = 3 * r * (r + 1) + 1;
        if (rem >= b) {
            rem -= b;
            r++;
        }
    }
    return r << 12;
}
