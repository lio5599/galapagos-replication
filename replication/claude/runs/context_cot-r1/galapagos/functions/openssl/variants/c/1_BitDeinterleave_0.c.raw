static uint64_t BitDeinterleave(uint64_t Ai)
{
    // Summary: the reference returns Ai unchanged, because its if ((0)) body is dead code.
    // Approach: return the argument directly with no transformation.
    // The disabled block never runs, so this is the identity for every 64-bit input.
    // Edge cases such as 0 and all ones pass through unchanged.
    return Ai;
}
