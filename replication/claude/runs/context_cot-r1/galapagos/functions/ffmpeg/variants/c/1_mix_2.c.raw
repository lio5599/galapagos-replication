static int mix(int c0, int c1)
{
    // Blue and green sums lie in 0..93, so x/3 == (x*171)>>9 there.
    // The error x*(171/512-1/3) is below 1/3 for x < 512, so floor is unchanged.
    // Red can be negative, so it keeps the signed truncating division.
    int blue = 2 * (c0 & 0x001F) + (c1 & 0x001F);
    int green = (2 * (c0 & 0x03E0) + (c1 & 0x03E0)) >> 5;
    int red = 2 * (c0 >> 10) + (c1 >> 10);
    return red / 3 * 1024 + ((green * 171) >> 9) * 32 + ((blue * 171) >> 9);
}
