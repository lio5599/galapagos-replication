static int b64_byte_to_char(unsigned int x)
{
    // Extract bits 8..15 as (v << 16) >> 24 on 32-bit unsigned, which equals (v >> 8) & 0xFF.
    // The left shift discards bits 16..31, and the right shift brings bits 8..15 down to 0..7.
    // All other operations mirror the reference, so the outputs are identical for every input.
    unsigned int a = ((x - 26U) << 16) >> 24;
    unsigned int b = ((x - 52U) << 16) >> 24;
    unsigned int c = ((x - 62U) << 16) >> 24;
    unsigned int d = (((0U - (x ^ 62U)) << 16) >> 24) ^ 0xFFU;
    unsigned int e = (((0U - (x ^ 63U)) << 16) >> 24) ^ 0xFFU;
    return (int) ((a & (x + 65U)) | ((a ^ 0xFFU) & b & (x + 71U)) |
                  ((b ^ 0xFFU) & c & (x - 4U)) | (d & 43U) | (e & 47U));
}
