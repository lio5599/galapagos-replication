static int b64_byte_to_char(unsigned int x)
{
    // Reuse the shifted differences: p = x - 26 gives x + 71 = p + 97, and q = x - 52 gives x - 4 = q + 48.
    // These identities hold modulo 2^32, so the offset values match the reference exactly.
    // The masks come from the same p, q and r = x - 62, and the + and / masks are kept as in the reference.
    unsigned int p = x - 26U;
    unsigned int q = x - 52U;
    unsigned int r = x - 62U;
    unsigned int a = (p >> 8) & 0xFFU;
    unsigned int b = (q >> 8) & 0xFFU;
    unsigned int c = (r >> 8) & 0xFFU;
    unsigned int d = (((0U - (x ^ 62U)) >> 8) & 0xFFU) ^ 0xFFU;
    unsigned int e = (((0U - (x ^ 63U)) >> 8) & 0xFFU) ^ 0xFFU;
    return (int) ((a & (x + 65U)) | ((a ^ 0xFFU) & b & (p + 97U)) |
                  ((b ^ 0xFFU) & c & (q + 48U)) | (d & 43U) | (e & 47U));
}
