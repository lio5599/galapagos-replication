int16_t barrett_reduce(int16_t a) {
  // Reference: Barrett reduction, returns a - 3329*round(a*20159/2^26), a centered rep of a mod 3329.
  // v = (2^26 + 1664)/3329 = 20159. The product 20159*a + 2^25 fits in int32 for all int16 a.
  // >> 26 on int32 is an arithmetic shift, i.e. floor division, as in the reference.
  // |t| <= 10, and the true value a - 3329*t is in int16 range, so computing in int32
  // and truncating to int16 gives the same result as the reference's 16-bit wraparound.
  int32_t t = (20159 * (int32_t)a + 33554432) >> 26;
  return (int16_t)((int32_t)a - t * 3329);
}
int16_t barrett_reduce(int16_t a) {
  // Same quotient estimate, but the shift by 26 is split into shifts by 10 and 16.
  // floor(floor(x/2^10)/2^16) == floor(x/2^26) for arithmetic shifts, including negative x.
  // The final subtraction is done in int32. The exact result fits in int16, so truncation matches.
  int32_t x = (int32_t)a * 20159 + (1 << 25);
  int32_t t = (x >> 10) >> 16;
  return (int16_t)(a - t * 3329);
}
int16_t barrett_reduce(int16_t a) {
  // Bias the numerator by 10*2^26 so it is always nonnegative: min is -660570112+33554432+671088640 > 0.
  // The max is 694104385+671088640 < 2^31. Unsigned division by 2^26 is floor, then subtract 10.
  // This equals the reference's arithmetic shift. The remainder is computed exactly and fits in int16.
  uint32_t x = (uint32_t)(20159 * (int32_t)a + 33554432 + 671088640);
  int32_t t = (int32_t)(x / 67108864u) - 10;
  return (int16_t)(a - t * 3329);
}
int16_t barrett_reduce(int16_t a) {
  // Rounding identity: floor((x + 2^25)/2^26) == floor((floor(x/2^25) + 1)/2).
  // The arithmetic shifts implement floor for negative x too, so t matches the reference quotient.
  // The remainder a - 3329*t is exact in int32 and lies in int16 range.
  int32_t x = 20159 * (int32_t)a;
  int32_t t = ((x >> 25) + 1) >> 1;
  return (int16_t)(a - 3329 * t);
}
int16_t barrett_reduce(int16_t a) {
  // Use 64-bit arithmetic for the product and rounding constant. The values are identical
  // to the int32 ones because no overflow occurs in either case. The arithmetic shift is floor.
  // The final result is truncated to int16. It is exact because |a - 3329*t| is small.
  int64_t x = (int64_t)a * 20159 + 33554432;
  int64_t t = x >> 26;
  return (int16_t)((int64_t)a - t * 3329);
}
int16_t barrett_reduce(int16_t a) {
  // Compute t as in the reference. Then multiply by 3329 as 4096 - 512 - 256 + 1 using
  // multiplications rather than left shifts, which avoids UB on negative t.
  // The sum equals 3329*t exactly. The int32 remainder fits in int16, so truncation matches.
  int32_t t = ((int32_t)a * 20159 + (1 << 25)) >> 26;
  int32_t m = t * 4096 - t * 512 - t * 256 + t;
  return (int16_t)((int32_t)a - m);
}
int16_t barrett_reduce(int16_t a) {
  // The reference effectively computes a - 3329*t modulo 2^16. Here that is done explicitly with
  // uint16_t wraparound, then converted back to int16_t. The conversion uses the same truncation
  // semantics. The quotient t uses the same rounding and arithmetic shift as the reference.
  int32_t t = ((int32_t)a * 20159 + 33554432) >> 26;
  uint16_t r = (uint16_t)((uint16_t)a - (uint16_t)(t * 3329));
  return (int16_t)r;
}
int16_t barrett_reduce(int16_t a) {
  // 20159*a is split as 20000*a + 159*a. Each term and the sum fit in int32, so the value is the same.
  // The rounding constant 2^25 and the arithmetic shift by 26 reproduce the reference quotient.
  // The exact remainder a - 3329*t fits in int16, so truncation gives the same output.
  int32_t ai = a;
  int32_t t = (ai * 20000 + ai * 159 + 33554432) >> 26;
  return (int16_t)(ai - t * 3329);
}
int16_t barrett_reduce(int16_t a) {
  // The constant v is recomputed exactly as in the reference: (2^26 + 1664)/3329 = 20159.
  // The quotient is the arithmetic shift floor((v*a + 2^25)/2^26), held in int16 like the reference.
  // The remainder is computed as a + (-3329)*t in int32. It is exact and fits in int16.
  const int32_t v = ((1 << 26) + 3329 / 2) / 3329;
  int16_t t = (int16_t)((v * (int32_t)a + (1 << 25)) >> 26);
  return (int16_t)((int32_t)a + (int32_t)t * -3329);
}
int16_t barrett_reduce(int16_t a) {
  // Bias by 16*2^26 so the numerator is positive, then use a logical shift on uint32.
  // Min: -660570112 + 33554432 + 1073741824 > 0. Max: 694104385 + 1073741824 < 2^32.
  // floor((x + 16*2^26)/2^26) - 16 == floor(x/2^26), so this matches the reference shift.
  // The remainder is computed in int32. It is exact and lies in int16 range.
  uint32_t x = (uint32_t)((int32_t)a * 20159 + 33554432) + 1073741824u;
  int32_t t = (int32_t)(x >> 26) - 16;
  return (int16_t)((int32_t)a - t * 3329);
}