int16_t barrett_reduce(int16_t a) {
  // Rounding identity: floor((x + 2^25)/2^26) == floor((floor(x/2^25) + 1)/2).
  // The arithmetic shifts implement floor for negative x too, so t matches the reference quotient.
  // The remainder a - 3329*t is exact in int32 and lies in int16 range.
  int32_t x = 20159 * (int32_t)a;
  int32_t t = ((x >> 25) + 1) >> 1;
  return (int16_t)(a - 3329 * t);
}
