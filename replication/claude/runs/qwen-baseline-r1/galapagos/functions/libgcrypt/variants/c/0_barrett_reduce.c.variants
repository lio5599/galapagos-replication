
int16_t barrett_reduce(int16_t a) {
  int16_t t;
  const int16_t v = ((1<<26) + 3329/2)/3329;

  t = ((int32_t)v*a + (1<<25)) >> 26;
  t *= 3329;
  return a - t;
}



int16_t barrett_reduce(int16_t a) {
  int16_t t;
  const int16_t v = ((1<<26) + 3329/2)/3329;

  t = ((int32_t)v*a + (1<<25)) >> 26;
  return a - t * 3329;
}



int16_t barrett_reduce(int16_t a) {
  const int16_t v = ((1<<26) + 3329/2)/3329;
  int16_t t = ((int32_t)v*a + (1<<25)) >> 26;
  return a - t * 3329;
}



int16_t barrett_reduce(int16_t a) {
  const int16_t v = ((1<<26) + 3329/2)/3329;
  int32_t t = ((int32_t)v*a + (1<<25)) >> 26;
  return a - (int16_t)(t * 3329);
}



