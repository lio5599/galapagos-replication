int fpr_lt(uint64_t x, uint64_t y) {
    int64_t sx = *(int64_t *)&x;
    int64_t sy = *(int64_t *)&y;
    int signs_differ = ((sx ^ sy) >> 63) & 1;
    int sign_x = (sx >> 63) & 1;
    
    if (signs_differ) {
        return sign_x;
    }
    
    if (sign_x == 0) {
        return (sx - sy) >> 63 & 1;
    }
    
    return (sy - sx) >> 63 & 1;
}
