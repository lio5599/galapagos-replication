int fpr_lt(uint64_t x, uint64_t y) {
    int64_t sx = *(int64_t *)&x;
    int64_t sy = *(int64_t *)&y;
    
    int sx_sign = (sx >> 63) & 1;
    int sy_sign = (sy >> 63) & 1;
    
    if (sx_sign != sy_sign) {
        return sx_sign;
    }
    
    if (sx_sign == 0) {
        return (sx < sy) ? 1 : 0;
    }
    
    return (sx > sy) ? 1 : 0;
}
