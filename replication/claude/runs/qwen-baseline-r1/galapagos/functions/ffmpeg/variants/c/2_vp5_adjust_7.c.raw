static int vp5_adjust(int v, int t)
{
    int sign = v >> 31;
    int av = (v ^ sign) - sign;
    int max_clamp = 2 * t - 1;
    int clamped = av < max_clamp + 1 ? av : max_clamp;
    int d = t - clamped;
    int dsign = d >> 31;
    int ad = (d ^ dsign) - dsign;
    int out = t - ad;
    out += sign;
    out ^= sign;
    return out;
}
