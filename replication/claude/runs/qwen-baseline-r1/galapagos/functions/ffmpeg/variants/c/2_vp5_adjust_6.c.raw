static int vp5_adjust(int v, int t)
{
    int s1 = v >> 31;
    int abs_v = (v ^ s1) - s1;
    int two_t = 2 * t;
    int clamped = abs_v < two_t ? abs_v : two_t - 1;
    int diff = t - clamped;
    int s2 = diff >> 31;
    int abs_diff = (diff ^ s2) - s2;
    int res = t - abs_diff;
    res += s1;
    res ^= s1;
    return res;
}
