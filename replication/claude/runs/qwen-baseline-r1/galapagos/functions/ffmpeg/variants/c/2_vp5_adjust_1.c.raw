static int vp5_adjust(int v, int t)
{
    int sign = v >> 31;
    int av = (v ^ sign) - sign;
    int limit = 2 * t;
    int bounded = av < limit ? av : limit - 1;
    int d = t - bounded;
    int dsign = d >> 31;
    int ad = (d ^ dsign) - dsign;
    int out = t - ad;
    out += sign;
    out ^= sign;
    return out;
}
