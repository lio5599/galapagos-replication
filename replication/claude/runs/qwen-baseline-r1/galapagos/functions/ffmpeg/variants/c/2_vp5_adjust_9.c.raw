static int vp5_adjust(int v, int t)
{
    int sign = v >> 31;
    int abs_v = (v ^ sign) - sign;
    int two_t = 2 * t;
    int clamped = abs_v < two_t ? abs_v : two_t - 1;
    int d = t - clamped;
    int dsign = d >> 31;
    int abs_d = (d ^ dsign) - dsign;
    int res = t - abs_d;
    res += sign;
    res ^= sign;
    return res;
}
