static int vp5_adjust(int v, int t)
{
    int s1 = v < 0 ? -1 : 0;
    int av = v < 0 ? -v : v;
    int max_val = 2 * t - 1;
    int clamped = av > max_val ? max_val : av;
    int d = t - clamped;
    int s2 = d < 0 ? -1 : 0;
    int ad = d < 0 ? -d : d;
    int res = t - ad;
    res += s1;
    res ^= s1;
    return res;
}
