static int vp5_adjust(int v, int t)
{
    int s1 = v >> 31;
    int abs_v = (v ^ s1) - s1;
    int cond = abs_v < 2 * t;
    int clamped = cond ? abs_v : 2 * t - 1;
    int diff = t - clamped;
    int s2 = diff >> 31;
    int abs_diff = (diff ^ s2) - s2;
    int result = t - abs_diff;
    result += s1;
    result ^= s1;
    return result;
}
