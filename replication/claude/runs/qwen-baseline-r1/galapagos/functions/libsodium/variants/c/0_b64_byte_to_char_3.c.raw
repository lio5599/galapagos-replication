static int b64_byte_to_char(unsigned int x)
{
    int ret = 0;
    switch (x) {
        case 0:  ret = 'A'; break; case 1:  ret = 'B'; break; case 2:  ret = 'C'; break;
        case 3:  ret = 'D'; break; case 4:  ret = 'E'; break; case 5:  ret = 'F'; break;
        case 6:  ret = 'G'; break; case 7:  ret = 'H'; break; case 8:  ret = 'I'; break;
        case 9:  ret = 'J'; break; case 10: ret = 'K'; break; case 11: ret = 'L'; break;
        case 12: ret = 'M'; break; case 13: ret = 'N'; break; case 14: ret = 'O'; break;
        case 15: ret = 'P'; break; case 16: ret = 'Q'; break; case 17: ret = 'R'; break;
        case 18: ret = 'S'; break; case 19: ret = 'T'; break; case 20: ret = 'U'; break;
        case 21: ret = 'V'; break; case 22: ret = 'W'; break; case 23: ret = 'X'; break;
        case 24: ret = 'Y'; break; case 25: ret = 'Z'; break;
        case 26: ret = 'a'; break; case 27: ret = 'b'; break; case 28: ret = 'c'; break;
        case 29: ret = 'd'; break; case 30: ret = 'e'; break; case 31: ret = 'f'; break;
        case 32: ret = 'g'; break; case 33: ret = 'h'; break; case 34: ret = 'i'; break;
        case 35: ret = 'j'; break; case 36: ret = 'k'; break; case 37: ret = 'l'; break;
        case 38: ret = 'm'; break; case 39: ret = 'n'; break; case 40: ret = 'o'; break;
        case 41: ret = 'p'; break; case 42: ret = 'q'; break; case 43: ret = 'r'; break;
        case 44: ret = 's'; break; case 45: ret = 't'; break; case 46: ret = 'u'; break;
        case 47: ret = 'v'; break; case 48: ret = 'w'; break; case 49: ret = 'x'; break;
        case 50: ret = 'y'; break; case 51: ret = 'z'; break;
        case 52: ret = '0'; break; case 53: ret = '1'; break; case 54: ret = '2'; break;
        case 55: ret = '3'; break; case 56: ret = '4'; break; case 57: ret = '5'; break;
        case 58: ret = '6'; break; case 59: ret = '7'; break; case 60: ret = '8'; break;
        case 61: ret = '9'; break;
        case 62: ret = '+'; break;
        case 63: ret = '/'; break;
        default: ret = 0; break;
    }
    return ret;
}
