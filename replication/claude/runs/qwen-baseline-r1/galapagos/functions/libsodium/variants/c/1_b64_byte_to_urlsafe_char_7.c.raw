static int b64_byte_to_urlsafe_char(unsigned int x)
{
    int base;
    if (x < 26)
        base = 'A';
    else if (x < 52) {
        base = 'a';
        x -= 26;
    } else if (x < 62) {
        base = '0';
        x -= 52;
    } else if (x == 62)
        return '-';
    else
        return '_';
    return base + x;
}
