static uint64_t BitInterleave(uint64_t Ai)
{
    uint32_t lo = (uint32_t)Ai;
    uint32_t hi = (uint32_t)(Ai >> 32);

    lo = ((lo >> 0) & 0x1) | (((lo >> 1) & 0x1) << 1) | (((lo >> 2) & 0x1) << 2) | (((lo >> 3) & 0x1) << 3) |
         (((lo >> 4) & 0x1) << 4) | (((lo >> 5) & 0x1) << 5) | (((lo >> 6) & 0x1) << 6) | (((lo >> 7) & 0x1) << 7) |
         (((lo >> 8) & 0x1) << 8) | (((lo >> 9) & 0x1) << 9) | (((lo >> 10) & 0x1) << 10) | (((lo >> 11) & 0x1) << 11) |
         (((lo >> 12) & 0x1) << 12) | (((lo >> 13) & 0x1) << 13) | (((lo >> 14) & 0x1) << 14) | (((lo >> 15) & 0x1) << 15) |
         (((lo >> 16) & 0x1) << 16) | (((lo >> 17) & 0x1) << 17) | (((lo >> 18) & 0x1) << 18) | (((lo >> 19) & 0x1) << 19) |
         (((lo >> 20) & 0x1) << 20) | (((lo >> 21) & 0x1) << 21) | (((lo >> 22) & 0x1) << 22) | (((lo >> 23) & 0x1) << 23) |
         (((lo >> 24) & 0x1) << 24) | (((lo >> 25) & 0x1) << 25) | (((lo >> 26) & 0x1) << 26) | (((lo >> 27) & 0x1) << 27) |
         (((lo >> 28) & 0x1) << 28) | (((lo >> 29) & 0x1) << 29) | (((lo >> 30) & 0x1) << 30) | (((lo >> 31) & 0x1) << 31);

    hi = ((hi >> 0) & 0x1) | (((hi >> 1) & 0x1) << 1) | (((hi >> 2) & 0x1) << 2) | (((hi >> 3) & 0x1) << 3) |
         (((hi >> 4) & 0x1) << 4) | (((hi >> 5) & 0x1) << 5) | (((hi >> 6) & 0x1) << 6) | (((hi >> 7) & 0x1) << 7) |
         (((hi >> 8) & 0x1) << 8) | (((hi >> 9) & 0x1) << 9) | (((hi >> 10) & 0x1) << 10) | (((hi >> 11) & 0x1) << 11) |
         (((hi >> 12) & 0x1) << 12) | (((hi >> 13) & 0x1) << 13) | (((hi >> 14) & 0x1) << 14) | (((hi >> 15) & 0x1) << 15) |
         (((hi >> 16) & 0x1) << 16) | (((hi >> 17) & 0x1) << 17) | (((hi >> 18) & 0x1) << 18) | (((hi >> 19) & 0x1) << 19) |
         (((hi >> 20) & 0x1) << 20) | (((hi >> 21) & 0x1) << 21) | (((hi >> 22) & 0x1) << 22) | (((hi >> 23) & 0x1) << 23) |
         (((hi >> 24) & 0x1) << 24) | (((hi >> 25) & 0x1) << 25) | (((hi >> 26) & 0x1) << 26) | (((hi >> 27) & 0x1) << 27) |
         (((hi >> 28) & 0x1) << 28) | (((hi >> 29) & 0x1) << 29) | (((hi >> 30) & 0x1) << 30) | (((hi >> 31) & 0x1) << 31);

    return ((uint64_t)hi << 33) | ((uint64_t)lo << 1);
}
