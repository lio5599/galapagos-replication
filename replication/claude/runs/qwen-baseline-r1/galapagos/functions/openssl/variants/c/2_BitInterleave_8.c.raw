static uint64_t BitInterleave(uint64_t Ai)
{
    uint32_t lo = (uint32_t)Ai;
    uint32_t hi = (uint32_t)(Ai >> 32);

    lo = (lo & 0x000000FF) | ((lo & 0x0000FF00) << 8);
    lo = (lo & 0x0000FFFF) | ((lo & 0xFFFF0000) << 16);
    lo = (lo & 0x00FF00FF) | ((lo & 0xFF00FF00) << 8);
    lo = (lo & 0x0F0F0F0F) | ((lo & 0xF0F0F0F0) << 4);
    lo = (lo & 0x33333333) | ((lo & 0xCCCCCCCC) << 2);
    lo = (lo & 0x55555555) | ((lo & 0xAAAAAAAA) << 1);

    hi = (hi & 0x000000FF) | ((hi & 0x0000FF00) << 8);
    hi = (hi & 0x0000FFFF) | ((hi & 0xFFFF0000) << 16);
    hi = (hi & 0x00FF00FF) | ((hi & 0xFF00FF00) << 8);
    hi = (hi & 0x0F0F0F0F) | ((hi & 0xF0F0F0F0) << 4);
    hi = (hi & 0x33333333) | ((hi & 0xCCCCCCCC) << 2);
    hi = (hi & 0x55555555) | ((hi & 0xAAAAAAAA) << 1);

    return ((uint64_t)hi << 33) | ((uint64_t)lo << 1);
}
