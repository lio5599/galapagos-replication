static uint64_t BitInterleave(uint64_t Ai)
{
    uint32_t a = (uint32_t)Ai;
    uint32_t b = (uint32_t)(Ai >> 32);

    a = (a & 0x00FF) | ((a & 0xFF00) << 8);
    a = (a & 0x0000FFFF) | ((a & 0xFFFF0000) << 16);
    a = (a & 0x000000FF) | ((a & 0x0000FF00) << 8);
    a = (a & 0x0000000F) | ((a & 0x000000F0) << 4);
    a = (a & 0x00000003) | ((a & 0x0000000C) << 2);
    a = (a & 0x00000001) | ((a & 0x00000002) << 1);

    b = (b & 0x00FF) | ((b & 0xFF00) << 8);
    b = (b & 0x0000FFFF) | ((b & 0xFFFF0000) << 16);
    b = (b & 0x000000FF) | ((b & 0x0000FF00) << 8);
    b = (b & 0x0000000F) | ((b & 0x000000F0) << 4);
    b = (b & 0x00000003) | ((b & 0x0000000C) << 2);
    b = (b & 0x00000001) | ((b & 0x00000002) << 1);

    return ((uint64_t)b << 33) | ((uint64_t)a << 1);
}
